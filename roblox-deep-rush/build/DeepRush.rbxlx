            <string name="Name">Audio</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Audio.luau — every sound in one place.

	Two tiers, and the split matters:

	  BUILTIN  `rbxasset://` sounds that ship inside the Roblox client. They
	           always work, in every place, with no upload and no asset id.
	           The game is fully scored with these, so it is never silent.

	  CUSTOM   your own uploaded asset ids. Empty by default. Anything you
	           fill in here overrides the built-in for that slot.

	Why no ids are pre-filled: a made-up catalogue id either fails to load or
	plays something unrelated, and there is no way to tell which without
	testing it in a live place. Guessing them would have quietly shipped you
	broken audio that looks configured. The built-ins are worse-sounding and
	honest.

	**The files are already made.** `audio/` in this repo contains nine
	purpose-built pieces — four ambience loops, three positional loops and two
	one-shots — every loop seamless by construction (see tools/make-audio.py).
	Upload them once, paste the ids below, done. `audio/README.md` walks
	through it.
]]

local Audio = {}

Audio.Custom = {
	-- Paste the asset id (just the number) after uploading audio/*.ogg.
	ambienceSurface = "", -- audio/ambience-surface.ogg
	ambienceShallow = "", -- audio/ambience-shallow.ogg
	ambienceDeep = "", -- audio/ambience-deep.ogg
	ambienceAbyss = "", -- audio/ambience-abyss.ogg

	-- Positional. These attach to the objects themselves, so you hear a gas
	-- pocket before you can see it and the volume tells you how close it is.
	zoneGas = "", -- audio/zone-gas.ogg — gas, frost, the Hollow
	zoneVent = "", -- audio/zone-vent.ogg — vents, pressure, collapse
	liftMotor = "", -- audio/lift-motor.ogg

	-- One-shots.
	pickHit = "", -- audio/pick-hit.ogg
	rareReveal = "", -- audio/rare-reveal.ogg

	music = "", -- optional loop; left empty on purpose, see below
}

--- The nine files in `audio/`, in upload order. This is what the boot notice
--- checks: fill every slot here and the game runs entirely on your own audio.
--- `music` is not in the list because it is meant to stay empty (see below).
Audio.Uploads = {
	{ slot = "ambienceSurface", file = "audio/ambience-surface.ogg" },
	{ slot = "ambienceShallow", file = "audio/ambience-shallow.ogg" },
	{ slot = "ambienceDeep", file = "audio/ambience-deep.ogg" },
	{ slot = "ambienceAbyss", file = "audio/ambience-abyss.ogg" },
	{ slot = "zoneGas", file = "audio/zone-gas.ogg" },
	{ slot = "zoneVent", file = "audio/zone-vent.ogg" },
	{ slot = "liftMotor", file = "audio/lift-motor.ogg" },
	{ slot = "pickHit", file = "audio/pick-hit.ogg" },
	{ slot = "rareReveal", file = "audio/rare-reveal.ogg" },
}

--- Slots still waiting on an asset id, in upload order.
function Audio.missing()
	local out = {}
	for _, entry in ipairs(Audio.Uploads) do
		local id = Audio.Custom[entry.slot]
		if not id or id == "" then
			table.insert(out, entry)
		end
	end
	return out
end

--- Which positional loop each hazard kind uses. Persistent kinds get the
--- hiss, pulsing kinds get the rumble.
Audio.ZoneLoops = {
	gas = "zoneGas",
	freeze = "zoneGas",
	hollow = "zoneGas",
	cavein = "zoneVent",
	heat = "zoneVent",
	pressure = "zoneVent",
	collapse = "zoneVent",
}

--- Built-ins. Pitched and looped rather than used as one-shots, which is how
--- a handful of short clips becomes an ambience bed.
Audio.Builtin = {
	rumble = "rbxasset://sounds/bass.wav",
	wind = "rbxasset://sounds/swoosh.wav",
	hit = "rbxasset://sounds/snap.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/clickfast.wav",
	impact = "rbxasset://sounds/impact_water.mp3",
}

--- The ambience bed, layered by depth. Each layer fades in over its own band,
--- so descending is a continuous change in what you are hearing rather than
--- four abrupt swaps.
Audio.Ambience = {
	{ id = "surface", custom = "ambienceSurface", from = 0, to = 120, volume = 0.30, pitch = 1.0 },
	{ id = "shallow", custom = "ambienceShallow", from = 60, to = 700, volume = 0.38, pitch = 0.62 },
	{ id = "deep", custom = "ambienceDeep", from = 500, to = 1600, volume = 0.46, pitch = 0.34 },
	{ id = "abyss", custom = "ambienceAbyss", from = 1300, to = 3000, volume = 0.55, pitch = 0.2 },
}

--- Music is deliberately off by default. A loop a player hears for the
--- fortieth time is worse than no loop, and this game already has a rhythm
--- (swing, reveal, rift siren). Add one only if you have a track that earns
--- its place.
Audio.MusicVolume = 0.18

Audio.MaxDepthForRumble = 3000

function Audio.source(slot: string): string
	local custom = Audio.Custom[slot]
	if custom and custom ~= "" then
		if tonumber(custom) then
			return "rbxassetid://" .. custom
		end
		return custom
	end
	return ""
end

return Audio

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX22">
          <Properties>
            <string name="Name">Contracts</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Contracts.luau — the weekly ladder, and the 28-day log.

	These two exist because of one specific platform change: Roblox's
	discovery model now measures retention across day 1, days 2-7 AND days
	8-28, and counts "play days per user" rather than raw hours. A game can
	no longer win by holding one player for six hours; it wins by being worth
	opening on twenty-eight separate days.

	Nothing else in DEEP RUSH had an arc longer than a day.

	WEEKLY CONTRACT  one currency (Contract Points), seven tiers, resets
	                 Monday. A daily point cap means the best play is to come
	                 back tomorrow rather than to grind tonight — which is
	                 also exactly what the 60-minute daily playtime cap in the
	                 algorithm rewards.

	DESCENT LOG      one-time milestones for the number of DISTINCT days you
	                 have played. Deliberately spans 28 days, matching the
	                 window the platform grades a new experience on.
]]

local Contracts = {}

--- How Contract Points are earned.
---
--- Every source is an ACTION, never a cash amount. That is deliberate and it
--- was a real bug first: paying points per 1,000 banked looks fair until you
--- notice that payouts grow exponentially with depth and rebirths, so a
--- late-game player emptied the entire daily budget with one deposit while a
--- new player ground for an hour. Actions are scale-invariant — a deep trip
--- is worth the same on day 1 and after ten rebirths.
Contracts.Points = {
	perDeepBank = 14, -- one completed trip from below the deep-bank depth
	perRareOre = 4, -- Rare tier or better
	perEpicOre = 12,
	newCodexEntry = 60,
	perDepthRecord = 2, -- per metre of new personal record
	perCrewMinute = 12, -- mining within bond range of a crewmate
	perRiftOre = 3,
	perQuestClaimed = 25,
}

--- The cap is the point. Hitting it should read as "today is banked, see you
--- tomorrow" rather than as a punishment, so it sits above what a casual
--- session produces and below what a marathon does.
Contracts.DailyPointCap = 1500

-- Roughly one tier per day of play, with the last two needing a good week.
Contracts.Tiers = {
	{ points = 550, reward = { cash = 25000 } },
	{ points = 1400, reward = { cash = 70000, luckMinutes = 15 } },
	{ points = 2700, reward = { cash = 180000 } },
	{ points = 4100, reward = { cash = 400000, cosmetic = "lamp_amber" } },
	{ points = 5700, reward = { cash = 900000, luckMinutes = 30 } },
	{ points = 7500, reward = { cash = 2200000, cosmetic = "trail_ember" } },
	{ points = 9600, reward = { cash = 6000000, cosmetic = "title_contractor", drone = "coolant" } },
}

--- Rotating flavour so the same ladder does not feel identical every Monday.
Contracts.Names = {
	"Deepcore Contract",
	"Blacklight Contract",
	"Cold Seam Contract",
	"Pressure Contract",
	"Hollow Contract",
	"Ashfall Contract",
}

--- Distinct-day milestones. These are one-time and intentionally back-loaded:
--- the day-21 and day-28 prizes exist to be visible on day 2.
Contracts.DescentLog = {
	{ days = 2, reward = { cash = 15000 }, label = "Second Descent" },
	{ days = 3, reward = { cash = 40000, luckMinutes = 20 }, label = "Three Days Down" },
	{ days = 5, reward = { cash = 120000 }, label = "Regular" },
	{ days = 7, reward = { cash = 350000, cosmetic = "lamp_cyan" }, label = "One Week Below" },
	{ days = 10, reward = { cash = 900000 }, label = "Veteran Digger" },
	{ days = 14, reward = { cash = 2500000, drone = "lung" }, label = "Fortnight" },
	{ days = 21, reward = { cash = 9000000, cosmetic = "trail_void" }, label = "Deep Loyalty" },
	{ days = 28, reward = { cash = 30000000, cosmetic = "title_bedrock", drone = "hollowpup" }, label = "Bedrock Club" },
}

--- Monday-anchored ISO-ish week key. UTC so every player rotates at once.
function Contracts.weekKey(): string
	local now = os.time()
	local parts = os.date("!*t", now)
	-- os.date wday: 1 = Sunday. Convert to days since Monday.
	local sinceMonday = (parts.wday + 5) % 7
	local monday = now - sinceMonday * 86400
	local mondayParts = os.date("!*t", monday)
	return string.format("%d-%03d", mondayParts.year, mondayParts.yday)
end

function Contracts.nameForWeek(): string
	local key = Contracts.weekKey()
	local digits = 0
	for character in key:gmatch("%d") do
		digits += tonumber(character)
	end
	return Contracts.Names[(digits % #Contracts.Names) + 1]
end

function Contracts.totalPoints(): number
	return Contracts.Tiers[#Contracts.Tiers].points
end

--- Highest tier index fully earned at `points`.
function Contracts.tierAt(points: number): number
	local reached = 0
	for index, tier in ipairs(Contracts.Tiers) do
		if points >= tier.points then
			reached = index
		end
	end
	return reached
end

return Contracts

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX23">
          <Properties>
            <string name="Name">Cosmetics</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Cosmetics.luau — the status layer.

	Added deliberately after the 2026 spending picture became clear: players
	now put more into cosmetics, status items and rarity-flex than into
	time-skips. DEEP RUSH sold only speed and convenience, which is the
	category that has been losing share.

	The rule that makes this work: a cosmetic must be visible TO OTHER
	PLAYERS. A skin only you can see is a screenshot; a skin the shaft can see
	is status. So all three kinds render on the character or above it.

	Most are earned. The purchasable ones are never the best-looking ones.
]]

local Cosmetics = {}

Cosmetics.List = {
	-- Helmet lamps: the light cone you drag through the dark.
	{ id = "lamp_white", kind = "lamp", name = "Standard Lamp", color = { 255, 244, 214 }, source = "default" },
	{ id = "lamp_amber", kind = "lamp", name = "Amber Lamp", color = { 255, 176, 60 }, source = "contract" },
	{ id = "lamp_cyan", kind = "lamp", name = "Ice Lamp", color = { 120, 230, 255 }, source = "descent" },
	{ id = "lamp_violet", kind = "lamp", name = "Ultraviolet Lamp", color = { 190, 110, 255 }, source = "shop", cost = 750000 },
	{ id = "lamp_blood", kind = "lamp", name = "Blood Lamp", color = { 255, 70, 70 }, source = "shop", cost = 3000000 },

	-- Trails: what people see when you fall past them.
	{ id = "trail_none", kind = "trail", name = "No Trail", color = { 255, 255, 255 }, source = "default" },
	{ id = "trail_ember", kind = "trail", name = "Ember Trail", color = { 255, 130, 50 }, source = "contract" },
	{ id = "trail_frost", kind = "trail", name = "Frost Trail", color = { 160, 225, 255 }, source = "shop", cost = 1500000 },
	{ id = "trail_void", kind = "trail", name = "Void Trail", color = { 150, 60, 255 }, source = "descent" },
	{ id = "trail_gold", kind = "trail", name = "Gold Trail", color = { 255, 205, 90 }, source = "milestone" },

	-- Titles: shown on the nameplate above your head, next to your rebirth.
	{ id = "title_none", kind = "title", name = "—", text = "", source = "default" },
	{ id = "title_contractor", kind = "title", name = "CONTRACTOR", text = "CONTRACTOR", color = { 255, 205, 90 }, source = "contract" },
	{ id = "title_bedrock", kind = "title", name = "BEDROCK CLUB", text = "BEDROCK CLUB", color = { 110, 230, 255 }, source = "descent" },
	{ id = "title_pirate", kind = "title", name = "SHAFT PIRATE", text = "SHAFT PIRATE", color = { 255, 88, 120 }, source = "milestone" },
	{ id = "title_codex", kind = "title", name = "CODEX COMPLETE", text = "CODEX COMPLETE", color = { 255, 255, 255 }, source = "milestone" },

	-- Season badges. Earned only inside a live window, never sold, never
	-- repeated. A player wearing one was demonstrably there that weekend, and
	-- that is the entire value.
	{ id = "season_1", kind = "title", name = "S1 · FIRST DESCENT", text = "S1 · FIRST DESCENT", color = { 255, 205, 90 }, source = "season" },
	{ id = "season_2", kind = "title", name = "S2 · COLD SEAM", text = "S2 · COLD SEAM", color = { 150, 220, 255 }, source = "season" },
	{ id = "season_3", kind = "title", name = "S3 · HOLLOW SEASON", text = "S3 · HOLLOW SEASON", color = { 190, 110, 255 }, source = "season" },
	{ id = "season_4", kind = "title", name = "S4 · PRESSURE SEASON", text = "S4 · PRESSURE SEASON", color = { 255, 88, 120 }, source = "season" },

	{ id = "trail_season_1", kind = "trail", name = "S1 Trail", color = { 255, 205, 90 }, source = "season" },
	{ id = "trail_season_2", kind = "trail", name = "S2 Trail", color = { 150, 220, 255 }, source = "season" },
	{ id = "trail_season_3", kind = "trail", name = "S3 Trail", color = { 190, 110, 255 }, source = "season" },
	{ id = "trail_season_4", kind = "trail", name = "S4 Trail", color = { 255, 88, 120 }, source = "season" },
}

Cosmetics.ById = {}
for _, cosmetic in ipairs(Cosmetics.List) do
	Cosmetics.ById[cosmetic.id] = cosmetic
end

Cosmetics.Defaults = { lamp = "lamp_white", trail = "trail_none", title = "title_none" }

function Cosmetics.ofKind(kind: string)
	local out = {}
	for _, cosmetic in ipairs(Cosmetics.List) do
		if cosmetic.kind == kind then
			table.insert(out, cosmetic)
		end
	end
	return out
end

function Cosmetics.color(id: string?): Color3
	local cosmetic = id and Cosmetics.ById[id]
	if not cosmetic or not cosmetic.color then
		return Color3.fromRGB(255, 255, 255)
	end
	return Color3.fromRGB(cosmetic.color[1], cosmetic.color[2], cosmetic.color[3])
end

return Cosmetics

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX24">
          <Properties>
            <string name="Name">Crew</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Crew.luau — tuning for the co-play layer.

	Roblox's Recommended For You algorithm names "7 day intentional co-play
	days per user" as one of its six ranking signals, alongside play days and
	spend days. A game where playing together is merely possible scores zero
	on it; the bonus has to be big enough that a player actively wants a
	second person in the shaft.

	Everything here is designed to work WITHOUT text chat, because since the
	January 2026 age-check rollout a large share of players cannot freely
	chat with each other. Coordination happens through pings and proximity,
	never through typing.
]]

return {
	MaxSize = 4,
	JoinRadius = 40, -- studs; how close you must be to join a beacon
	BondRadius = 120, -- studs; how close members must stay to earn the bonus
	BeaconLifetime = 45, -- seconds a beacon stays open for joiners

	-- Per ADDITIONAL member beyond yourself. A full crew of 4 is +36% cash
	-- and +0.75 luck — large enough to change behaviour, small enough that a
	-- solo player is never locked out of content.
	CashPerMember = 0.12,
	LuckPerMember = 0.25,

	-- Pings are the entire coordination vocabulary. Fixed set, no free text,
	-- which is what keeps this compliant with the preset-communication rules.
	PingTypes = {
		{ id = "ore", label = "RICH VEIN", icon = "💎", color = { 255, 205, 90 } },
		{ id = "danger", label = "DANGER", icon = "⚠️", color = { 255, 80, 80 } },
		{ id = "lift", label = "LIFT HERE", icon = "▲", color = { 110, 235, 160 } },
		{ id = "here", label = "ON ME", icon = "📍", color = { 110, 230, 255 } },
	},
	PingLifetime = 8,
	PingCooldown = 1.5,

	-- A downed crewmate's crate can be handed back instead of looted. Costs
	-- the rescuer nothing and is the clearest possible "we are on the same
	-- side" signal in a game otherwise built on theft.
	RescueRadius = 16,
	RescueReward = 0.10, -- rescuer gets 10% of the value as a finder's fee
}

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX25">
          <Properties>
            <string name="Name">Drones</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Drones.luau — the collection hook.

	Roblox players collect. Drones are the cheapest possible version of that:
	one equipped at a time, each with a readable bonus, most of them found
	rather than bought. Ownership is permanent through rebirth, which makes
	them the thing a returning player still recognises as theirs.
]]

local Drones = {}

Drones.List = {
	{
		id = "scrap",
		name = "Scrap Drone",
		rarity = "Common",
		desc = "Welded from shaft junk. Sells your haul for a little more.",
		bonus = { cash = 0.05 },
		cost = 5000,
		findDepth = nil,
	},
	{
		id = "scout",
		name = "Scout Drone",
		rarity = "Uncommon",
		desc = "Sniffs out the good seams.",
		bonus = { luck = 0.25 },
		cost = 22000,
		findDepth = nil,
	},
	{
		id = "magnet",
		name = "Magnet Drone",
		rarity = "Rare",
		desc = "Hoovers up dropped crates near you. Yours or not.",
		bonus = { magnet = 22 },
		cost = 90000,
		findDepth = nil,
	},
	{
		id = "coolant",
		name = "Coolant Drone",
		rarity = "Rare",
		desc = "Bleeds off heat, pressure and cold. Hazards hurt less.",
		bonus = { hazardResist = 0.30 },
		cost = 140000,
		findDepth = 450,
	},
	{
		id = "lung",
		name = "Lung Drone",
		rarity = "Epic",
		desc = "A spare set of lungs on a rotor.",
		bonus = { oxygen = 45 },
		cost = 400000,
		findDepth = 700,
	},
	{
		id = "hollowpup",
		name = "Hollow Pup",
		rarity = "Legendary",
		desc = "It followed you up. Nobody agrees on what it is.",
		bonus = { luck = 0.6, cash = 0.15 },
		cost = nil, -- find only
		findDepth = 1000,
	},
	{
		id = "void",
		name = "Void Drone",
		rarity = "Mythic",
		desc = "Runs on something that should not be a fuel.",
		bonus = { cash = 0.5, luck = 0.5, hazardResist = 0.2 },
		cost = nil,
		findDepth = 1400,
	},
	{
		id = "origin",
		name = "Origin Core",
		rarity = "Singularity",
		desc = "The first drone. It was already down there.",
		bonus = { cash = 1.0, luck = 1.0, oxygen = 60, magnet = 30, hazardResist = 0.4 },
		cost = nil,
		findDepth = 2000,
	},
}

Drones.ById = {}
for _, drone in ipairs(Drones.List) do
	Drones.ById[drone.id] = drone
end

--- Chance per mined node that a drone drops at this depth. Deliberately
--- tiny: a found drone should be a story, not a Tuesday.
function Drones.dropChance(depth: number, luck: number): number
	return math.min(0.00035 * (1 + (luck - 1) * 0.4) * (1 + depth / 1200), 0.004)
end

--- Which find-only drones can drop at `depth`, deepest (rarest) first.
function Drones.droppableAt(depth: number)
	local out = {}
	for _, drone in ipairs(Drones.List) do
		if drone.findDepth and depth >= drone.findDepth then
			table.insert(out, drone)
		end
	end
	table.sort(out, function(a, b)
		return a.findDepth > b.findDepth
	end)
	return out
end

--- Sum the equipped drone's bonuses into a flat table.
function Drones.bonusesOf(droneId: string?)
	local empty = { cash = 0, luck = 0, oxygen = 0, magnet = 0, hazardResist = 0 }
	local drone = droneId and Drones.ById[droneId]
	if not drone then
		return empty
	end
	for key, value in pairs(drone.bonus) do
		empty[key] = value
	end
	return empty
end

return Drones

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX26">
          <Properties>
            <string name="Name">Game</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Game.luau — global tuning knobs.

	Every number here was picked to serve one of three loops:
	  MICRO  (3-8s)   swing -> ore reveal -> number pops
	  CORE   (60-90s) descend -> fill cargo -> decide (bank or push deeper)
	  META   (days)   upgrades -> rebirth -> codex completion

	Change these first when the game feels slow or too generous.
]]

return {
	Name = "DEEP RUSH",

	-- MICRO loop ------------------------------------------------------------
	BaseMineTime = 1.15, -- seconds to break a node at drill level 0
	MinMineTime = 0.18, -- floor, so max drill still feels like work
	MineReach = 22, -- studs; generous because mobile aim is imprecise
	NodeRespawn = 9, -- seconds until a broken node returns

	-- CORE loop -------------------------------------------------------------
	BaseCapacity = 8, -- ore slots before the backpack is full
	StudsPerMeter = 3, -- world scale: 3 studs of descent = 1 "meter" of depth
	SurfaceY = 0, -- y=0 is depth 0
	BankRadius = 26, -- studs around the vault that count as "at the surface"

	-- The guarantee that nobody is ever stuck. Slower than a lift pad and
	-- interruptible, so lift pads keep their value, but available anywhere.
	EmergencyAscentSeconds = 12,
	EmergencyAscentDrift = 22, -- studs you may move before it cancels

	-- The spawn pad's colour, as RGB. Home base needs to be distinct from the
	-- gold vault, the green lifts and the red gate beacons, so change this
	-- together with those if you retheme the surface.
	SpawnColor = { 150, 90, 255 },
	DeathCargoLoss = 0.30, -- 30% burns, 70% drops as a lootable crate
	CrateLifetime = 25, -- seconds a dropped crate stays stealable
	CrateFreeForAllDelay = 6, -- owner-only window before it opens to everyone

	-- Greed: the self-balancing PvP dial -------------------------------------
	-- greed = cargo value / value you could have banked already.
	-- Cross the threshold and you glow, you show up on radar, you are stealable.
	GreedMarkThreshold = 0.60,
	GreedStealShare = 0.15, -- fraction of cargo a successful snatch takes
	SnatchCooldown = 45,
	SnatchRange = 18,
	NewPlayerGraceSeconds = 600, -- 10 minutes of total immunity
	NewPlayerGraceDepth = 100, -- ...or until they have been this deep

	-- Progression -----------------------------------------------------------
	XpPerCashUnit = 0.02,
	LevelCurve = 1.18, -- xp needed = 120 * curve^level
	BaseXpToLevel = 120,
	MaxLuck = 30, -- hard cap so stacked buffs cannot break the tier table
	BankStreakStep = 0.04, -- +4% per consecutive deep bank
	BankStreakMax = 0.40,
	DeepBankDepth = 150, -- a bank only counts for streak if you went this deep

	-- Live ops --------------------------------------------------------------
	RiftInterval = 720, -- a Rift Surge every 12 minutes
	RiftJitter = 120,
	RiftDuration = 90,
	RiftLuckMultiplier = 5,
	FirstRiftDelay = 180, -- first one lands early so new players see it

	-- Hazards ---------------------------------------------------------------
	BaseOxygen = 60,
	OxygenRegenRate = 18, -- per second at the surface
	-- Fast enough that walking out of a gas cloud feels like it stopped the
	-- moment you left. Oxygen is only replicated about once a second, though;
	-- see Server/Hazards.luau.
	HazardTickRate = 0.35,

	-- Services --------------------------------------------------------------
	AutosaveInterval = 120,
	StateSyncRate = 0.25, -- max client state pushes per player per second
	PlaytimeRewardInterval = 600, -- a chest every 10 minutes of play
	LeaderboardRefresh = 90,

	-- Set false while testing in Studio without a published place.
	UseDataStores = true,
	Debug = false,
}

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX27">
          <Properties>
            <string name="Name">Hazards</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Hazards.luau — danger you can see coming.

	The first version rolled a die every second and, on a hit, told the player
	"the ceiling is cracking" one second before hurting them. It was fair on
	paper — there was a telegraph — but it felt arbitrary, because the danger
	had no PLACE. You could not look at the room and know where not to stand.

	Now every hazard is an object in the world. A gas pocket is a green cloud
	on a shelf. A magma vent is a glowing crack that flares before it fires.
	You route around them, or you time them, and if you get hit it is because
	you misread something visible rather than because a number came up.

	Two behaviours cover all of it:

	  PERSISTENT  hurts continuously while you are inside. Gas, ice, the
	              Hollow. The counterplay is not being there.
	  PULSING     cycles telegraph -> burst -> rest, forever, on a visible
	              rhythm. Vents, pressure, collapse. The counterplay is timing,
	              which means a hazard can also be a gate you learn to pass.
]]

local Hazards = {}

Hazards.Kinds = {
	gas = {
		mode = "persistent",
		name = "GAS POCKET",
		icon = "☣",
		dps = 7,
		radius = 15,
		height = 13,
		color = { 120, 225, 95 },
		transparency = 0.72,
		particleRate = 26,
		particleSpeed = 2.5,
		hint = "Green means hold your breath and go around.",
	},

	freeze = {
		mode = "persistent",
		name = "FROST FIELD",
		icon = "❄",
		dps = 9,
		radius = 16,
		height = 10,
		color = { 165, 225, 255 },
		transparency = 0.66,
		particleRate = 20,
		particleSpeed = 1.2,
		slow = 0.45, -- multiplies walkspeed while you stand in it
		hint = "It slows you down before it hurts you.",
	},

	hollow = {
		mode = "persistent",
		name = "THE HOLLOW",
		icon = "◉",
		dps = 13,
		radius = 19,
		height = 22,
		color = { 120, 60, 190 },
		transparency = 0.6,
		particleRate = 34,
		particleSpeed = 3.5,
		hint = "Whatever this is, it does not move. You do.",
	},

	cavein = {
		mode = "pulsing",
		name = "LOOSE CEILING",
		icon = "⚠",
		burst = 26,
		radius = 14,
		height = 16,
		telegraph = 1.5,
		active = 0.8,
		rest = 4.5,
		color = { 190, 150, 110 },
		transparency = 0.85,
		particleRate = 16,
		particleSpeed = 6,
		debris = true, -- drops real rocks during the burst
		hint = "Dust falls first. That is your cue.",
	},

	heat = {
		mode = "pulsing",
		name = "MAGMA VENT",
		icon = "🔥",
		burst = 34,
		radius = 12,
		height = 26,
		telegraph = 1.6,
		active = 1.1,
		rest = 4,
		color = { 255, 120, 40 },
		transparency = 0.8,
		particleRate = 30,
		particleSpeed = 14,
		hint = "It glows before it fires. Count it out and walk through.",
	},

	pressure = {
		mode = "pulsing",
		name = "PRESSURE WELL",
		icon = "◈",
		burst = 42,
		radius = 17,
		height = 20,
		telegraph = 1.3,
		active = 1.0,
		rest = 3.2,
		color = { 90, 120, 255 },
		transparency = 0.78,
		particleRate = 22,
		particleSpeed = 8,
		hint = "The air folds inward, then it snaps.",
	},

	collapse = {
		mode = "pulsing",
		name = "COLLAPSE ZONE",
		icon = "☠",
		burst = 58,
		radius = 20,
		height = 26,
		telegraph = 1.1,
		active = 1.2,
		rest = 2.8,
		color = { 200, 60, 90 },
		transparency = 0.75,
		particleRate = 40,
		particleSpeed = 10,
		debris = true,
		hint = "Down here the rock does not warn you twice.",
	},
}

--- How many zones a chunk of this layer gets. Shallow layers stay clean so a
--- new player learns the core loop before learning to dodge anything.
function Hazards.densityFor(layer): number
	if not layer.hazard then
		return 0
	end
	if layer.minDepth < 100 then
		return 1
	end
	if layer.minDepth < 700 then
		return 2
	end
	return 3
end

function Hazards.kindOf(layer)
	local hazard = layer.hazard
	return hazard and Hazards.Kinds[hazard.kind] or nil
end

function Hazards.color(kindId: string): Color3
	local kind = Hazards.Kinds[kindId]
	if not kind then
		return Color3.fromRGB(255, 255, 255)
	end
	return Color3.fromRGB(kind.color[1], kind.color[2], kind.color[3])
end

return Hazards

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX28">
          <Properties>
            <string name="Name">Layers</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Layers.luau — the strata you dig through.

	A layer is a promise and a threat: better ore, worse conditions. The
	`gate` field is what turns rebirth into a door rather than a number —
	you physically cannot survive the Singularity until you have earned it.

	On `ambient` and `fog`: these were tuned for atmosphere and they were too
	dark to play in. Below about 700m you could not see a shelf until you had
	landed on it, and an unlit mining game is not moody, it is broken. Both
	are roughly doubled now. The descent still darkens — the surface is still
	three times brighter than the Singularity — it just stays legible, and
	the ore's own light is what you steer by.
]]

local Layers = {}

Layers.List = {
	{
		id = "topsoil",
		name = "Topsoil",
		minDepth = 0,
		maxDepth = 40,
		rock = { 106, 84, 62 },
		fog = 320,
		ambient = { 118, 116, 126 },
		oxygenDrain = 0, -- surface air, no timer pressure while learning
		hazard = nil,
		valueMultiplier = 1.0,
		gate = 0,
		blurb = "Loose dirt. Nothing here bites.",
	},
	{
		id = "limestone",
		name = "Limestone Shelf",
		minDepth = 40,
		maxDepth = 120,
		rock = { 150, 146, 132 },
		fog = 290,
		ambient = { 108, 106, 116 },
		oxygenDrain = 0.4,
		hazard = { kind = "cavein", chance = 0.05, damage = 12 },
		valueMultiplier = 1.15,
		gate = 0,
		blurb = "Old seabed. The ceiling is not as solid as it looks.",
	},
	{
		id = "ironvein",
		name = "Iron Vein",
		minDepth = 120,
		maxDepth = 260,
		rock = { 122, 98, 88 },
		fog = 250,
		ambient = { 100, 92, 100 },
		oxygenDrain = 0.8,
		hazard = { kind = "cavein", chance = 0.09, damage = 18 },
		valueMultiplier = 1.4,
		gate = 0,
		blurb = "Where the money starts. Bring a bigger backpack.",
	},
	{
		id = "crystal",
		name = "Crystal Caves",
		minDepth = 260,
		maxDepth = 450,
		rock = { 92, 104, 148 },
		fog = 215,
		ambient = { 92, 98, 132 },
		oxygenDrain = 1.2,
		hazard = { kind = "gas", chance = 0.12, damage = 14 },
		valueMultiplier = 1.9,
		gate = 0,
		blurb = "Beautiful. Also full of pockets that are not air.",
	},
	{
		id = "magma",
		name = "Magma Shelf",
		minDepth = 450,
		maxDepth = 700,
		rock = { 78, 40, 34 },
		fog = 190,
		ambient = { 124, 74, 62 },
		oxygenDrain = 1.8,
		hazard = { kind = "heat", chance = 0.16, damage = 20 },
		valueMultiplier = 2.6,
		gate = 1,
		blurb = "The rock is warm. Then it is not rock.",
	},
	{
		id = "frozen",
		name = "Frozen Deep",
		minDepth = 700,
		maxDepth = 1000,
		rock = { 150, 186, 208 },
		fog = 175,
		ambient = { 92, 116, 138 },
		oxygenDrain = 2.4,
		hazard = { kind = "freeze", chance = 0.18, damage = 22 },
		valueMultiplier = 3.6,
		gate = 2,
		blurb = "Water that stopped moving a very long time ago.",
	},
	{
		id = "hollow",
		name = "The Hollow",
		minDepth = 1000,
		maxDepth = 1400,
		rock = { 44, 40, 48 },
		fog = 150,
		ambient = { 68, 64, 76 },
		oxygenDrain = 3.2,
		hazard = { kind = "hollow", chance = 0.22, damage = 30 },
		valueMultiplier = 5.2,
		gate = 3,
		blurb = "Something down here learned what a pickaxe sounds like.",
	},
	{
		id = "abyss",
		name = "Abyss Core",
		minDepth = 1400,
		maxDepth = 2000,
		rock = { 26, 24, 38 },
		fog = 130,
		ambient = { 58, 54, 76 },
		oxygenDrain = 4.2,
		hazard = { kind = "pressure", chance = 0.26, damage = 38 },
		valueMultiplier = 7.5,
		gate = 5,
		blurb = "Pressure that folds steel. Ore that funds a rebirth in one trip.",
	},
	{
		id = "singularity",
		name = "The Singularity",
		minDepth = 2000,
		maxDepth = 3000,
		rock = { 12, 10, 16 },
		fog = 115,
		ambient = { 50, 46, 68 },
		oxygenDrain = 5.5,
		hazard = { kind = "collapse", chance = 0.32, damage = 55 },
		valueMultiplier = 12.0,
		gate = 8,
		blurb = "Down is no longer a direction here.",
	},
}

Layers.ById = {}
for i, layer in ipairs(Layers.List) do
	layer.index = i
	Layers.ById[layer.id] = layer
end

--- The layer a given depth (in meters) falls into. Clamped at both ends.
function Layers.at(depth: number)
	for _, layer in ipairs(Layers.List) do
		if depth < layer.maxDepth then
			return layer
		end
	end
	return Layers.List[#Layers.List]
end

--- Depth alone does not pay; the layer's multiplier plus a smooth per-meter
--- curve does. Smooth matters: a cliff at a layer edge teaches players to
--- park exactly one meter past it.
function Layers.depthMultiplier(depth: number): number
	local layer = Layers.at(depth)
	return layer.valueMultiplier * (1 + depth / 900)
end

--- Which layers a player with `rebirths` may survive in.
function Layers.unlocked(rebirths: number)
	local out = {}
	for _, layer in ipairs(Layers.List) do
		if rebirths >= layer.gate then
			table.insert(out, layer)
		end
	end
	return out
end

function Layers.maxSafeDepth(rebirths: number): number
	local deepest = Layers.List[1]
	for _, layer in ipairs(Layers.List) do
		if rebirths >= layer.gate then
			deepest = layer
		end
	end
	return deepest.maxDepth
end

return Layers

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX29">
          <Properties>
            <string name="Name">Mutations</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Mutations.luau — the second multiplier on every ore.

	Rarity alone tops out. Mutations stack on top of it, which is what
	produces the absurd shareable number: a Mythic Ember Core is nice, a
	GOLDEN RIFT-TOUCHED Ember Core is a screenshot. Cheap to add, and it
	multiplies the size of the "best pull ever" space by 40x.
]]

local Mutations = {}

-- chance is per-roll at luck 1. luckScale says how much luck helps: 0 means
-- luck cannot buy it (keeps Golden feeling like a gift, not a purchase).
Mutations.List = {
	{ id = "glowing", name = "Glowing", multiplier = 2, chance = 0.080, luckScale = 0.6, color = { 130, 255, 160 } },
	{ id = "frozen", name = "Frozen", multiplier = 3, chance = 0.030, luckScale = 0.6, color = { 150, 220, 255 } },
	{ id = "cursed", name = "Cursed", multiplier = 5, chance = 0.010, luckScale = 0.5, color = { 190, 60, 220 } },
	{ id = "golden", name = "Golden", multiplier = 8, chance = 0.0025, luckScale = 0.0, color = { 255, 205, 70 } },
	{ id = "rift", name = "Rift-Touched", multiplier = 15, chance = 0.050, luckScale = 0.2, riftOnly = true, color = { 255, 90, 200 } },
}

Mutations.ById = {}
for _, mutation in ipairs(Mutations.List) do
	Mutations.ById[mutation.id] = mutation
end

--- Roll a mutation, rarest first so a Golden never gets shadowed by a Glowing.
--- Returns nil for a plain ore (the common case, by design).
function Mutations.roll(luck: number, riftActive: boolean, rng: Random?)
	local random = rng or Random.new()
	for i = #Mutations.List, 1, -1 do
		local mutation = Mutations.List[i]
		if not mutation.riftOnly or riftActive then
			local chance = mutation.chance * (1 + (luck - 1) * mutation.luckScale)
			if random:NextNumber() < math.min(chance, 0.75) then
				return mutation
			end
		end
	end
	return nil
end

function Mutations.color(id: string?): Color3?
	local mutation = id and Mutations.ById[id]
	if not mutation then
		return nil
	end
	return Color3.fromRGB(mutation.color[1], mutation.color[2], mutation.color[3])
end

return Mutations

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX30">
          <Properties>
            <string name="Name">Ores</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Ores.luau — the rarity ladder and the 30 things you can pull out of the ground.

	Two-step roll (see Shared/Rarity.luau):
	  1. pick a TIER from the weights below, filtered to what this depth allows
	  2. pick uniformly among the ores of that tier that are legal at this depth

	Filtering by depth is what makes descending feel like progress: the same
	swing at 1500m simply cannot produce Dirtstone, and Singularity ore does
	not exist above 2000m no matter how much luck you stack.
]]

local Ores = {}

-- Tier weights are relative. Base total is ~1353, so a Singularity roll is
-- roughly 1 in 540,000 in a layer where every tier is legal — and far better
-- inside the deepest strata, where the common tiers are filtered out.
Ores.Tiers = {
	{ id = "Common", weight = 1000, color = { 178, 182, 190 }, glow = 0.0, shake = 0 },
	{ id = "Uncommon", weight = 260, color = { 96, 220, 118 }, glow = 0.15, shake = 0 },
	{ id = "Rare", weight = 70, color = { 74, 148, 255 }, glow = 0.35, shake = 0.2 },
	{ id = "Epic", weight = 18, color = { 176, 92, 255 }, glow = 0.55, shake = 0.4 },
	{ id = "Legendary", weight = 4.5, color = { 255, 190, 62 }, glow = 0.8, shake = 0.7 },
	{ id = "Mythic", weight = 0.9, color = { 255, 68, 122 }, glow = 1.0, shake = 1.0 },
	{ id = "Abyssal", weight = 0.12, color = { 0, 255, 214 }, glow = 1.0, shake = 1.4 },
	{ id = "Singularity", weight = 0.0025, color = { 255, 255, 255 }, glow = 1.0, shake = 2.0 },
}

Ores.TierIndex = {}
for i, tier in ipairs(Ores.Tiers) do
	Ores.TierIndex[tier.id] = i
end

-- value is the base payout at depth 0; the depth multiplier does the rest.
-- minDepth/maxDepth are in meters and gate which strata can produce the ore.
Ores.List = {
	-- Topsoil / Limestone ---------------------------------------------------
	{ id = "dirtstone", name = "Dirtstone", tier = "Common", value = 10, minDepth = 0, maxDepth = 260 },
	{ id = "coal", name = "Coal Lump", tier = "Common", value = 14, minDepth = 0, maxDepth = 450 },
	{ id = "clay", name = "Clay Nodule", tier = "Common", value = 18, minDepth = 0, maxDepth = 260 },
	{ id = "copper", name = "Copper Seam", tier = "Uncommon", value = 42, minDepth = 0, maxDepth = 450 },
	{ id = "fossil", name = "Fossil Shell", tier = "Uncommon", value = 60, minDepth = 40, maxDepth = 700 },
	{ id = "iron", name = "Iron Chunk", tier = "Uncommon", value = 78, minDepth = 40, maxDepth = 700 },
	{ id = "quartz", name = "Quartz Cluster", tier = "Rare", value = 190, minDepth = 40, maxDepth = 700 },
	{ id = "silver", name = "Silver Vein", tier = "Rare", value = 240, minDepth = 40, maxDepth = 1000 },

	-- Iron Vein / Crystal Caves --------------------------------------------
	{ id = "gold", name = "Gold Vein", tier = "Rare", value = 320, minDepth = 120, maxDepth = 1400 },
	{ id = "cobalt", name = "Cobalt Spire", tier = "Epic", value = 760, minDepth = 120, maxDepth = 1400 },
	{ id = "meteorite", name = "Meteorite Shard", tier = "Epic", value = 950, minDepth = 120, maxDepth = 2000 },
	{ id = "relic", name = "Buried Relic", tier = "Legendary", value = 2600, minDepth = 120, maxDepth = 2000 },
	{ id = "amethyst", name = "Amethyst Bloom", tier = "Epic", value = 1100, minDepth = 260, maxDepth = 1400 },
	{ id = "emerald", name = "Emerald Heart", tier = "Legendary", value = 3200, minDepth = 260, maxDepth = 2000 },
	{ id = "diamond", name = "Raw Diamond", tier = "Legendary", value = 4400, minDepth = 260, maxDepth = 2000 },
	{ id = "prism", name = "Prism Core", tier = "Mythic", value = 14000, minDepth = 260, maxDepth = 2000 },

	-- Magma Shelf / Frozen Deep --------------------------------------------
	{ id = "obsidian", name = "Obsidian Slab", tier = "Rare", value = 520, minDepth = 450, maxDepth = 2000 },
	{ id = "magmasteel", name = "Magmasteel", tier = "Epic", value = 1600, minDepth = 450, maxDepth = 2000 },
	{ id = "ruby", name = "Ruby Heart", tier = "Legendary", value = 6200, minDepth = 450, maxDepth = 2000 },
	{ id = "ember", name = "Ember Core", tier = "Mythic", value = 21000, minDepth = 450, maxDepth = 2000 },
	{ id = "cryonite", name = "Cryonite", tier = "Epic", value = 2400, minDepth = 700, maxDepth = 2000 },
	{ id = "glacier", name = "Glacier Pearl", tier = "Legendary", value = 8800, minDepth = 700, maxDepth = 2000 },
	{ id = "frostcore", name = "Frostbound Core", tier = "Mythic", value = 31000, minDepth = 700, maxDepth = 2000 },

	-- The Hollow ------------------------------------------------------------
	{ id = "hollowbone", name = "Hollow Bone", tier = "Legendary", value = 12000, minDepth = 1000, maxDepth = 3000 },
	{ id = "whisper", name = "Whisper Shard", tier = "Mythic", value = 46000, minDepth = 1000, maxDepth = 3000 },
	{ id = "nullstone", name = "Nullstone", tier = "Abyssal", value = 210000, minDepth = 1000, maxDepth = 3000 },

	-- Abyss Core ------------------------------------------------------------
	{ id = "abyssite", name = "Abyssite", tier = "Mythic", value = 68000, minDepth = 1400, maxDepth = 3000 },
	{ id = "voidglass", name = "Voidglass", tier = "Abyssal", value = 340000, minDepth = 1400, maxDepth = 3000 },
	{ id = "leviathan", name = "Leviathan Scale", tier = "Abyssal", value = 520000, minDepth = 1400, maxDepth = 3000 },

	-- The Singularity -------------------------------------------------------
	{ id = "fragment", name = "Singularity Fragment", tier = "Singularity", value = 4200000, minDepth = 2000, maxDepth = 3000 },
	{ id = "origin", name = "Origin Shard", tier = "Singularity", value = 9000000, minDepth = 2200, maxDepth = 3000 },

	-- Event-only. `seasonOnly` keeps it out of Ores.poolAt entirely, so it
	-- cannot be rolled outside a live window no matter how much luck is
	-- stacked. Server/Season.luau injects it directly.
	{ id = "seasoncore", name = "Season Core", tier = "Abyssal", value = 260000, minDepth = 120, maxDepth = 3000, seasonOnly = true },
}

Ores.ById = {}
for _, ore in ipairs(Ores.List) do
	Ores.ById[ore.id] = ore
end

-- What each ore looks like in the wall ---------------------------------------
--
-- A node decides what it is when it spawns, so the rock can show it. That is
-- the difference between a shaft of identical grey cubes and a wall where you
-- spot a gold seam from thirty studs away and change your route for it.
--
-- `look` picks the material family, `color` the vein itself:
--
--   metal    dull sheen, no transparency — copper, iron, silver, gold
--   gem      faceted and translucent — quartz, emerald, diamond, ruby
--   crystal  lit from inside, for the tiers worth shouting about
--   stone    matte, barely brighter than the rock around it
--   void     dark body, light that should not be there
--
-- An ore missing from this table falls back to its tier colour as a gem,
-- which is never wrong, only generic.
Ores.Appearance = {
	dirtstone = { look = "stone", color = { 124, 104, 86 } },
	coal = { look = "stone", color = { 42, 42, 50 } },
	clay = { look = "stone", color = { 172, 122, 94 } },
	copper = { look = "metal", color = { 214, 120, 60 } },
	fossil = { look = "stone", color = { 206, 196, 168 } },
	iron = { look = "metal", color = { 176, 182, 192 } },
	quartz = { look = "gem", color = { 236, 240, 248 } },
	silver = { look = "metal", color = { 228, 234, 242 } },
	gold = { look = "metal", color = { 255, 199, 54 } },
	cobalt = { look = "metal", color = { 62, 110, 235 } },
	meteorite = { look = "stone", color = { 98, 88, 106 } },
	relic = { look = "metal", color = { 208, 176, 104 } },
	amethyst = { look = "gem", color = { 168, 96, 244 } },
	emerald = { look = "gem", color = { 42, 222, 132 } },
	diamond = { look = "gem", color = { 156, 238, 255 } },
	prism = { look = "crystal", color = { 255, 255, 255 } },
	obsidian = { look = "stone", color = { 28, 22, 36 } },
	magmasteel = { look = "metal", color = { 255, 110, 44 } },
	ruby = { look = "gem", color = { 255, 58, 90 } },
	ember = { look = "crystal", color = { 255, 140, 32 } },
	cryonite = { look = "gem", color = { 122, 214, 255 } },
	glacier = { look = "gem", color = { 186, 240, 255 } },
	frostcore = { look = "crystal", color = { 150, 255, 255 } },
	hollowbone = { look = "stone", color = { 226, 220, 200 } },
	whisper = { look = "crystal", color = { 196, 150, 255 } },
	nullstone = { look = "void", color = { 34, 28, 46 } },
	abyssite = { look = "crystal", color = { 0, 226, 190 } },
	voidglass = { look = "void", color = { 120, 32, 190 } },
	leviathan = { look = "crystal", color = { 0, 255, 214 } },
	fragment = { look = "crystal", color = { 255, 255, 255 } },
	origin = { look = "crystal", color = { 255, 240, 190 } },
	seasoncore = { look = "crystal", color = { 255, 80, 200 } },
}

--- The vein colour and material family for an ore.
function Ores.appearance(oreId: string)
	local entry = Ores.Appearance[oreId]
	if entry then
		return entry
	end
	local ore = Ores.ById[oreId]
	local tier = Ores.Tiers[Ores.TierIndex[ore and ore.tier or "Common"] or 1]
	return { look = "gem", color = tier.color }
end

-- Cache the depth->pool lookup: Mining calls this on every swing.
local poolCache = {}

--- Every ore legal at `depth`, grouped by tier id.
function Ores.poolAt(depth: number)
	local bucket = math.floor(depth / 20) * 20
	local cached = poolCache[bucket]
	if cached then
		return cached
	end

	local byTier = {}
	for _, ore in ipairs(Ores.List) do
		if not ore.seasonOnly and bucket >= ore.minDepth and bucket <= ore.maxDepth then
			local list = byTier[ore.tier]
			if not list then
				list = {}
				byTier[ore.tier] = list
			end
			table.insert(list, ore)
		end
	end

	poolCache[bucket] = byTier
	return byTier
end

function Ores.color(tierId: string): Color3
	local tier = Ores.Tiers[Ores.TierIndex[tierId] or 1]
	return Color3.fromRGB(tier.color[1], tier.color[2], tier.color[3])
end

function Ores.tier(tierId: string)
	return Ores.Tiers[Ores.TierIndex[tierId] or 1]
end

return Ores

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX31">
          <Properties>
            <string name="Name">Products</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Products.luau — monetisation.

	IDs are 0 until you create the passes and products in the Roblox creator
	dashboard and paste the real numbers in. Everything degrades gracefully:
	an unconfigured product simply does not appear in the shop, and the game
	is fully completable without spending a single Robux.

	Design rule we hold to: passes buy SPEED and CONVENIENCE, never exclusive
	content and never protection from other players' actions. A paid player
	gets there sooner; nobody gets there only by paying.
]]

local Products = {}

Products.Gamepasses = {
	{
		id = "cash2x",
		assetId = 0,
		name = "2x Cash",
		desc = "Every deposit pays double. Forever.",
		icon = "💰",
		apply = { cashMultiplier = 2 },
	},
	{
		id = "luck2x",
		assetId = 0,
		name = "2x Luck",
		desc = "Doubles your roll luck on every swing.",
		icon = "🍀",
		apply = { luckMultiplier = 2 },
	},
	{
		id = "bigpack",
		assetId = 0,
		name = "+25 Cargo",
		desc = "A much bigger hold. Fewer trips, bigger hauls.",
		icon = "🎒",
		apply = { capacity = 25 },
	},
	{
		id = "autodrill",
		assetId = 0,
		name = "Auto Drill",
		desc = "Hold to keep mining the nearest node without tapping.",
		icon = "🤖",
		apply = { autoMine = true },
	},
	{
		id = "fastlift",
		assetId = 0,
		name = "Express Lift",
		desc = "Instant ride back to the surface from any depth.",
		icon = "🛗",
		apply = { fastLift = true },
	},
	{
		id = "vip",
		assetId = 0,
		name = "VIP Miner",
		desc = "+50% cash, +25% luck, a daily bonus and a VIP tag.",
		icon = "👑",
		apply = { cashMultiplier = 1.5, luckMultiplier = 1.25, vip = true },
	},
}

Products.DevProducts = {
	{ id = "cash_small", assetId = 0, name = "Cash Crate", desc = "A quick top-up.", icon = "📦", grant = { cashOfBest = 0.25 } },
	{ id = "cash_large", assetId = 0, name = "Cash Vault", desc = "A serious top-up.", icon = "🏦", grant = { cashOfBest = 1.5 } },
	{ id = "luck_potion", assetId = 0, name = "Luck Potion", desc = "3x luck for 10 minutes.", icon = "🧪", grant = { luckMultiplier = 3, minutes = 10 } },
	{ id = "rift_key", assetId = 0, name = "Rift Key", desc = "Open a private Rift Surge right where you stand.", icon = "🗝️", grant = { personalRift = 90 } },
	{ id = "revive", assetId = 0, name = "Cargo Insurance", desc = "Recover the cargo you just lost.", icon = "🛟", grant = { restoreCargo = true } },
}

--- One cheap, rotating product per day.
---
--- This exists because of a specific ranking signal: Roblox counts "7 day
--- spend days per user" separately from "7 day Robux spent per user". Five
--- small purchases on five days are worth more to discovery than one large
--- purchase on one day — and they are also friendlier to a player's wallet
--- than a single expensive pass. Keep these cheap and genuinely useful.
Products.DailyDeals = {
	{ id = "deal_luck", assetId = 0, name = "Shift Luck", desc = "2x luck for 20 minutes.", icon = "🍀", robux = 25, grant = { luckMultiplier = 2, minutes = 20 } },
	{ id = "deal_cash", assetId = 0, name = "Shift Bonus", desc = "A cash top-up scaled to your best haul.", icon = "💰", robux = 29, grant = { cashOfBest = 0.6 } },
	{ id = "deal_rift", assetId = 0, name = "Pocket Rift", desc = "60 seconds of private rift, right where you stand.", icon = "🗝️", robux = 39, grant = { personalRift = 60 } },
	{ id = "deal_air", assetId = 0, name = "Deep Lungs", desc = "Double air for 30 minutes.", icon = "🫁", robux = 25, grant = { oxygenMultiplier = 2, minutes = 30 } },
	{ id = "deal_crew", assetId = 0, name = "Crew Rations", desc = "Your whole crew gets 2x cash for 15 minutes.", icon = "🤝", robux = 45, grant = { crewCash = 2, minutes = 15 } },
	{ id = "deal_codex", assetId = 0, name = "Surveyor's Eye", desc = "3x luck for 10 minutes. Best odds in the game.", icon = "👁️", robux = 49, grant = { luckMultiplier = 3, minutes = 10 } },
}

--- Deterministic per UTC day, so every player sees the same deal and it is
--- obvious the offer is a rotation rather than a targeted price.
function Products.dealOfTheDay()
	local day = os.date("!*t")
	local index = ((day.year * 366 + day.yday) % #Products.DailyDeals) + 1
	return Products.DailyDeals[index]
end

--- Rewarded Video, opened to all eligible creators in February 2026 and now
--- worth roughly 8-15% of revenue for games that use it well.
---
--- Eligibility is not automatic: the experience needs 2FA, an ID-verified
--- 13+ owner, public status and at least 2,000 unique visitors per month. So
--- this stays switched off until you have those, and the button simply never
--- appears until Roblox reports an ad is available.
---
--- AdService builds the reward from a Developer Product, so create one named
--- after the boost and paste its id here. Ad rewards may never be Robux.
Products.RewardedVideo = {
	devProductId = 0,
	rewardMinutes = 10,
	rewardLuckMultiplier = 2,
	cooldownSeconds = 3600,
}

Products.GamepassById = {}
for _, pass in ipairs(Products.Gamepasses) do
	Products.GamepassById[pass.id] = pass
end

Products.DevProductById = {}
for _, product in ipairs(Products.DevProducts) do
	Products.DevProductById[product.id] = product
end
for _, product in ipairs(Products.DailyDeals) do
	Products.DevProductById[product.id] = product
end

--- Reverse lookup used by the receipt handler, built lazily so re-configured
--- asset ids during a live session still resolve.
function Products.byAssetId(assetId: number)
	if assetId == 0 then
		return nil
	end
	for _, list in ipairs({ Products.DevProducts, Products.DailyDeals }) do
		for _, product in ipairs(list) do
			if product.assetId == assetId then
				return product
			end
		end
	end
	return nil
end

function Products.configuredGamepasses()
	local out = {}
	for _, pass in ipairs(Products.Gamepasses) do
		if pass.assetId ~= 0 then
			table.insert(out, pass)
		end
	end
	return out
end

return Products

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX32">
          <Properties>
            <string name="Name">Quests</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Quests.luau — the "Aufgaben" layer.

	Three tracks, each doing a different job:

	  ONBOARDING  a forced-win chain for the first 5 minutes. Roblox lives or
	              dies on D1 retention, and D1 is decided before minute three.
	              Every step is completable by accident while playing normally.
	  DAILY       three rolled from a pool of twelve, reset at UTC midnight,
	              one free reroll. The reason to come back tomorrow.
	  MILESTONE   permanent, chunky, and visible from level one so there is
	              always a next mountain.

	metric  = the counter QuestService increments (see Server/Quests.luau)
	mode    = "count" adds up, "max" records a personal best
]]

local Quests = {}

Quests.Onboarding = {
	{ id = "ob_mine", name = "First Blood", desc = "Break 5 rocks.", metric = "mine", mode = "count", target = 5, reward = { cash = 150 } },
	{ id = "ob_bank", name = "Cash It In", desc = "Bank your cargo at the surface vault.", metric = "bank_runs", mode = "count", target = 1, reward = { cash = 300 } },
	{ id = "ob_upgrade", name = "Sharper Drill", desc = "Buy any upgrade.", metric = "upgrade", mode = "count", target = 1, reward = { cash = 500 } },
	{ id = "ob_depth", name = "Down We Go", desc = "Reach 50m depth.", metric = "depth", mode = "max", target = 50, reward = { cash = 900 } },
	{ id = "ob_rare", name = "Something Shiny", desc = "Mine a Rare or better ore.", metric = "mine_rare", mode = "count", target = 1, reward = { cash = 1500, luckMinutes = 5 } },
	{ id = "ob_deep", name = "Real Money", desc = "Bank 5,000 in a single trip.", metric = "bank_single", mode = "max", target = 5000, reward = { cash = 4000, drone = "scrap" } },
}

Quests.DailyPool = {
	{ id = "d_mine50", name = "Shift Work", desc = "Mine 50 ores.", metric = "mine", mode = "count", target = 50, reward = { cash = 6000 } },
	{ id = "d_mine150", name = "Double Shift", desc = "Mine 150 ores.", metric = "mine", mode = "count", target = 150, reward = { cash = 18000 } },
	{ id = "d_bank", name = "Payday", desc = "Bank 50,000 total.", metric = "bank", mode = "count", target = 50000, reward = { cash = 12000 } },
	{ id = "d_bankbig", name = "Heavy Haul", desc = "Bank 25,000 in one trip.", metric = "bank_single", mode = "max", target = 25000, reward = { cash = 15000 } },
	{ id = "d_depth300", name = "Pressure Test", desc = "Reach 300m.", metric = "depth", mode = "max", target = 300, reward = { cash = 9000 } },
	{ id = "d_depth700", name = "Cold Feet", desc = "Reach 700m.", metric = "depth", mode = "max", target = 700, reward = { cash = 30000 } },
	{ id = "d_rare", name = "Collector", desc = "Mine 10 Rare or better ores.", metric = "mine_rare", mode = "count", target = 10, reward = { cash = 14000 } },
	{ id = "d_epic", name = "Trophy Hunt", desc = "Mine 3 Epic or better ores.", metric = "mine_epic", mode = "count", target = 3, reward = { cash = 22000, luckMinutes = 10 } },
	{ id = "d_rift", name = "Surge Rider", desc = "Mine 15 ores during a Rift Surge.", metric = "rift_mine", mode = "count", target = 15, reward = { cash = 26000 } },
	{ id = "d_steal", name = "Finders Keepers", desc = "Take 2 crates or snatches from other miners.", metric = "steal", mode = "count", target = 2, reward = { cash = 16000 } },
	{ id = "d_upgrade", name = "Reinvest", desc = "Buy 5 upgrades.", metric = "upgrade", mode = "count", target = 5, reward = { cash = 11000 } },
	{ id = "d_survive", name = "Clean Run", desc = "Bank 5 trips without dying in between.", metric = "clean_banks", mode = "max", target = 5, reward = { cash = 20000, luckMinutes = 15 } },
	{ id = "d_crew", name = "Buddy System", desc = "Mine 10 minutes next to a crewmate.", metric = "crew_minutes", mode = "count", target = 10, reward = { cash = 24000 } },
	{ id = "d_rescue", name = "Good Samaritan", desc = "Return a crewmate's dropped cargo.", metric = "rescue", mode = "count", target = 1, reward = { cash = 18000 } },
}

Quests.DailyCount = 3
Quests.DailyRerolls = 1

Quests.Milestones = {
	{ id = "m_depth1000", name = "Into the Hollow", desc = "Reach 1,000m.", metric = "depth_alltime", mode = "max", target = 1000, reward = { cash = 120000 } },
	{ id = "m_depth2000", name = "Event Horizon", desc = "Reach 2,000m.", metric = "depth_alltime", mode = "max", target = 2000, reward = { cash = 2000000 } },
	{ id = "m_bank1m", name = "Millionaire", desc = "Bank 1,000,000 lifetime.", metric = "bank_alltime", mode = "count", target = 1000000, reward = { cash = 150000 } },
	{ id = "m_bank100m", name = "Shaft Baron", desc = "Bank 100,000,000 lifetime.", metric = "bank_alltime", mode = "count", target = 100000000, reward = { cash = 12000000 } },
	{ id = "m_codex15", name = "Half the Book", desc = "Find 15 different ores.", metric = "codex", mode = "max", target = 15, reward = { cash = 250000 } },
	{ id = "m_codex30", name = "Complete Codex", desc = "Find all 30 ores.", metric = "codex", mode = "max", target = 30, reward = { cash = 25000000, drone = "void", cosmetic = "title_codex" } },
	{ id = "m_rebirth5", name = "Five Lives", desc = "Rebirth 5 times.", metric = "rebirths", mode = "max", target = 5, reward = { cash = 1500000 } },
	{ id = "m_steal50", name = "Shaft Pirate", desc = "Take 50 crates or snatches.", metric = "steal_alltime", mode = "count", target = 50, reward = { cash = 800000, cosmetic = "title_pirate" } },
	{ id = "m_crew", name = "Never Alone", desc = "Mine 300 minutes alongside crewmates.", metric = "crew_minutes_alltime", mode = "count", target = 300, reward = { cash = 4000000, cosmetic = "trail_gold" } },
}

Quests.All = {}
for _, list in ipairs({ Quests.Onboarding, Quests.DailyPool, Quests.Milestones }) do
	for _, quest in ipairs(list) do
		Quests.All[quest.id] = quest
	end
end

return Quests

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX33">
          <Properties>
            <string name="Name">Ranks</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Ranks.luau — where you stand, as one word.

	Cash is the number you spend and it goes up and down. Depth resets every
	run. Rebirth wipes upgrades. None of those answer "how good am I", which
	is the question a player asks after their third session and the one that
	makes them open the game on day four.

	Rank answers it from lifetime banked cash: the only figure in the game
	that never goes down, not on death, not on a steal, not on a rebirth.
	Ten steps, roughly 5-6x apart, so every one is a real event — a ladder
	with twenty rungs is a progress bar, and nobody screenshots a progress
	bar.

	It is status only. No rank grants cash, luck, speed or capacity, and that
	is deliberate: the moment a rank pays, falling behind stops being a thing
	you want to fix and starts being a thing you resent.
]]

local Ranks = {}

Ranks.List = {
	{ id = "dust", name = "Dust", icon = "◆", at = 0, color = { 150, 150, 172 } },
	{ id = "copper", name = "Copper", icon = "◆", at = 5000, color = { 214, 120, 60 } },
	{ id = "iron", name = "Iron", icon = "◆", at = 25000, color = { 176, 182, 192 } },
	{ id = "silver", name = "Silver", icon = "◈", at = 120000, color = { 228, 234, 242 } },
	{ id = "gold", name = "Gold", icon = "◈", at = 600000, color = { 255, 199, 54 } },
	{ id = "emerald", name = "Emerald", icon = "❖", at = 3000000, color = { 42, 222, 132 } },
	{ id = "diamond", name = "Diamond", icon = "❖", at = 15000000, color = { 156, 238, 255 } },
	{ id = "obsidian", name = "Obsidian", icon = "✦", at = 80000000, color = { 176, 92, 255 } },
	{ id = "abyssal", name = "Abyssal", icon = "✦", at = 450000000, color = { 0, 255, 214 } },
	{ id = "singularity", name = "Singularity", icon = "✹", at = 3000000000, color = { 255, 255, 255 } },
}

Ranks.Index = {}
for i, rank in ipairs(Ranks.List) do
	Ranks.Index[rank.id] = i
end

--- The rank a lifetime total earns, and its position on the ladder.
function Ranks.at(banked: number)
	local chosen, index = Ranks.List[1], 1
	for i, rank in ipairs(Ranks.List) do
		if (banked or 0) >= rank.at then
			chosen, index = rank, i
		end
	end
	return chosen, index
end

--- The next rank up, or nil at the top.
function Ranks.next(banked: number)
	local _, index = Ranks.at(banked)
	return Ranks.List[index + 1]
end

--- 0..1 through the current rank. Sits at 1 for a player at the top, which
--- is the one place a full bar means "done" rather than "about to tick over".
function Ranks.progress(banked: number): number
	local current, index = Ranks.at(banked)
	local upcoming = Ranks.List[index + 1]
	if not upcoming then
		return 1
	end
	local span = upcoming.at - current.at
	if span <= 0 then
		return 1
	end
	return math.clamp(((banked or 0) - current.at) / span, 0, 1)
end

function Ranks.color(rankId: string)
	local rank = Ranks.List[Ranks.Index[rankId] or 1]
	return Color3.fromRGB(rank.color[1], rank.color[2], rank.color[3])
end

--- "◈ GOLD", the form used on the HUD, the nameplate and the boards.
function Ranks.label(banked: number): string
	local rank = Ranks.at(banked)
	return `{rank.icon} {string.upper(rank.name)}`
end

return Ranks

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX34">
          <Properties>
            <string name="Name">Rebirth</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Rebirth.luau — the reset that is a reward.

	Rebirth wipes cash and upgrades, keeps identity (codex, drones, records,
	cosmetics), and hands back permanent multipliers plus a deeper layer to
	survive in. The requirement is a two-key lock — cash AND depth — so you
	cannot rebirth purely by farming the safe layers.
]]

local Rebirth = {}

Rebirth.MaxTracked = 25

Rebirth.Titles = {
	[0] = "Surface Rat",
	[1] = "Shaft Hand",
	[2] = "Deep Digger",
	[3] = "Vein Hunter",
	[5] = "Hollow Walker",
	[8] = "Abyss Diver",
	[12] = "Pressure Saint",
	[16] = "Voidwright",
	[20] = "Singularity Born",
	[25] = "The Bottom",
}

--- Cash + depth needed to perform rebirth number `n + 1`.
---
--- The cash figure is anchored to the UPGRADE ladder, not picked by feel: a
--- mid drill/backpack costs six figures, so a five-figure rebirth would fire
--- before a player had bought anything worth keeping and the reset would read
--- as a punishment. At 800k the first rebirth lands after a real session, and
--- tools/balance-spec.luau fails if that drifts outside 15-90 minutes.
function Rebirth.requirement(n: number)
	return {
		cash = math.floor(800000 * (3.15 ^ n)),
		depth = math.min(150 + n * 130, 2400),
	}
end

--- Permanent, stacking bonuses granted by having `n` rebirths.
function Rebirth.bonuses(n: number)
	return {
		cashMultiplier = 1 + n * 0.25,
		luck = n * 0.18,
		capacity = n * 3,
		oxygen = n * 8,
	}
end

--- The highest title earned at `n` rebirths.
function Rebirth.title(n: number): string
	local best, bestAt = "Surface Rat", -1
	for at, title in pairs(Rebirth.Titles) do
		if n >= at and at > bestAt then
			best, bestAt = title, at
		end
	end
	return best
end

return Rebirth

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX35">
          <Properties>
            <string name="Name">Season</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Season.luau — the thing that makes a player think "I need that".

	Copied in structure, not in substance, from what demonstrably works on the
	platform right now: the biggest game on Roblox runs live weekend events
	whose rewards you simply do not get if you were not there. That is the
	whole mechanism. Scarcity plus a deadline plus something everyone can see
	you have.

	Three rules kept this from becoming the uglier version of itself:

	  NOTHING IS SOLD HERE. The season badge cannot be bought, at any price.
	  The moment scarcity is purchasable it stops being scarcity and starts
	  being a store.

	  THE PRICE IS ATTENDANCE, NOT MONEY. You show up in the window and mine.
	  A player with no Robux and two spare hours gets exactly what a paying
	  player gets.

	  IT IS ACHIEVABLE IN ONE SITTING. The badge threshold is set so a normal
	  session inside the window earns it. A deadline you cannot meet is not
	  urgency, it is just exclusion.

	We deliberately did NOT copy the rest of that game's toolkit — paid luck
	multipliers on a spinner, and loss mechanics tuned to make children cry
	for the clip. Those work too. They are not going in.
]]

local Season = {}

-- Seasons roll over on this cadence. The epoch is fixed so every server and
-- every player agrees which season it is without storing anything.
Season.Epoch = 1767225600 -- 2026-01-01T00:00:00Z
Season.LengthDays = 14

-- The live window: Saturday and Sunday, UTC. os.date("!*t").wday is
-- 1 = Sunday ... 7 = Saturday.
Season.WindowDays = { [7] = true, [1] = true }

--- The exclusive ore. It exists ONLY inside the window and is filtered out of
--- the normal tables everywhere else, so it cannot be farmed off-schedule.
Season.Ore = {
	id = "seasoncore",
	name = "Season Core",
	tier = "Abyssal",
	value = 260000,
	minDepth = 120, -- reachable without rebirths: the event is for everyone
}

--- Chance per swing inside the window, at depth. Generous on purpose: this is
--- attendance being rewarded, not another lottery.
Season.OreChance = 0.05

--- How many Season Cores earn the badge.
---
--- Tuned to about twenty-five minutes of real mining, travel and banking
--- included. The first pass sat at four minutes, which made the badge
--- something you picked up in passing — and a scarce thing nobody had to work
--- for is not scarce, it is just free. tools/balance-spec.luau fails if this
--- drifts back under eight modelled minutes.
Season.BadgeRequirement = 40

--- Cosmetics granted per season, cycled. Each is permanent and can never be
--- earned again once its season has passed.
Season.Badges = {
	{ title = "season_1", trail = "trail_season_1", label = "FIRST DESCENT" },
	{ title = "season_2", trail = "trail_season_2", label = "COLD SEAM" },
	{ title = "season_3", trail = "trail_season_3", label = "HOLLOW SEASON" },
	{ title = "season_4", trail = "trail_season_4", label = "PRESSURE SEASON" },
}

function Season.number(now: number?): number
	local elapsed = (now or os.time()) - Season.Epoch
	return math.max(1, math.floor(elapsed / (Season.LengthDays * 86400)) + 1)
end

function Season.badge(seasonNumber: number)
	local index = ((seasonNumber - 1) % #Season.Badges) + 1
	return Season.Badges[index]
end

--- Is the live window open right now?
function Season.isOpen(now: number?): boolean
	local parts = os.date("!*t", now or os.time())
	return Season.WindowDays[parts.wday] == true
end

--- Seconds until the window closes (when open) or opens (when shut).
function Season.secondsUntilChange(now: number?): number
	local current = now or os.time()
	local parts = os.date("!*t", current)
	local secondsToday = parts.hour * 3600 + parts.min * 60 + parts.sec
	local secondsLeftToday = 86400 - secondsToday

	if Season.isOpen(current) then
		-- Walk forward through the days that are still open.
		local remaining = secondsLeftToday
		local day = parts.wday
		for _ = 1, 6 do
			day = (day % 7) + 1
			if not Season.WindowDays[day] then
				break
			end
			remaining += 86400
		end
		return remaining
	end

	local remaining = secondsLeftToday
	local day = parts.wday
	for _ = 1, 7 do
		day = (day % 7) + 1
		if Season.WindowDays[day] then
			break
		end
		remaining += 86400
	end
	return remaining
end

return Season

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX36">
          <Properties>
            <string name="Name">Tools</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Tools.luau — the pickaxe in your hand.

	The game shipped without one. Players held nothing, swung nothing, and the
	only sign that mining was happening was a progress bar. In a game whose
	entire verb is "mine", that is the first thing anyone notices missing.

	The pickaxe also does a second job: it is the only upgrade in the game you
	can SEE. Drill Power is otherwise an invisible number that makes a bar
	fill faster. Now it changes the thing in your hand, and other players can
	tell how far along you are by looking at you.
]]

local Tools = {}

--- Picked by Drill Power level. `from` is inclusive.
Tools.Tiers = {
	{
		from = 0,
		name = "Rusted Pick",
		haft = { 96, 68, 38 },
		head = { 138, 108, 78 },
		headSize = { 3.4, 0.5, 0.5 },
		neon = false,
	},
	{
		from = 5,
		name = "Steel Pick",
		haft = { 104, 74, 42 },
		head = { 188, 194, 204 },
		headSize = { 3.9, 0.6, 0.6 },
		neon = false,
	},
	{
		from = 15,
		name = "Reinforced Pick",
		haft = { 72, 76, 86 },
		head = { 150, 172, 198 },
		headSize = { 4.4, 0.7, 0.7 },
		neon = false,
	},
	{
		from = 26,
		name = "Gilded Pick",
		haft = { 78, 60, 34 },
		head = { 255, 205, 90 },
		headSize = { 4.8, 0.8, 0.8 },
		neon = false,
	},
	{
		from = 38,
		name = "Abyssal Drill",
		haft = { 34, 30, 44 },
		head = { 0, 255, 214 },
		headSize = { 5.2, 0.9, 0.9 },
		neon = true,
	},
}

function Tools.tierFor(drillLevel: number)
	local chosen = Tools.Tiers[1]
	for _, tier in ipairs(Tools.Tiers) do
		if (drillLevel or 0) >= tier.from then
			chosen = tier
		end
	end
	return chosen
end

--- Where the pickaxe sits relative to the hand, and how far it swings.
Tools.Grip = { 0, -1.1, -0.4 }
Tools.SwingAngle = 105 -- degrees the head travels on a chop
Tools.ReturnFraction = 0.45 -- share of the swing spent coming back

return Tools

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX37">
          <Properties>
            <string name="Name">Upgrades</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Upgrades.luau — the cash sink.

	Costs grow geometrically, payouts grow linearly. That gap is the engine
	of the meta loop: every upgrade line eventually stalls, and the only way
	past the stall is to rebirth. Growth rates differ per line so players
	have a real choice about what to buy next instead of one dominant order.
]]

local Tools = require(script.Parent.Tools)

local Upgrades = {}

Upgrades.List = {
	{
		id = "drill",
		name = "Pickaxe",
		desc = "Sharpen the pick. Every level shaves time off each swing, and every few levels it becomes a better pickaxe.",
		icon = "⛏️",
		maxLevel = 50,
		baseCost = 120,
		growth = 1.26,
		-- fraction of the base mine time removed, asymptotic so it never hits 0
		effect = function(level: number): number
			return 1 - (0.955 ^ level)
		end,
		format = function(level: number): string
			return string.format(
				"%s · -%d%% swing time",
				Tools.tierFor(level).name,
				math.floor((1 - 0.955 ^ level) * 100)
			)
		end,
	},
	{
		id = "backpack",
		name = "Cargo Hold",
		desc = "Carry more before you are forced to surface.",
		icon = "🎒",
		maxLevel = 50,
		baseCost = 200,
		growth = 1.30,
		effect = function(level: number): number
			return level * 2
		end,
		format = function(level: number): string
			return string.format("+%d slots", level * 2)
		end,
	},
	{
		id = "boots",
		name = "Grip Boots",
		desc = "Move faster. Getting back up is half the run.",
		icon = "👟",
		maxLevel = 25,
		baseCost = 340,
		growth = 1.34,
		effect = function(level: number): number
			return level * 0.9
		end,
		format = function(level: number): string
			return string.format("+%.1f walkspeed", level * 0.9)
		end,
	},
	{
		id = "oxygen",
		name = "Air Tank",
		desc = "Stay down longer before the deep starts taking bites.",
		icon = "🫁",
		maxLevel = 30,
		baseCost = 420,
		growth = 1.31,
		effect = function(level: number): number
			return level * 7
		end,
		format = function(level: number): string
			return string.format("+%ds of air", level * 7)
		end,
	},
	{
		id = "lamp",
		name = "Headlamp",
		desc = "See further, and spot rich nodes before anyone else does.",
		icon = "🔦",
		maxLevel = 20,
		baseCost = 500,
		growth = 1.33,
		effect = function(level: number): number
			return level * 4
		end,
		format = function(level: number): string
			return string.format("+%d stud sight", level * 4)
		end,
	},
	{
		id = "pocket",
		name = "Safe Pocket",
		desc = "Part of your cargo survives a death or a snatch.",
		icon = "🔒",
		maxLevel = 10,
		baseCost = 2500,
		growth = 1.55,
		effect = function(level: number): number
			return math.min(level * 0.05, 0.5)
		end,
		format = function(level: number): string
			return string.format("%d%% protected", math.min(level * 5, 50))
		end,
	},
	{
		id = "charm",
		name = "Luck Charm",
		desc = "Shifts every roll toward the rare end of the table.",
		icon = "🍀",
		maxLevel = 25,
		baseCost = 1500,
		growth = 1.42,
		effect = function(level: number): number
			return level * 0.12
		end,
		format = function(level: number): string
			return string.format("+%.2f luck", level * 0.12)
		end,
	},
}

Upgrades.ById = {}
for i, upgrade in ipairs(Upgrades.List) do
	upgrade.order = i
	Upgrades.ById[upgrade.id] = upgrade
end

--- Cost of moving from `level` to `level + 1`.
function Upgrades.cost(id: string, level: number): number
	local upgrade = Upgrades.ById[id]
	if not upgrade then
		return math.huge
	end
	return math.floor(upgrade.baseCost * (upgrade.growth ^ level))
end

function Upgrades.value(id: string, level: number): number
	local upgrade = Upgrades.ById[id]
	if not upgrade then
		return 0
	end
	return upgrade.effect(level or 0)
end

function Upgrades.isMaxed(id: string, level: number): boolean
	local upgrade = Upgrades.ById[id]
	return upgrade ~= nil and (level or 0) >= upgrade.maxLevel
end

--- The next pickaxe you have not earned yet, and the level it arrives at.
--- Returns nil once the last one is in your hands.
function Upgrades.nextPickaxe(level: number)
	local current = Tools.tierFor(level)
	for _, tier in ipairs(Tools.Tiers) do
		if tier.from > (level or 0) and tier.name ~= current.name then
			return tier
		end
	end
	return nil
end

return Upgrades

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="RBX38">
        <Properties>
          <string name="Name">Format</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Format.luau — number and time formatting.

	Roblox economies run into numbers no human reads at a glance. Everything
	shown to a player goes through here so "12.4M" never appears next to
	"12400000" on the same screen.
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

--- 12400 -> "12.4K". Keeps three significant digits, which is the most a
--- player can absorb mid-swing.
function Format.short(value: number): string
	value = value or 0
	local negative = value < 0
	value = math.abs(value)

	if value < 1000 then
		local rounded = math.floor(value + 0.5)
		return (negative and "-" or "") .. tostring(rounded)
	end

	local index = math.min(math.floor(math.log(value, 1000)), #SUFFIXES - 1)
	local scaled = value / (1000 ^ index)
	local text
	if scaled >= 100 then
		text = string.format("%.0f", scaled)
	elseif scaled >= 10 then
		text = string.format("%.1f", scaled)
	else
		text = string.format("%.2f", scaled)
	end

	-- Trim trailing zeros so we get "1.5K" instead of "1.50K". Guarded on a
	-- decimal point being present: without the guard "250" becomes "25",
	-- which silently divides every round number on screen by ten.
	if text:find("%.") then
		text = text:gsub("0+$", "")
		text = text:gsub("%.$", "")
	end

	return (negative and "-" or "") .. text .. SUFFIXES[index + 1]
end

function Format.comma(value: number): string
	local text = tostring(math.floor(value or 0))
	local result = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (result:gsub("^,", ""))
end

--- 95 -> "1:35". Used for rift countdowns and quest resets.
function Format.clock(seconds: number): string
	seconds = math.max(0, math.floor(seconds or 0))
	local hours = math.floor(seconds / 3600)
	local minutes = math.floor((seconds % 3600) / 60)
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%d:%02d:%02d", hours, minutes, secs)
	end
	return string.format("%d:%02d", minutes, secs)
end

--- 0.000004 -> "1 in 250K". Shown on the rarity reveal, because the odds
--- are the brag.
function Format.odds(probability: number): string
	if probability <= 0 then
		return "?"
	end
	return "1 in " .. Format.short(math.floor(1 / probability + 0.5))
end

function Format.depth(meters: number): string
	return Format.comma(math.floor(meters or 0)) .. "m"
end

return Format

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX39">
        <Properties>
          <string name="Name">Net</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Net.luau — every remote in the game, declared in one place.

	The server builds the remote tree on first require; the client waits for
	it. Server handlers get a token-bucket rate limit for free, because an
	unthrottled RemoteEvent is the single most common way a Roblox game gets
	taken apart by an exploiter.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = {}

local IS_SERVER = RunService:IsServer()

-- name -> requests per second allowed from a single client.
-- Mining is the hot path; everything else is a UI click.
Net.Events = {
	Mine = 12,
	Bank = 4,
	BuyUpgrade = 8,
	BuyDrone = 4,
	EquipDrone = 4,
	Snatch = 2,
	GrabCrate = 6,
	ClaimQuest = 8,
	RerollDaily = 2,
	Rebirth = 2,
	UseLift = 3,
	EmergencyAscent = 2,

	-- Co-play. Ping is the only one with real traffic; it is the entire
	-- coordination vocabulary now that chat is age-gated.
	CrewBeacon = 2,
	CrewJoin = 3,
	CrewLeave = 3,
	Ping = 3,
	Rescue = 4,

	-- Long-arc retention and status.
	ClaimContract = 6,
	ClaimDescent = 6,
	EquipCosmetic = 6,
	BuyCosmetic = 4,
	WatchAd = 1,
	IntroSeen = 1,
}

-- Server -> client only.
Net.Signals = {
	"State", -- partial state patch
	"Toast", -- corner notification
	"Reveal", -- big centre-screen ore reveal
	"Rift", -- rift start/stop/tick
	"Effect", -- one-shot client feedback (shake, sfx, particles)
	"Marked", -- another player crossed the greed threshold
	"Crew", -- crew roster and nearby beacons
	"Pings", -- a teammate marked something in the world
	"Ad", -- rewarded-video availability changed
	"Season", -- live window state and badge progress
}

Net.Functions = {
	"GetState",
	"GetBoards",
}

local root: Instance
local events: Folder
local signals: Folder
local functions: Folder

local function build()
	if IS_SERVER then
		root = Instance.new("Folder")
		root.Name = "DeepRushNet"

		events = Instance.new("Folder")
		events.Name = "Events"
		events.Parent = root

		signals = Instance.new("Folder")
		signals.Name = "Signals"
		signals.Parent = root

		functions = Instance.new("Folder")
		functions.Name = "Functions"
		functions.Parent = root

		for name in pairs(Net.Events) do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = events
		end
		for _, name in ipairs(Net.Signals) do
			local remote = Instance.new("RemoteEvent")
			remote.Name = name
			remote.Parent = signals
		end
		for _, name in ipairs(Net.Functions) do
			local remote = Instance.new("RemoteFunction")
			remote.Name = name
			remote.Parent = functions
		end

		root.Parent = ReplicatedStorage
	else
		root = ReplicatedStorage:WaitForChild("DeepRushNet", 30)
		assert(root, "DeepRush: server never published its remotes")
		events = root:WaitForChild("Events")
		signals = root:WaitForChild("Signals")
		functions = root:WaitForChild("Functions")
	end
end

build()

-- Rate limiting -----------------------------------------------------------
local buckets: { [Player]: { [string]: { tokens: number, last: number } } } = {}

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

local function allow(player: Player, name: string, perSecond: number): boolean
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end

	local bucket = playerBuckets[name]
	local now = os.clock()
	if not bucket then
		bucket = { tokens = perSecond, last = now }
		playerBuckets[name] = bucket
	end

	-- Refill, capped at one second of burst.
	bucket.tokens = math.min(perSecond, bucket.tokens + (now - bucket.last) * perSecond)
	bucket.last = now

	if bucket.tokens < 1 then
		return false
	end
	bucket.tokens -= 1
	return true
end

-- Server API --------------------------------------------------------------

--- Handle a client event. Over-rate calls are dropped silently — telling a
--- cheater which limit they hit is free information for them.
function Net.on(name: string, handler: (Player, ...any) -> ())
	assert(IS_SERVER, "Net.on is server-only")
	local perSecond = Net.Events[name]
	assert(perSecond, `Net: unknown event "{name}"`)

	events[name].OnServerEvent:Connect(function(player, ...)
		if not allow(player, name, perSecond) then
			return
		end
		local ok, err = pcall(handler, player, ...)
		if not ok then
			warn(`DeepRush: handler "{name}" failed for {player.Name}: {err}`)
		end
	end)
end

function Net.handle(name: string, handler: (Player, ...any) -> any)
	assert(IS_SERVER, "Net.handle is server-only")
	functions[name].OnServerInvoke = function(player, ...)
		local ok, result = pcall(handler, player, ...)
		if not ok then
			warn(`DeepRush: function "{name}" failed for {player.Name}: {result}`)
			return nil
		end
		return result
	end
end

function Net.to(player: Player, signal: string, ...)
	assert(IS_SERVER, "Net.to is server-only")
	local remote = signals:FindFirstChild(signal)
	if remote then
		remote:FireClient(player, ...)
	end
end

function Net.all(signal: string, ...)
	assert(IS_SERVER, "Net.all is server-only")
	local remote = signals:FindFirstChild(signal)
	if remote then
		remote:FireAllClients(...)
	end
end

function Net.except(skip: Player, signal: string, ...)
	assert(IS_SERVER, "Net.except is server-only")
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= skip then
			Net.to(player, signal, ...)
		end
	end
end

-- Client API --------------------------------------------------------------

function Net.fire(name: string, ...)
	assert(not IS_SERVER, "Net.fire is client-only")
	events[name]:FireServer(...)
end

function Net.listen(signal: string, handler: (...any) -> ())
	assert(not IS_SERVER, "Net.listen is client-only")
	return signals[signal].OnClientEvent:Connect(handler)
end

function Net.invoke(name: string, ...)
	assert(not IS_SERVER, "Net.invoke is client-only")
	return functions[name]:InvokeServer(...)
end

return Net

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX40">
        <Properties>
          <string name="Name">Rarity</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Rarity.luau — the weighted roll, and the honest odds display.

	Luck does not add a flat bonus; it bends the whole curve. Each tier's
	weight is multiplied by luck^(steps above Common * 0.6), so luck is worth
	dramatically more at the top of the table than the bottom. That is what
	makes a Luck Potion feel different from a Cash Potion.

	Where the roll happens changed once the ore became visible in the rock.
	A node decides what it is when it spawns, at luck 1 — the wall has no idea
	who is going to swing at it, and a shared node cannot roll on one player's
	luck. So luck moved to the swing, as a second chance:

	  1. the node is what you can see: gold vein, diamond, plain dirtstone
	  2. with probability 1 - 1/luck you also roll the luck-weighted table
	  3. you keep whichever is rarer — never worse than what you could see

	Two things fall out of that, and both are worth more than the old
	invisible curve. The world stops lying: a diamond in the wall is a
	diamond, and running for it is a real decision. And luck becomes an event
	you watch happen — LUCKY STRIKE, gold turning into something better —
	instead of a number that quietly bends a table you never see.

	`Rarity.odds` returns the honest result of all three steps, so the codex
	and the reveal card still print what actually happened.
]]

local Ores = require(script.Parent.Config.Ores)

local Rarity = {}

Rarity.LuckExponent = 0.6

local function effectiveWeight(tier, tierIndex: number, luck: number): number
	if tierIndex <= 1 then
		return tier.weight
	end
	return tier.weight * (luck ^ ((tierIndex - 1) * Rarity.LuckExponent))
end

--- Roll one of the tiers present in `pool` (a tierId -> ores map from
--- Ores.poolAt). Returns the tier id, or nil if the pool is empty.
function Rarity.rollTier(pool, luck: number, rng: Random?): string?
	luck = math.max(luck or 1, 0.1)
	local random = rng or Random.new()

	local total = 0
	local candidates = {}
	for index, tier in ipairs(Ores.Tiers) do
		if pool[tier.id] and #pool[tier.id] > 0 then
			local weight = effectiveWeight(tier, index, luck)
			total += weight
			table.insert(candidates, { id = tier.id, weight = weight })
		end
	end

	if total <= 0 then
		return nil
	end

	-- Walk from the rarest end so floating point error lands on Common,
	-- the tier nobody notices losing a millionth of a percent.
	local roll = random:NextNumber() * total
	for i = #candidates, 1, -1 do
		roll -= candidates[i].weight
		if roll <= 0 then
			return candidates[i].id
		end
	end
	return candidates[1].id
end

--- Share of swings that get the second, luck-weighted roll. At luck 1 it is
--- zero and the node is simply what it looks like; it approaches 1 from
--- below, so the visible ore always keeps some weight.
function Rarity.luckShare(luck: number): number
	luck = math.max(luck or 1, 1)
	return 1 - 1 / luck
end

--- Tier probabilities for a single weighted roll at `luck`. Internal: this is
--- one of the three steps, not what a player experiences.
local function tierOdds(pool, luck: number)
	luck = math.max(luck or 1, 0.1)

	local total = 0
	local weights = {}
	for index, tier in ipairs(Ores.Tiers) do
		if pool[tier.id] and #pool[tier.id] > 0 then
			local weight = effectiveWeight(tier, index, luck)
			weights[tier.id] = weight
			total += weight
		end
	end

	local out = {}
	for id, weight in pairs(weights) do
		out[id] = weight / total
	end
	return out
end

Rarity.tierOdds = tierOdds

--- What a player actually pulls: the node's own tier, kept unless the luck
--- roll beats it.
---
--- max(node, lucky) lands on tier i when the node is i and the lucky roll did
--- not pass it, or the lucky roll is i and the node was below. Both terms are
--- exact, so the odds printed on a reveal card are the real ones and not an
--- approximation of them.
function Rarity.odds(pool, luck: number)
	luck = math.max(luck or 1, 0.1)
	local base = tierOdds(pool, 1)
	if luck <= 1 then
		return base
	end

	local lucky = tierOdds(pool, luck)
	local share = Rarity.luckShare(luck)

	local out = {}
	local belowNode = 0 -- P(node tier < i), walking the ladder upward
	local upToLucky = 0 -- P(lucky roll <= i)
	for _, tier in ipairs(Ores.Tiers) do
		local b = base[tier.id]
		if b then
			local l = lucky[tier.id] or 0
			upToLucky += l
			out[tier.id] = (1 - share) * b + share * (b * upToLucky + l * belowNode)
			belowNode += b
		end
	end
	return out
end

--- Roll what a node is when it spawns: no luck, because nobody owns it yet.
function Rarity.rollNodeOre(depth: number, rng: Random?)
	local pool = Ores.poolAt(depth)
	local tierId = Rarity.rollTier(pool, 1, rng)
	if not tierId then
		return nil
	end

	local options = pool[tierId]
	local random = rng or Random.new()
	return options[random:NextInteger(1, #options)]
end

--- The swing. Returns the ore you get, its real probability, and whether luck
--- is what got it for you.
function Rarity.resolve(nodeOre, depth: number, luck: number, rng: Random?)
	local pool = Ores.poolAt(depth)
	local odds = Rarity.odds(pool, luck)
	local result = nodeOre
	local upgraded = false

	luck = math.max(luck or 1, 0.1)
	local random = rng or Random.new()
	if luck > 1 and random:NextNumber() < Rarity.luckShare(luck) then
		local tierId = Rarity.rollTier(pool, luck, random)
		if tierId and Ores.TierIndex[tierId] > Ores.TierIndex[nodeOre.tier] then
			local options = pool[tierId]
			result = options[random:NextInteger(1, #options)]
			upgraded = true
		end
	end

	return result, odds[result.tier] or 0, upgraded
end

--- Roll an ore end to end, as if a node had spawned and been struck at once.
--- Nothing in the game does that any more; the balance harness does.
function Rarity.rollOre(depth: number, luck: number, rng: Random?)
	local nodeOre = Rarity.rollNodeOre(depth, rng)
	if not nodeOre then
		return nil
	end
	local ore, probability = Rarity.resolve(nodeOre, depth, luck, rng)
	return ore, probability
end

return Rarity

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX41">
        <Properties>
          <string name="Name">Signal</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Signal.luau — a minimal observer, used by the client state store.

	BindableEvents would work, but they deep-copy tables across the boundary,
	which quietly breaks patch objects. This does not.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = { disconnect: (Connection) -> () }

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:connect(handler: (...any) -> ())
	local entry = { handler = handler }
	table.insert(self._handlers, entry)

	return {
		disconnect = function()
			local index = table.find(self._handlers, entry)
			if index then
				table.remove(self._handlers, index)
			end
		end,
	}
end

function Signal:fire(...)
	-- Iterate a copy: a handler is allowed to disconnect itself.
	local snapshot = table.clone(self._handlers)
	for _, entry in ipairs(snapshot) do
		local ok, err = pcall(entry.handler, ...)
		if not ok then
			warn("DeepRush: signal handler error: " .. tostring(err))
		end
	end
end

function Signal:destroy()
	table.clear(self._handlers)
end

return Signal

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="RBX69">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="RBX43">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="RBX44">
        <Properties>
          <string name="Name">Ads</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Ads.luau — opt-in Rewarded Video.

	Roblox opened Rewarded Video to all eligible creators in February 2026,
	and for games that place it well it now carries a real slice of revenue
	without touching game balance. Ours pays a luck boost — never Robux,
	never anything a player could not also earn.

	Two boundaries this module holds deliberately:

	  IT IS A BUTTON, NOT A LOOP. In August 2026 Roblox banned experiences
	  that pair a media feed with autoplay/infinite-scroll and rewards gated
	  on continuous viewing, after Steal an Egg's treadmill Reels. A single
	  opt-in video behind an hour-long cooldown is the opposite shape, and we
	  keep it that way: no feed, no autoplay, no reward that requires
	  continued watching.

	  IT NEVER APPEARS UNLESS IT WORKS. Availability is asked of Roblox first,
	  so a player is never shown a button that fails. Before the experience is
	  ads-eligible at all, the whole feature is silently absent.
]]

local AdService = game:GetService("AdService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ProductConfig = require(Shared.Config.Products)
local Net = require(Shared.Net)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)

local Ads = {}

local settings = ProductConfig.RewardedVideo
local available = false
local showing: { [Player]: boolean } = {}

local function isConfigured(): boolean
	return settings.devProductId ~= 0
end

--- Roblox has reported this result object under more than one field name
--- across engine releases, so accept either rather than pinning one and
--- silently disabling the feature on the next update.
local function checkAvailability(): boolean
	if not isConfigured() then
		return false
	end

	local ok, result = pcall(function()
		return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
	end)
	if not ok or result == nil then
		return false
	end

	local status = result
	if type(result) == "table" or typeof(result) == "Instance" then
		status = result.AdAvailabilityResult or result.Result or result
	end
	return string.find(tostring(status), "Available") ~= nil
end

function Ads.offer(player: Player)
	local profile = Data.get(player)
	local session = Data.session(player)
	if not profile or not session or not isConfigured() then
		return
	end

	if showing[player] then
		return
	end

	local since = os.time() - (session.lastAd or 0)
	if since < settings.cooldownSeconds then
		Feedback.toast(player, {
			title = "ALREADY BOOSTED",
			body = `Next free boost in {math.ceil((settings.cooldownSeconds - since) / 60)} min.`,
			kind = "error",
		})
		return
	end

	if not available then
		Feedback.toast(player, { title = "NO BOOST AVAILABLE", body = "Try again later.", kind = "error" })
		return
	end

	showing[player] = true

	local ok, result = pcall(function()
		local reward = AdService:CreateAdRewardFromDevProductId(settings.devProductId)
		return AdService:ShowRewardedVideoAdAsync(player, reward)
	end)

	showing[player] = nil

	if not ok then
		warn("DeepRush: rewarded video failed: " .. tostring(result))
		return
	end

	if result ~= Enum.ShowAdResult.ShowCompleted then
		return
	end

	session.lastAd = os.time()
	Economy.addBuff(player, "luck", settings.rewardLuckMultiplier, settings.rewardMinutes * 60)
	Feedback.effect(player, "purchase", {})
	Feedback.toast(player, {
		title = `{settings.rewardLuckMultiplier}x LUCK`,
		body = `Active for {settings.rewardMinutes} minutes. Thanks for watching.`,
		kind = "rift",
	})
	Net.to(player, "Ad", { available = false, nextAt = session.lastAd + settings.cooldownSeconds })
end

function Ads.start()
	if not isConfigured() then
		-- Nothing to do, and nothing shown to players. Set
		-- Products.RewardedVideo.devProductId once the experience qualifies.
		return
	end

	Net.on("WatchAd", function(player)
		task.spawn(Ads.offer, player)
	end)

	task.spawn(function()
		-- Asking before AdService has loaded returns a false "no fill".
		if not AdService:IsLoaded() then
			pcall(function()
				AdService.Loaded:Wait()
			end)
		end

		while true do
			available = checkAvailability()
			for _, player in ipairs(Players:GetPlayers()) do
				local session = Data.session(player)
				if session then
					local ready = os.time() - (session.lastAd or 0) >= settings.cooldownSeconds
					Net.to(player, "Ad", { available = available and ready })
				end
			end
			task.wait(60)
		end
	end)
end

return Ads

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX45">
        <Properties>
          <string name="Name">AntiCheat</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	AntiCheat.luau — movement sanity only.

	Deliberately narrow. The real protection in this game is that the server
	owns every decision that matters: what an ore is worth, whether a node
	exists, whether you are near the vault, what an upgrade costs. This module
	only covers the one thing the client legitimately controls — its own
	character position.

	Vertical movement is exempt. Players fall 9,000 studs down an open shaft,
	and any speed threshold that allows that also allows every vertical
	exploit, so there is no honest check to make there.
]]

local Players = game:GetService("Players")

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)

local AntiCheat = {}

local HORIZONTAL_TOLERANCE = 2.2 -- multiple of the player's legal walkspeed
local TELEPORT_THRESHOLD = 220 -- studs in one sample: never legitimate
local SAMPLE_RATE = 0.5

local lastKnown: { [Player]: Vector3 } = {}
local strikes: { [Player]: number } = {}

local function rootOf(player: Player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function sample()
	for _, player in ipairs(Players:GetPlayers()) do
		local session = Data.session(player)
		local root = rootOf(player)

		if not root or not session then
			lastKnown[player] = nil
		elseif session.lifting then
			-- The server teleports players during a lift ride; do not flag
			-- the movement we caused ourselves.
			lastKnown[player] = root.Position
		else
			local previous = lastKnown[player]
			lastKnown[player] = root.Position

			if previous then
				local delta = root.Position - previous
				local horizontal = Vector2.new(delta.X, delta.Z).Magnitude
				local allowed = Economy.walkSpeed(player) * SAMPLE_RATE * HORIZONTAL_TOLERANCE + 8

				if horizontal > TELEPORT_THRESHOLD or horizontal > allowed then
					strikes[player] = (strikes[player] or 0) + 1
					-- Three strikes before acting: a lag spike looks exactly
					-- like a small teleport, and snapping a laggy player back
					-- is worse than letting one cheat through.
					if strikes[player] >= 3 then
						strikes[player] = 0
						root.CFrame = CFrame.new(previous)
						lastKnown[player] = previous
					end
				else
					strikes[player] = 0
				end
			end
		end
	end
end

function AntiCheat.start()
	task.spawn(function()
		while true do
			task.wait(SAMPLE_RATE)
			sample()
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastKnown[player] = nil
		strikes[player] = nil
	end)
end

return AntiCheat

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="Script" referent="RBX46">
        <Properties>
          <string name="Name">Bootstrap</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Bootstrap.server.luau — start order is the dependency order.

	Data goes first because it publishes the remote tree and owns profiles;
	everything else assumes a profile can exist. World goes early because
	Surface and Steal need the vault and the crate container to be there.
]]

local SERVICES = {
	"Data",
	"World",
	"Crew",
	"Economy",
	"Cargo",
	"Cosmetics",
	"Tools",
	"Contracts",
	"Quests",
	"Rift",
	"Season",
	"Mining",
	"Surface",
	"Steal",
	"Hazards",
	"Upgrades",
	"Rebirth",
	"Drones",
	"Rewards",
	"Leaderboards",
	"Monetization",
	"Ads",
	"AntiCheat",
}

local Players = game:GetService("Players")

-- Nobody arrives before there is somewhere to arrive.
--
-- This world is generated at runtime, and Data.start touches DataStores,
-- which yields. In Studio the local player joins at the same instant the
-- server boots, so without this the character spawns into an empty Workspace
-- and falls — and since the shaft needs FallenPartsDestroyHeight down at
-- -9,400, it falls for about ten seconds before anything resets it. The
-- symptom is a player in the sky with nothing around them, which is
-- indistinguishable from a broken download.
Players.CharacterAutoLoads = false

local started = os.clock()
local failures = {}

--- A sign you cannot miss, standing where the player arrives.
---
--- Every service start is wrapped in pcall so one broken system cannot take
--- the rest down. The cost of that is silence: the failure goes to warn(),
--- and a warn() is invisible unless you have the Output window open and know
--- to look. Somebody opening this place for the first time sees a world that
--- did not build and no reason why.
local function report(lines: { string })
	local board = Instance.new("Part")
	board.Name = "BootReport"
	board.Size = Vector3.new(48, 20, 1)
	board.CFrame = CFrame.new(0, 12, 60)
	board.Anchored = true
	board.CanCollide = false
	board.Color = Color3.fromRGB(18, 14, 16)
	board.Material = Enum.Material.SmoothPlastic
	board.Parent = workspace

	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Back
	surface.CanvasSize = Vector2.new(960, 400)
	surface.LightInfluence = 0
	surface.Parent = board

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(18, 14, 16)
	frame.Parent = surface

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.Parent = frame

	for index, text in ipairs(lines) do
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, -24, 0, index == 1 and 64 or 34)
		label.BackgroundTransparency = 1
		label.Font = index == 1 and Enum.Font.GothamBlack or Enum.Font.GothamMedium
		label.Text = text
		label.TextColor3 = index == 1 and Color3.fromRGB(255, 90, 90) or Color3.fromRGB(235, 230, 235)
		label.TextScaled = true
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = frame
	end
end

for _, name in ipairs(SERVICES) do
	local module = script.Parent:FindFirstChild(name)
	if not module then
		warn(`DeepRush: service "{name}" is missing`)
		table.insert(failures, `{name}: the module is not in ServerScriptService/Server`)
		continue
	end

	local ok, service = pcall(require, module)
	if not ok then
		warn(`DeepRush: service "{name}" failed to load: {service}`)
		table.insert(failures, `{name} failed to load — {service}`)
		continue
	end

	if type(service) == "table" and type(service.start) == "function" then
		local startOk, err = pcall(service.start)
		if not startOk then
			warn(`DeepRush: service "{name}" failed to start: {err}`)
			table.insert(failures, `{name} failed to start — {err}`)
		end
	end

	-- The moment the world exists, people may enter it. Waiting for all
	-- twenty-three would mean one slow or broken service downstream leaves
	-- every player with no character at all — a worse failure than the one
	-- holding them back was meant to prevent.
	if name == "World" then
		Players.CharacterAutoLoads = true
		for _, player in ipairs(Players:GetPlayers()) do
			if not player.Character then
				player:LoadCharacter()
			end
		end
	end
end

-- And a backstop, in case World never got that far: standing on the
-- placeholder pad reading an error beats never spawning at all.
if not Players.CharacterAutoLoads then
	Players.CharacterAutoLoads = true
	for _, player in ipairs(Players:GetPlayers()) do
		if not player.Character then
			player:LoadCharacter()
		end
	end
end

if #failures > 0 then
	local lines = { `DEEP RUSH — {#failures} SYSTEM(S) DID NOT START` }
	for _, failure in ipairs(failures) do
		table.insert(lines, "• " .. failure)
	end
	table.insert(lines, "")
	table.insert(lines, "The same text is in View > Output.")
	report(lines)
end

print(string.format("[DEEP RUSH] %d services up in %.2fs", #SERVICES, os.clock() - started))

-- The audio notice. Roblox will only play sound that lives on its own
-- servers, so the nine files in `audio/` have to be uploaded from your own
-- account — no place file can carry them and nobody can upload them for you.
-- Until then the game runs on the built-in client sounds, which work but are
-- much thinner. This says so once, plainly, instead of leaving you to wonder
-- why it sounds flat.
local missingAudio = require(game:GetService("ReplicatedStorage").Shared.Config.Audio).missing()
if #missingAudio > 0 then
	local lines = {
		`[DEEP RUSH] audio: {#missingAudio} of 9 sounds are still on the built-in fallback.`,
		"  Upload these in Studio (Home > Asset Manager > Audio > right-click > Add Audio),",
		"  then paste each id into Shared/Config/Audio -> Audio.Custom:",
	}
	for _, entry in ipairs(missingAudio) do
		table.insert(lines, `    {entry.slot} = "" -- {entry.file}`)
	end
	print(table.concat(lines, "\n"))
end

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX47">
        <Properties>
          <string name="Name">Cargo</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Cargo.luau — unbanked loot, and the greed that makes it interesting.

	Cargo is deliberately NOT saved. Everything you are carrying is at risk
	until you bank it, and that risk is the entire tension of the core loop.

	Greed is simply how full your hold is. We tried value-weighted formulas;
	fill ratio won because a player can read it off the bar without doing
	arithmetic, and "your bag is nearly full so you are a target" is a rule
	you can explain to a nine-year-old in one sentence.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)

local Cargo = {}

local function sync(player: Player)
	local session = Data.session(player)
	if not session then
		return
	end
	Data.push(player, {
		cargo = {
			count = #session.cargo.items,
			value = session.cargo.value,
			capacity = Economy.capacity(player),
			greed = Cargo.greed(player),
		},
	})
end

function Cargo.get(player: Player)
	local session = Data.session(player)
	return session and session.cargo or nil
end

function Cargo.isFull(player: Player): boolean
	local session = Data.session(player)
	if not session then
		return true
	end
	return #session.cargo.items >= Economy.capacity(player)
end

--- 0..1. Above Config.GreedMarkThreshold the player is stealable.
function Cargo.greed(player: Player): number
	local session = Data.session(player)
	if not session then
		return 0
	end
	local capacity = Economy.capacity(player)
	if capacity <= 0 then
		return 0
	end
	return math.clamp(#session.cargo.items / capacity, 0, 1)
end

function Cargo.isMarked(player: Player): boolean
	return Cargo.greed(player) >= Config.GreedMarkThreshold
end

--- entry = { oreId, tier, mutation, value }
function Cargo.add(player: Player, entry): boolean
	local session = Data.session(player)
	if not session or Cargo.isFull(player) then
		return false
	end

	table.insert(session.cargo.items, entry)
	session.cargo.value += entry.value
	sync(player)
	return true
end

--- Remove a fraction of the hold, newest first (you drop what is on top).
--- Returns the removed items and their value.
function Cargo.take(player: Player, fraction: number)
	local session = Data.session(player)
	if not session or #session.cargo.items == 0 then
		return {}, 0
	end

	local count = math.max(1, math.floor(#session.cargo.items * fraction))
	local taken, value = {}, 0
	for _ = 1, count do
		local entry = table.remove(session.cargo.items)
		if not entry then
			break
		end
		table.insert(taken, entry)
		value += entry.value
		session.cargo.value -= entry.value
	end

	session.cargo.value = math.max(0, session.cargo.value)
	sync(player)
	return taken, value
end

function Cargo.clear(player: Player)
	local session = Data.session(player)
	if not session then
		return {}, 0
	end
	local items = session.cargo.items
	local value = session.cargo.value
	session.cargo = { items = {}, value = 0 }
	sync(player)
	return items, value
end

--- Merge foreign items into this player's hold, dropping the overflow.
--- Returns how much value actually fit.
function Cargo.give(player: Player, items): number
	local gained = 0
	for _, entry in ipairs(items) do
		if not Cargo.add(player, entry) then
			break
		end
		gained += entry.value
	end
	return gained
end

function Cargo.resync(player: Player)
	sync(player)
end

function Cargo.start()
	-- Without this a player who has upgrades but has not mined yet sees the
	-- base capacity of 8 on their HUD until their first swing.
	Data.loaded:connect(function(player)
		sync(player)
	end)
end

return Cargo

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX48">
        <Properties>
          <string name="Name">Contracts</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Contracts.luau — the long arc.

	Roblox grades a new experience across day 1, days 2-7 AND days 8-28, and
	counts "play days per user" rather than hours. Before this module the
	longest arc in DEEP RUSH was a daily quest, which means the game had
	nothing to say to a player on day 12.

	Two ladders, both about days rather than hours:

	  WEEKLY CONTRACT  one currency, seven tiers, resets Monday. Points are
	                   capped per day, so the correct play is to come back
	                   tomorrow. That is not a monetisation lever — it is
	                   pacing that happens to match the platform's own
	                   60-minute daily playtime cap.

	  DESCENT LOG      one-time rewards for the number of DISTINCT days you
	                   have played, running out to 28. Back-loaded on purpose:
	                   the day-28 prize is meant to be seen on day 2.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Contracts)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Cosmetics = require(script.Parent.Cosmetics)
local Crew = require(script.Parent.Crew)
local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)

local Contracts = {}

local CREW_TICK_SECONDS = 60
local CREW_MIN_DEPTH = 40 -- standing together at spawn is not co-play

local function today(): string
	local now = os.date("!*t")
	return string.format("%d-%03d", now.year, now.yday)
end

--- Roll the weekly ladder over, and the daily point budget with it.
local function ensureContract(player: Player)
	local profile = Data.get(player)
	if not profile then
		return false
	end

	local changed = false
	local week = Config.weekKey()
	if profile.contract.week ~= week then
		profile.contract = { week = week, points = 0, dayPoints = 0, day = today(), claimed = {} }
		changed = true
	end
	if profile.contract.day ~= today() then
		profile.contract.day = today()
		profile.contract.dayPoints = 0
		changed = true
	end

	if changed then
		Data.push(player, { contract = Data.replace(table.clone(profile.contract)) })
	end
	return changed
end

--- Count today against the Descent Log if it is a day we have not seen.
local function ensureDescent(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end

	local day = today()
	if profile.descent.lastDay == day then
		return
	end

	profile.descent.lastDay = day
	profile.descent.days += 1
	Data.push(player, { descent = Data.replace(table.clone(profile.descent)) })

	local upcoming = nil
	for _, milestone in ipairs(Config.DescentLog) do
		if profile.descent.days < milestone.days then
			upcoming = milestone
			break
		end
	end

	Feedback.toast(player, {
		title = `DAY {profile.descent.days} BELOW`,
		body = upcoming and `{upcoming.days - profile.descent.days} more days to "{upcoming.label}".`
			or "You have finished the Descent Log. Respect.",
		kind = "quest",
		duration = 5,
	})
end

--- The single entry point every other system uses to feed the ladder.
function Contracts.award(player: Player, points: number, reason: string?)
	local profile = Data.get(player)
	if not profile or points <= 0 then
		return
	end
	ensureContract(player)

	local room = Config.DailyPointCap - profile.contract.dayPoints
	if room <= 0 then
		return
	end

	local granted = math.min(math.floor(points), room)
	if granted <= 0 then
		return
	end

	local before = Config.tierAt(profile.contract.points)
	profile.contract.points += granted
	profile.contract.dayPoints += granted
	local after = Config.tierAt(profile.contract.points)

	Data.push(player, {
		contract = { points = profile.contract.points, dayPoints = profile.contract.dayPoints },
	})

	if after > before then
		Feedback.effect(player, "contract", { tier = after })
		Feedback.toast(player, {
			title = `CONTRACT TIER {after}`,
			body = "Open 📜 Contract to claim it.",
			kind = "quest",
			duration = 5,
		})
	end

	-- Fires exactly on the tick that fills the budget: `granted == room` only
	-- when this award consumed the last of it. Framed as finished, not as
	-- blocked — there is no lockout, only a ceiling on this one ladder.
	if granted == room then
		Feedback.toast(player, {
			title = "TODAY'S CONTRACT WORK IS DONE",
			body = "Everything else still pays. The ladder refills at midnight UTC.",
			kind = "cash",
			duration = 6,
		})
	end
end

local function grant(player: Player, reward)
	if not reward then
		return
	end
	if reward.cash then
		Economy.addCash(player, reward.cash)
	end
	if reward.luckMinutes then
		Economy.addBuff(player, "luck", 2, reward.luckMinutes * 60)
	end
	if reward.cosmetic then
		Cosmetics.unlock(player, reward.cosmetic)
	end
	if reward.drone then
		local profile = Data.get(player)
		if profile and not profile.drones.owned[reward.drone] then
			profile.drones.owned[reward.drone] = true
			Data.push(player, { drones = Data.replace(table.clone(profile.drones)) })
		end
	end
end

function Contracts.claimTier(player: Player, index: number)
	local profile = Data.get(player)
	if not profile then
		return
	end
	ensureContract(player)

	local tier = Config.Tiers[index]
	if not tier or profile.contract.points < tier.points then
		return
	end
	if profile.contract.claimed[tostring(index)] then
		return
	end

	profile.contract.claimed[tostring(index)] = true
	grant(player, tier.reward)
	Data.push(player, { contract = Data.replace(table.clone(profile.contract)) })

	Feedback.reveal(player, {
		title = "CONTRACT TIER " .. index,
		name = Config.nameForWeek(),
		tier = index >= #Config.Tiers and "Mythic" or "Epic",
		body = `+{Format.short(tier.reward.cash or 0)}`,
		kind = "contract",
	})
end

function Contracts.claimDescent(player: Player, index: number)
	local profile = Data.get(player)
	if not profile then
		return
	end

	local milestone = Config.DescentLog[index]
	if not milestone or profile.descent.days < milestone.days then
		return
	end
	if profile.descent.claimed[tostring(index)] then
		return
	end

	profile.descent.claimed[tostring(index)] = true
	grant(player, milestone.reward)
	Data.push(player, { descent = Data.replace(table.clone(profile.descent)) })

	Feedback.reveal(player, {
		title = milestone.label,
		name = `{milestone.days} DAYS BELOW`,
		tier = "Legendary",
		body = `+{Format.short(milestone.reward.cash or 0)}`,
		kind = "descent",
	})
end

--- Crew points are paid on a timer rather than at an event, because the
--- thing being rewarded is time spent digging together.
local function crewLoop()
	while true do
		task.wait(CREW_TICK_SECONDS)
		for _, player in ipairs(Players:GetPlayers()) do
			local session = Data.session(player)
			if session and (session.depth or 0) >= CREW_MIN_DEPTH and Crew.matesNear(player) > 0 then
				Contracts.award(player, Config.Points.perCrewMinute, "crew")
				require(script.Parent.Quests).record(player, "crew_minutes", 1)
			end
		end
	end
end

function Contracts.start()
	Net.on("ClaimContract", function(player, index)
		if type(index) == "number" then
			Contracts.claimTier(player, index)
		end
	end)

	Net.on("ClaimDescent", function(player, index)
		if type(index) == "number" then
			Contracts.claimDescent(player, index)
		end
	end)

	Data.loaded:connect(function(player)
		ensureContract(player)
		task.delay(5, ensureDescent, player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		if Data.isReady(player) then
			ensureContract(player)
			ensureDescent(player)
		end
	end

	task.spawn(crewLoop)
end

return Contracts

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX49">
        <Properties>
          <string name="Name">Cosmetics</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Cosmetics.luau — status you can see on someone else.

	The 2026 spending picture is that cosmetics, status items and rarity-flex
	out-earn time-skips, and DEEP RUSH sold only time-skips. This is the
	correction.

	The single rule that makes a cosmetic worth anything: it must be visible
	to OTHER players. A skin only you can see is a screenshot; a skin the
	shaft can see is status. So all three kinds render on the character —
	the lamp lights the rock around you, the trail is what people see when
	you fall past them, and the title sits on your nameplate.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Cosmetics)
local Format = require(Shared.Format)
local Ores = require(Shared.Config.Ores)
local Mutations = require(Shared.Config.Mutations)
local Net = require(Shared.Net)
local RebirthConfig = require(Shared.Config.Rebirth)
local Ranks = require(Shared.Config.Ranks)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)

local Cosmetics = {}

local function equippedId(profile, kind: string): string
	return profile.cosmetics.equipped[kind] or Config.Defaults[kind]
end

local function applyLamp(character: Model, profile)
	local head = character:FindFirstChild("Head")
	if not head then
		return
	end

	local existing = head:FindFirstChild("DeepRushLamp")
	if existing then
		existing:Destroy()
	end

	local lamp = Instance.new("SpotLight")
	lamp.Name = "DeepRushLamp"
	lamp.Color = Config.color(equippedId(profile, "lamp"))
	lamp.Range = 42
	lamp.Angle = 75
	lamp.Brightness = 2.4
	lamp.Face = Enum.NormalId.Front
	lamp.Parent = head
end

local function applyTrail(character: Model, profile)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end

	local existing = root:FindFirstChild("DeepRushTrail")
	if existing then
		existing:Destroy()
	end

	local id = equippedId(profile, "trail")
	if id == "trail_none" then
		return
	end

	-- A Trail needs two attachments to stretch between.
	local top = root:FindFirstChild("TrailTop") or Instance.new("Attachment")
	top.Name = "TrailTop"
	top.Position = Vector3.new(0, 1.4, 0)
	top.Parent = root

	local bottom = root:FindFirstChild("TrailBottom") or Instance.new("Attachment")
	bottom.Name = "TrailBottom"
	bottom.Position = Vector3.new(0, -1.4, 0)
	bottom.Parent = root

	local color = Config.color(id)
	local trail = Instance.new("Trail")
	trail.Name = "DeepRushTrail"
	trail.Attachment0 = top
	trail.Attachment1 = bottom
	trail.Color = ColorSequence.new(color)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.15),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Lifetime = 0.7
	trail.LightEmission = 0.8
	trail.MinLength = 0
	trail.Parent = root
end

local function applyNameplate(character: Model, profile, player: Player)
	local head = character:FindFirstChild("Head")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not head or not humanoid then
		return
	end

	-- Replace Roblox's own name tag so the title and rebirth can sit with it.
	-- NameDisplayDistance specifically, NOT DisplayDistanceType: the latter
	-- would also hide the health bar, which players need while hazards are
	-- chewing on them.
	humanoid.NameDisplayDistance = 0

	local existing = head:FindFirstChild("DeepRushPlate")
	if existing then
		existing:Destroy()
	end

	local plate = Instance.new("BillboardGui")
	plate.Name = "DeepRushPlate"
	-- Taller than it looks it needs to be: the rank and best-pull lines are
	-- positioned below the plate's own box, at y = 1.0 and 1.3.
	plate.Size = UDim2.fromScale(12, 3.4)
	plate.StudsOffset = Vector3.new(0, 2.6, 0)
	plate.AlwaysOnTop = false
	plate.MaxDistance = 160
	plate.Parent = head

	local titleId = equippedId(profile, "title")
	local titleConfig = Config.ById[titleId]
	local hasTitle = titleConfig ~= nil and titleConfig.text ~= nil and titleConfig.text ~= ""

	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, 0, hasTitle and 0.55 or 1, 0)
	name.Position = UDim2.new(0, 0, hasTitle and 0.45 or 0, 0)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.Text = player.DisplayName
	name.TextColor3 = Color3.fromRGB(235, 235, 245)
	name.TextScaled = true
	name.TextStrokeTransparency = 0.4
	name.Parent = plate

	if hasTitle then
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0.45, 0)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.GothamBlack
		title.Text = titleConfig.text
		title.TextColor3 = Config.color(titleId)
		title.TextScaled = true
		title.TextStrokeTransparency = 0.35
		title.Parent = plate
	end

	local rank = Instance.new("TextLabel")
	rank.Size = UDim2.new(1, 0, 0.3, 0)
	rank.Position = UDim2.new(0, 0, 1, 0)
	rank.BackgroundTransparency = 1
	-- Rank leads the line, because it is the one thing on this plate that
	-- means the same to everyone who reads it. Rebirth and title come after.
	local rankConfig = Ranks.at(profile.stats.bankedTotal or 0)
	rank.Font = Enum.Font.GothamBold
	rank.Text = profile.rebirths > 0
		and `{rankConfig.icon} {string.upper(rankConfig.name)} · R{profile.rebirths} · {RebirthConfig.title(profile.rebirths)}`
		or `{rankConfig.icon} {string.upper(rankConfig.name)} · {RebirthConfig.title(0)}`
	rank.TextColor3 = Ranks.color(rankConfig.id)
	rank.TextScaled = true
	rank.TextStrokeTransparency = 0.5
	rank.Parent = plate

	-- The rarest thing this player has ever pulled, in that ore's own colour.
	--
	-- This is the cheapest strong idea in the game. Collection games run on
	-- players being able to see what everyone else has; without that, a rare
	-- find is a private number. With it, walking past someone wearing a
	-- 1-in-4,300,000 pull is the reason you keep digging.
	local best = profile.stats.bestPull
	if best then
		local mutationName = best.mutation and Mutations.ById[best.mutation]
		local oreName = Ores.ById[best.oreId]
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0.3, 0)
		label.Position = UDim2.new(0, 0, 1.3, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.Text = string.format(
			"◆ %s%s · %s",
			mutationName and (mutationName.name .. " ") or "",
			oreName and oreName.name or best.oreId,
			best.odds and best.odds > 0 and Format.odds(best.odds) or Format.short(best.value)
		)
		label.TextColor3 = Mutations.color(best.mutation) or Ores.color(best.tier)
		label.TextScaled = true
		label.TextStrokeTransparency = 0.4
		label.Parent = plate
	end
end

function Cosmetics.apply(player: Player)
	local profile = Data.get(player)
	local character = player.Character
	if not profile or not character then
		return
	end

	applyLamp(character, profile)
	applyTrail(character, profile)
	applyNameplate(character, profile, player)
end

function Cosmetics.unlock(player: Player, id: string)
	local profile = Data.get(player)
	local cosmetic = Config.ById[id]
	if not profile or not cosmetic or profile.cosmetics.owned[id] then
		return
	end

	profile.cosmetics.owned[id] = true
	profile.cosmetics.equipped[cosmetic.kind] = id
	Data.push(player, { cosmetics = Data.replace(table.clone(profile.cosmetics)) })
	Cosmetics.apply(player)

	Feedback.reveal(player, {
		title = "COSMETIC UNLOCKED",
		name = cosmetic.name,
		tier = "Epic",
		body = "Equipped. Everyone in the shaft can see it.",
		kind = "cosmetic",
	})
end

function Cosmetics.equip(player: Player, id: string)
	local profile = Data.get(player)
	local cosmetic = Config.ById[id]
	if not profile or not cosmetic then
		return
	end

	local isDefault = cosmetic.source == "default"
	if not isDefault and not profile.cosmetics.owned[id] then
		return
	end

	profile.cosmetics.equipped[cosmetic.kind] = id
	Data.push(player, { cosmetics = Data.replace(table.clone(profile.cosmetics)) })
	Cosmetics.apply(player)
end

function Cosmetics.buy(player: Player, id: string)
	local profile = Data.get(player)
	local cosmetic = Config.ById[id]
	if not profile or not cosmetic then
		return
	end

	if profile.cosmetics.owned[id] then
		Cosmetics.equip(player, id)
		return
	end

	if cosmetic.source ~= "shop" or not cosmetic.cost then
		Feedback.toast(player, {
			title = "NOT FOR SALE",
			body = `{cosmetic.name} is earned, not bought.`,
			kind = "error",
		})
		return
	end

	if not Economy.spend(player, cosmetic.cost) then
		Feedback.toast(player, {
			title = "NOT ENOUGH CASH",
			body = `{cosmetic.name} costs {Format.short(cosmetic.cost)}.`,
			kind = "error",
		})
		return
	end

	profile.cosmetics.owned[id] = true
	Data.push(player, { cosmetics = Data.replace(table.clone(profile.cosmetics)) })
	Cosmetics.equip(player, id)
end

function Cosmetics.start()
	Net.on("EquipCosmetic", function(player, id)
		if type(id) == "string" then
			Cosmetics.equip(player, id)
		end
	end)

	Net.on("BuyCosmetic", function(player, id)
		if type(id) == "string" then
			Cosmetics.buy(player, id)
		end
	end)

	local function hook(player: Player)
		player.CharacterAdded:Connect(function()
			task.wait(0.6)
			Cosmetics.apply(player)
		end)
		if player.Character then
			task.delay(1, Cosmetics.apply, player)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
	Players.PlayerAdded:Connect(hook)
end

return Cosmetics

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX50">
        <Properties>
          <string name="Name">Crew</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Crew.luau — the co-play layer.

	Why this exists: Roblox's Recommended For You algorithm names "7 day
	intentional co-play days per user" as one of six ranking signals. Before
	this module, DEEP RUSH scored exactly zero on it — nothing in the game was
	better with another person in it.

	Two constraints shaped the design:

	  NO TEXT. Since the January 2026 age-check rollout, a large share of
	  players cannot freely chat with each other. So the entire coordination
	  vocabulary is four pings and a proximity bonus. Nobody has to type
	  anything, and nothing breaks when two crewmates are in age brackets that
	  cannot talk.

	  NO LOBBY. The bonus is paid for standing near each other in the shaft,
	  not for being on a roster. A crew you never dig with is worth nothing,
	  which keeps the signal honest rather than farmable.

	This module deliberately depends on almost nothing (Data, World, Net,
	Feedback) because Economy asks it for the bonus, and Economy is required
	by half the server.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CrewConfig = require(Shared.Config.Crew)
local Net = require(Shared.Net)

local Data = require(script.Parent.Data)
local Feedback = require(script.Parent.Feedback)
local World = require(script.Parent.World)

local Crew = {}

local crews: { [string]: any } = {} -- id -> { id, members: {Player} }
local memberOf: { [Player]: string } = {}
local beacons: { [Player]: any } = {} -- owner -> { part, expiresAt }
local lastPing: { [Player]: number } = {}

local nextCrewId = 0

local function rootOf(player: Player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

-- Membership --------------------------------------------------------------

function Crew.of(player: Player)
	local id = memberOf[player]
	return id and crews[id] or nil
end

function Crew.size(player: Player): number
	local crew = Crew.of(player)
	return crew and #crew.members or 1
end

function Crew.isMate(a: Player, b: Player): boolean
	local crew = Crew.of(a)
	return crew ~= nil and crew == Crew.of(b)
end

--- Crew members other than `player` currently inside the bond radius. This is
--- the number the bonus is actually paid on — being on the roster from
--- across the map earns nothing.
function Crew.matesNear(player: Player): number
	local crew = Crew.of(player)
	local root = rootOf(player)
	if not crew or not root then
		return 0
	end

	local count = 0
	for _, member in ipairs(crew.members) do
		if member ~= player then
			local memberRoot = rootOf(member)
			if memberRoot and (memberRoot.Position - root.Position).Magnitude <= CrewConfig.BondRadius then
				count += 1
			end
		end
	end
	return count
end

--- Asked for by Economy on every luck and cash calculation.
function Crew.bonus(player: Player)
	local near = Crew.matesNear(player)
	if near <= 0 then
		return { cash = 0, luck = 0, near = 0 }
	end
	return {
		cash = near * CrewConfig.CashPerMember,
		luck = near * CrewConfig.LuckPerMember,
		near = near,
	}
end

local function syncCrew(crew)
	local roster = {}
	for _, member in ipairs(crew.members) do
		local session = Data.session(member)
		table.insert(roster, {
			userId = member.UserId,
			name = member.DisplayName,
			depth = session and math.floor(session.depth or 0) or 0,
		})
	end

	for _, member in ipairs(crew.members) do
		Net.to(member, "Crew", { members = roster, bonusNear = Crew.matesNear(member) })
	end
end

local function syncSolo(player: Player)
	Net.to(player, "Crew", { members = {}, bonusNear = 0 })
end

function Crew.leave(player: Player, quiet: boolean?)
	local crew = Crew.of(player)
	if not crew then
		return
	end

	memberOf[player] = nil
	local index = table.find(crew.members, player)
	if index then
		table.remove(crew.members, index)
	end

	if not quiet then
		syncSolo(player)
		for _, member in ipairs(crew.members) do
			Feedback.toast(member, {
				title = "CREW LEFT",
				body = `{player.DisplayName} surfaced.`,
				kind = "quest",
			})
		end
	end

	if #crew.members <= 1 then
		-- A crew of one is just a player. Dissolve it so the bonus and the
		-- UI both read honestly.
		for _, member in ipairs(crew.members) do
			memberOf[member] = nil
			syncSolo(member)
		end
		crews[crew.id] = nil
	else
		syncCrew(crew)
	end
end

local function joinCrew(player: Player, owner: Player)
	if player == owner then
		return
	end

	local crew = Crew.of(owner)
	if not crew then
		nextCrewId += 1
		crew = { id = "crew" .. nextCrewId, members = { owner } }
		crews[crew.id] = crew
		memberOf[owner] = crew.id
	end

	if #crew.members >= CrewConfig.MaxSize then
		Feedback.toast(player, { title = "CREW FULL", body = `Crews cap at {CrewConfig.MaxSize}.`, kind = "error" })
		return
	end

	Crew.leave(player, true)
	table.insert(crew.members, player)
	memberOf[player] = crew.id

	for _, member in ipairs(crew.members) do
		Feedback.toast(member, {
			title = "CREW " .. #crew.members .. "/" .. CrewConfig.MaxSize,
			body = `{player.DisplayName} joined. Stay close for the bonus.`,
			kind = "quest",
		})
	end
	Feedback.effect(player, "crewJoin", {})
	syncCrew(crew)
end

-- Beacons -----------------------------------------------------------------

local function clearBeacon(owner: Player)
	local beacon = beacons[owner]
	if beacon then
		if beacon.part.Parent then
			beacon.part:Destroy()
		end
		beacons[owner] = nil
	end
end

function Crew.dropBeacon(player: Player)
	local root = rootOf(player)
	if not root then
		return
	end

	clearBeacon(player)

	local part = Instance.new("Part")
	part.Name = "CrewBeacon"
	part.Size = Vector3.new(3, 14, 3)
	part.CFrame = CFrame.new(root.Position + Vector3.new(0, 5, 0))
	part.Anchored = true
	part.CanCollide = false
	part.Material = Enum.Material.Neon
	part.Color = Color3.fromRGB(110, 230, 255)
	part.Transparency = 0.25
	part:SetAttribute("CrewBeacon", player.UserId)
	part.Parent = workspace

	local light = Instance.new("PointLight")
	light.Color = part.Color
	light.Range = 40
	light.Brightness = 3
	light.Parent = part

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(12, 4)
	billboard.StudsOffset = Vector3.new(0, 9, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 300
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = `🤝 JOIN {string.upper(player.DisplayName)}`
	label.TextColor3 = Color3.fromRGB(150, 240, 255)
	label.TextScaled = true
	label.TextStrokeTransparency = 0.3
	label.Parent = billboard

	beacons[player] = { part = part, expiresAt = os.time() + CrewConfig.BeaconLifetime }

	Feedback.toast(player, {
		title = "BEACON DROPPED",
		body = `Anyone within {CrewConfig.JoinRadius} studs can join for {CrewConfig.BeaconLifetime}s.`,
		kind = "quest",
	})
end

--- Join the nearest live beacon. No menus, no invites to accept: you walk to
--- the light and press one button.
function Crew.joinNearest(player: Player)
	local root = rootOf(player)
	if not root then
		return
	end

	local best, bestDistance = nil, CrewConfig.JoinRadius
	for owner, beacon in pairs(beacons) do
		if owner ~= player and beacon.part.Parent then
			local distance = (beacon.part.Position - root.Position).Magnitude
			if distance <= bestDistance then
				best, bestDistance = owner, distance
			end
		end
	end

	if not best then
		Feedback.toast(player, {
			title = "NO BEACON NEARBY",
			body = "Drop your own so others can find you.",
			kind = "error",
		})
		return
	end

	joinCrew(player, best)
end

-- Pings -------------------------------------------------------------------

--- The whole coordination vocabulary. The POSITION comes from the server's
--- view of the character, never from the client, so a ping cannot be used to
--- draw arbitrary marks anywhere in the world.
function Crew.ping(player: Player, kind: string)
	local valid = false
	for _, pingType in ipairs(CrewConfig.PingTypes) do
		if pingType.id == kind then
			valid = true
			break
		end
	end
	if not valid then
		return
	end

	local now = os.clock()
	if now - (lastPing[player] or 0) < CrewConfig.PingCooldown then
		return
	end
	lastPing[player] = now

	local root = rootOf(player)
	if not root then
		return
	end

	local payload = {
		kind = kind,
		position = root.Position,
		from = player.DisplayName,
		lifetime = CrewConfig.PingLifetime,
	}

	local crew = Crew.of(player)
	if crew then
		for _, member in ipairs(crew.members) do
			Net.to(member, "Pings", payload)
		end
		return
	end

	-- Solo players still get to signal: anyone close by sees it. This is how
	-- a crew usually starts in the first place.
	for _, other in ipairs(Players:GetPlayers()) do
		local otherRoot = rootOf(other)
		if otherRoot and (otherRoot.Position - root.Position).Magnitude <= 200 then
			Net.to(other, "Pings", payload)
		end
	end
end

-- Lifecycle ---------------------------------------------------------------

function Crew.start()
	Net.on("CrewBeacon", function(player)
		Crew.dropBeacon(player)
	end)

	Net.on("CrewJoin", function(player)
		Crew.joinNearest(player)
	end)

	Net.on("CrewLeave", function(player)
		Crew.leave(player)
	end)

	Net.on("Ping", function(player, kind)
		if type(kind) == "string" then
			Crew.ping(player, kind)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		Crew.leave(player, true)
		clearBeacon(player)
		lastPing[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(2)

			for owner, beacon in pairs(beacons) do
				if os.time() >= beacon.expiresAt or not beacon.part.Parent then
					clearBeacon(owner)
				end
			end

			for _, crew in pairs(crews) do
				syncCrew(crew)
			end
		end
	end)
end

return Crew

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX51">
        <Properties>
          <string name="Name">Data</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Data.luau — profiles, persistence, and the one funnel that pushes state
	to clients.

	Two things here are non-negotiable in a live Roblox game and are the
	reason this module is longer than it looks like it should be:

	  SESSION LOCKING  Roblox can run the same user in two servers at once
	                   (teleports, region hops, rejoin spam). Without a lock,
	                   the older server's autosave overwrites the newer one
	                   and the player loses progress. We stamp a lock with a
	                   JobId and only steal it once it has gone stale.

	  BINDTOCLOSE      A shutdown gives you ~30 seconds. If you do not flush
	                   there, everyone who was online loses their last save.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local Data = {}

Data.loaded = Signal.new() -- fired (player) once a profile is live
Data.unloading = Signal.new() -- fired (player, profile) before the final save

local LOCK_STALE_SECONDS = 100
local LOAD_ATTEMPTS = 5

--- Opening a DataStore is not a safe call.
---
--- In Studio, on a place that has never been published or with "Enable Studio
--- Access to API Services" off, GetDataStore throws. This runs at module
--- scope, so that throw meant Data failed to load — and since almost every
--- other service requires Data, all twenty-three of them went with it. The
--- game did not start, and the reason was a save system nobody needs while
--- testing locally.
---
--- So it degrades instead. No store means profiles live in memory for this
--- session: everything is playable, nothing persists, and the server says so
--- once rather than failing.
local store = nil
if Config.UseDataStores then
	local ok, opened = pcall(function()
		return DataStoreService:GetDataStore("DeepRushProfiles_v1")
	end)
	if ok then
		store = opened
	else
		warn(
			"[DEEP RUSH] No DataStore access, so progress will not be saved this session.\n"
				.. "  This is normal in Studio before the place is published. To save while testing:\n"
				.. "  Game Settings > Security > Enable Studio Access to API Services."
		)
	end
end
local profiles: { [Player]: any } = {}
local sessions: { [Player]: any } = {}
local pendingPatches: { [Player]: any } = {}

local function template()
	return {
		version = 1,
		cash = 0,
		xp = 0,
		level = 1,
		rebirths = 0,
		upgrades = {},
		drones = { owned = {}, equipped = nil },
		codex = {},
		quests = {
			onboarding = 1, -- index into Quests.Onboarding; > #list means done
			daily = { day = "", list = {}, rerolls = 0 },
			milestones = {}, -- id -> true once claimed
			metrics = {}, -- resets daily
			alltime = {},
		},
		stats = {
			-- The rarest thing this player has ever pulled, shown to everyone
			-- who walks past them. See Cosmetics.applyNameplate.
			bestPull = nil,
			bestDepth = 0,
			bankedTotal = 0,
			bestSingleBank = 0,
			minedTotal = 0,
			steals = 0,
			deaths = 0,
			playtime = 0,
			cleanBanks = 0,
		},
		rewards = { lastLogin = "", streak = 0, chests = 0 },

		-- The rules card shows once per account, not once per session.
		seenIntro = false,

		-- Weekly ladder. dayPoints enforces the daily cap that pushes play
		-- DAYS rather than long single sessions.
		contract = { week = "", points = 0, dayPoints = 0, day = "", claimed = {} },

		-- Distinct days played, which is the metric the 28-day discovery
		-- window actually grades.
		descent = { days = 0, lastDay = "", claimed = {} },

		cosmetics = { owned = {}, equipped = {} },

		-- Live-window progress. The badge itself lives in cosmetics and
		-- survives the season; only the counter here resets.
		season = { number = 0, cores = 0, badge = false },
		deals = { day = "", bought = {} },
		purchases = {},
		createdAt = os.time(),
		lastSeen = os.time(),
	}
end

--- A fresh per-session scratchpad. Nothing here is ever saved.
local function newSession()
	return {
		cargo = { items = {}, value = 0 },
		depth = 0,
		joinedAt = os.clock(),
		mining = nil,
		oxygen = Config.BaseOxygen,
		buffs = {}, -- { kind, multiplier, expires }
		gamepasses = {},
		lastSnatch = 0,
		lastBank = 0,
		lastPosition = nil,
		riftMined = 0,
	}
end

--- Fill in fields added by a later version of the game without clobbering
--- anything the player already has.
local function reconcile(saved, defaults)
	for key, value in pairs(defaults) do
		if saved[key] == nil then
			saved[key] = if type(value) == "table" then table.clone(value) else value
		elseif type(value) == "table" and type(saved[key]) == "table" then
			reconcile(saved[key], value)
		end
	end
	return saved
end

local function key(userId: number): string
	return "player_" .. userId
end

-- Loading ------------------------------------------------------------------

local function tryLoad(userId: number)
	local jobId = game.JobId ~= "" and game.JobId or "studio"

	local loaded, err = pcall(function()
		return store:UpdateAsync(key(userId), function(existing)
			local now = os.time()

			if existing and existing.lock then
				local age = now - (existing.lock.at or 0)
				local mine = existing.lock.jobId == jobId
				if not mine and age < LOCK_STALE_SECONDS then
					-- Someone else holds a live lock. Abort and retry.
					return nil
				end
			end

			local payload = existing and existing.data or template()
			return {
				lock = { jobId = jobId, at = now },
				data = payload,
			}
		end)
	end)

	if not loaded then
		return nil, tostring(err)
	end
	return loaded
end

local function loadProfile(player: Player)
	if not store then
		return template()
	end

	for attempt = 1, LOAD_ATTEMPTS do
		local result, err = tryLoad(player.UserId)
		if result and result.data then
			return reconcile(result.data, template())
		end
		if err then
			warn(`DeepRush: load attempt {attempt} failed for {player.Name}: {err}`)
		end
		-- Back off: a held lock usually clears within a few seconds.
		task.wait(2 ^ attempt)
		if not player.Parent then
			return nil
		end
	end

	return nil
end

local function saveProfile(player: Player, release: boolean)
	local profile = profiles[player]
	if not profile or not store then
		return
	end

	profile.lastSeen = os.time()
	local session = sessions[player]
	if session then
		profile.stats.playtime += math.floor(os.clock() - session.joinedAt)
		session.joinedAt = os.clock()
	end

	local jobId = game.JobId ~= "" and game.JobId or "studio"
	local ok, err = pcall(function()
		store:UpdateAsync(key(player.UserId), function(existing)
			-- Refuse to write over a server that legitimately took the lock
			-- from us; our copy is the stale one in that case.
			if existing and existing.lock and existing.lock.jobId ~= jobId then
				local age = os.time() - (existing.lock.at or 0)
				if age < LOCK_STALE_SECONDS then
					return nil
				end
			end
			return {
				lock = if release then nil else { jobId = jobId, at = os.time() },
				data = profile,
			}
		end)
	end)

	if not ok then
		warn(`DeepRush: save failed for {player.Name}: {err}`)
	end
end

-- Public API ---------------------------------------------------------------

function Data.get(player: Player)
	return profiles[player]
end

function Data.session(player: Player)
	return sessions[player]
end

function Data.isReady(player: Player): boolean
	return profiles[player] ~= nil
end

--- Merge a patch into the outgoing queue. Patches are coalesced and flushed
--- on a timer so a burst of mining does not become a burst of replication.
function Data.push(player: Player, patch)
	if not patch then
		return
	end
	local queued = pendingPatches[player]
	if not queued then
		pendingPatches[player] = patch
		return
	end

	local function merge(target, source)
		for k, v in pairs(source) do
			if type(v) == "table" and type(target[k]) == "table" and not v.__replace then
				merge(target[k], v)
			else
				target[k] = v
			end
		end
	end
	merge(queued, patch)
end

--- Mark a table so the client replaces rather than merges it. Needed for
--- lists (daily quests, cargo contents) where a merge would leave orphans.
function Data.replace(value)
	value.__replace = true
	return value
end

--- The full snapshot a joining client needs. Session-only fields are folded
--- in so the client has one shape to reason about.
function Data.snapshot(player: Player)
	local profile = profiles[player]
	local session = sessions[player]
	if not profile or not session then
		return nil
	end

	return {
		cash = profile.cash,
		xp = profile.xp,
		level = profile.level,
		rebirths = profile.rebirths,
		upgrades = profile.upgrades,
		drones = profile.drones,
		codex = profile.codex,
		quests = profile.quests,
		stats = profile.stats,
		rewards = profile.rewards,
		seenIntro = profile.seenIntro,
		contract = profile.contract,
		descent = profile.descent,
		cosmetics = profile.cosmetics,
		season = profile.season,
		deals = profile.deals,
		cargo = { count = #session.cargo.items, value = session.cargo.value },
		depth = session.depth,
		oxygen = session.oxygen,
		buffs = session.buffs,
		gamepasses = session.gamepasses,
	}
end

function Data.start()
	Net.handle("GetState", function(player)
		-- A client can invoke before its profile finished loading.
		for _ = 1, 40 do
			if profiles[player] then
				return Data.snapshot(player)
			end
			task.wait(0.25)
		end
		return nil
	end)

	local function onPlayerAdded(player: Player)
		local profile = loadProfile(player)
		if not profile then
			player:Kick("Could not load your save. Please rejoin — your progress is safe.")
			return
		end
		if not player.Parent then
			return
		end

		profiles[player] = profile
		sessions[player] = newSession()
		Data.loaded:fire(player)
		Net.to(player, "State", Data.snapshot(player))
	end

	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)

	Players.PlayerRemoving:Connect(function(player)
		if profiles[player] then
			Data.unloading:fire(player, profiles[player])
			saveProfile(player, true)
		end
		profiles[player] = nil
		sessions[player] = nil
		pendingPatches[player] = nil
	end)

	-- Patch flush loop.
	task.spawn(function()
		while true do
			task.wait(Config.StateSyncRate)
			for player, patch in pairs(pendingPatches) do
				if player.Parent then
					Net.to(player, "State", patch)
				end
				pendingPatches[player] = nil
			end
		end
	end)

	-- Autosave loop, staggered so 40 players do not all write at once.
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			for _, player in ipairs(Players:GetPlayers()) do
				if profiles[player] then
					task.spawn(saveProfile, player, false)
					task.wait(0.4)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		local pending = 0
		for player in pairs(profiles) do
			pending += 1
			task.spawn(function()
				saveProfile(player, true)
				pending -= 1
			end)
		end
		-- Shutdown gives us roughly 30s; spend what we need and no more.
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.2)
		end
	end)
end

return Data

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX52">
        <Properties>
          <string name="Name">Drones</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Drones.luau — ownership, equipping, and the little thing that follows you.

	The visual matters more than the stats. A drone bobbing next to your head
	is the cheapest possible way to make a player feel like they have a
	loadout, and it is what other players see when they look at you.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local DroneConfig = require(Shared.Config.Drones)
local Ores = require(Shared.Config.Ores)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)

local Drones = {}

local models: { [Player]: BasePart } = {}

local function destroyModel(player: Player)
	local model = models[player]
	if model then
		model:Destroy()
		models[player] = nil
	end
end

local function buildModel(player: Player)
	destroyModel(player)

	local profile = Data.get(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not profile or not root or not profile.drones.equipped then
		return
	end

	local drone = DroneConfig.ById[profile.drones.equipped]
	if not drone then
		return
	end

	local part = Instance.new("Part")
	part.Name = "Drone"
	part.Size = Vector3.new(1.6, 1.6, 1.6)
	part.Shape = Enum.PartType.Ball
	part.Material = Enum.Material.Neon
	part.Color = Ores.color(drone.rarity)
	part.CanCollide = false
	part.Massless = true
	part.CFrame = root.CFrame * CFrame.new(2.6, 2.4, 1)

	-- AlignPosition on a floating attachment gives the lazy trailing bob for
	-- free; hand-animating it would cost a heartbeat connection per player.
	local droneAttachment = Instance.new("Attachment")
	droneAttachment.Parent = part

	-- The root outlives the drone model, so a re-equip would otherwise leave
	-- its old target attachment behind and stack one per swap.
	local existing = root:FindFirstChild("DroneTarget")
	if existing then
		existing:Destroy()
	end

	local targetAttachment = Instance.new("Attachment")
	targetAttachment.Name = "DroneTarget"
	targetAttachment.Position = Vector3.new(2.6, 2.4, 1)
	targetAttachment.Parent = root

	local align = Instance.new("AlignPosition")
	align.Attachment0 = droneAttachment
	align.Attachment1 = targetAttachment
	align.MaxForce = 45000
	align.Responsiveness = 12
	align.Parent = part

	local light = Instance.new("PointLight")
	light.Color = part.Color
	light.Range = 16
	light.Brightness = 1.6
	light.Parent = part

	part.Parent = workspace
	models[player] = part
end

function Drones.equip(player: Player, droneId: string)
	local profile = Data.get(player)
	if not profile or not profile.drones.owned[droneId] then
		return
	end

	profile.drones.equipped = droneId
	Data.push(player, { drones = Data.replace(table.clone(profile.drones)) })
	buildModel(player)

	local drone = DroneConfig.ById[droneId]
	Feedback.toast(player, { title = "EQUIPPED", body = drone and drone.name or droneId, kind = "upgrade" })
end

function Drones.buy(player: Player, droneId: string)
	local profile = Data.get(player)
	local drone = DroneConfig.ById[droneId]
	if not profile or not drone then
		return
	end

	if profile.drones.owned[droneId] then
		Drones.equip(player, droneId)
		return
	end

	if not drone.cost then
		Feedback.toast(player, {
			title = "NOT FOR SALE",
			body = `{drone.name} only turns up below {Format.depth(drone.findDepth or 0)}.`,
			kind = "error",
		})
		return
	end

	if not Economy.spend(player, drone.cost) then
		Feedback.toast(player, {
			title = "NOT ENOUGH CASH",
			body = `{drone.name} costs {Format.short(drone.cost)}.`,
			kind = "error",
		})
		return
	end

	profile.drones.owned[droneId] = true
	Data.push(player, { drones = Data.replace(table.clone(profile.drones)) })
	Drones.equip(player, droneId)
end

function Drones.start()
	Net.on("BuyDrone", function(player, droneId)
		if type(droneId) == "string" then
			Drones.buy(player, droneId)
		end
	end)

	Net.on("EquipDrone", function(player, droneId)
		if type(droneId) == "string" then
			Drones.equip(player, droneId)
		end
	end)

	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.5)
			buildModel(player)
		end)
	end)

	Players.PlayerRemoving:Connect(destroyModel)
end

return Drones

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX53">
        <Properties>
          <string name="Name">Economy</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Economy.luau — the single place that answers "how good is this player?"

	Luck, cash multiplier, capacity and oxygen all come from four stacking
	sources: upgrades, rebirths, the equipped drone, and temporary buffs
	(potions, gamepasses, rift). Every other service asks this module rather
	than adding up bonuses itself, which is what keeps a "+2x luck" pass from
	silently missing one of the six places luck is used.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local UpgradeConfig = require(Shared.Config.Upgrades)
local RebirthConfig = require(Shared.Config.Rebirth)
local DroneConfig = require(Shared.Config.Drones)
local ProductConfig = require(Shared.Config.Products)

local Crew = require(script.Parent.Crew)
local Data = require(script.Parent.Data)
local Feedback = require(script.Parent.Feedback)

local Economy = {}

--- Drop expired buffs. Called by every getter, so buffs never linger.
local function activeBuffs(player: Player)
	local session = Data.session(player)
	if not session then
		return {}
	end

	local now = os.time()
	local kept = {}
	local changed = false
	for _, buff in ipairs(session.buffs) do
		if buff.expires > now then
			table.insert(kept, buff)
		else
			changed = true
		end
	end

	if changed then
		session.buffs = kept
		Data.push(player, { buffs = Data.replace(table.clone(kept)) })
	end
	return kept
end

local function gamepassBonus(player: Player, field: string, default: number): number
	local session = Data.session(player)
	if not session then
		return default
	end

	local total = default
	for passId, owned in pairs(session.gamepasses) do
		if owned then
			local pass = ProductConfig.GamepassById[passId]
			local value = pass and pass.apply[field]
			if value then
				if field == "capacity" then
					total += value
				else
					total *= value
				end
			end
		end
	end
	return total
end

function Economy.addBuff(player: Player, kind: string, multiplier: number, seconds: number)
	local session = Data.session(player)
	if not session then
		return
	end
	table.insert(session.buffs, { kind = kind, multiplier = multiplier, expires = os.time() + seconds })
	Data.push(player, { buffs = Data.replace(table.clone(session.buffs)) })
end

function Economy.hasGamepass(player: Player, passId: string): boolean
	local session = Data.session(player)
	return session ~= nil and session.gamepasses[passId] == true
end

--- Total luck, capped. Cap exists because the tier table is exponential in
--- luck — uncapped, a stacked buff turns Singularity into a coin flip.
function Economy.luck(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return 1
	end

	local luck = 1
	luck += UpgradeConfig.value("charm", profile.upgrades.charm or 0)
	luck += RebirthConfig.bonuses(profile.rebirths).luck
	luck += DroneConfig.bonusesOf(profile.drones.equipped).luck

	-- Paid for digging within bond range of a crewmate, not for being on a
	-- roster. See Server/Crew.luau.
	luck += Crew.bonus(player).luck

	luck *= gamepassBonus(player, "luckMultiplier", 1)

	for _, buff in ipairs(activeBuffs(player)) do
		if buff.kind == "luck" then
			luck *= buff.multiplier
		end
	end

	return math.clamp(luck, 1, Config.MaxLuck)
end

function Economy.cashMultiplier(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return 1
	end

	local multiplier = RebirthConfig.bonuses(profile.rebirths).cashMultiplier
	multiplier *= 1 + DroneConfig.bonusesOf(profile.drones.equipped).cash
	multiplier *= 1 + Crew.bonus(player).cash
	multiplier *= gamepassBonus(player, "cashMultiplier", 1)

	for _, buff in ipairs(activeBuffs(player)) do
		if buff.kind == "cash" then
			multiplier *= buff.multiplier
		end
	end

	return multiplier
end

function Economy.capacity(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return Config.BaseCapacity
	end

	local capacity = Config.BaseCapacity
	capacity += UpgradeConfig.value("backpack", profile.upgrades.backpack or 0)
	capacity += RebirthConfig.bonuses(profile.rebirths).capacity
	capacity += gamepassBonus(player, "capacity", 0)
	return math.floor(capacity)
end

function Economy.maxOxygen(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return Config.BaseOxygen
	end

	local oxygen = Config.BaseOxygen
	oxygen += UpgradeConfig.value("oxygen", profile.upgrades.oxygen or 0)
	oxygen += RebirthConfig.bonuses(profile.rebirths).oxygen
	oxygen += DroneConfig.bonusesOf(profile.drones.equipped).oxygen

	for _, buff in ipairs(activeBuffs(player)) do
		if buff.kind == "oxygen" then
			oxygen *= buff.multiplier
		end
	end

	return oxygen
end

function Economy.mineTime(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return Config.BaseMineTime
	end
	local reduction = UpgradeConfig.value("drill", profile.upgrades.drill or 0)
	return math.max(Config.MinMineTime, Config.BaseMineTime * (1 - reduction))
end

function Economy.walkSpeed(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return 16
	end
	return 16 + UpgradeConfig.value("boots", profile.upgrades.boots or 0)
end

function Economy.hazardResist(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return 0
	end
	return math.min(DroneConfig.bonusesOf(profile.drones.equipped).hazardResist, 0.8)
end

function Economy.protectedShare(player: Player): number
	local profile = Data.get(player)
	if not profile then
		return 0
	end
	return UpgradeConfig.value("pocket", profile.upgrades.pocket or 0)
end

-- Cash and levels ----------------------------------------------------------

function Economy.xpToLevel(level: number): number
	return math.floor(Config.BaseXpToLevel * (Config.LevelCurve ^ (level - 1)))
end

function Economy.addCash(player: Player, amount: number)
	local profile = Data.get(player)
	if not profile or amount == 0 then
		return
	end

	profile.cash = math.max(0, profile.cash + amount)

	local patch = { cash = profile.cash }
	if amount > 0 then
		profile.xp += amount * Config.XpPerCashUnit
		local leveled = false
		while profile.xp >= Economy.xpToLevel(profile.level) do
			profile.xp -= Economy.xpToLevel(profile.level)
			profile.level += 1
			leveled = true
		end
		patch.xp = profile.xp
		patch.level = profile.level
		if leveled then
			Feedback.toast(player, {
				title = "LEVEL " .. profile.level,
				body = "Deeper strata, better nodes.",
				kind = "level",
			})
		end
	end

	Data.push(player, patch)
end

function Economy.spend(player: Player, amount: number): boolean
	local profile = Data.get(player)
	if not profile or profile.cash < amount then
		return false
	end
	profile.cash -= amount
	Data.push(player, { cash = profile.cash })
	return true
end

--- Push walkspeed onto the character. Called after upgrades and on spawn.
function Economy.applyCharacter(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = Economy.walkSpeed(player)
	end
end

function Economy.start()
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			task.wait(0.2)
			Economy.applyCharacter(player)
		end)
	end)
end

return Economy

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX54">
        <Properties>
          <string name="Name">Feedback</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Feedback.luau — the game's voice.

	Split out from the systems that trigger it so that "what happened" and
	"how loud it feels" stay separate. Tuning game feel then means editing
	one file instead of nineteen.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local Feedback = {}

--- Corner notification. `kind` drives colour and sound on the client.
function Feedback.toast(player: Player, payload)
	Net.to(player, "Toast", payload)
end

function Feedback.broadcast(payload)
	Net.all("Toast", payload)
end

--- The full-screen card for a rare pull. Reserved for Epic+ so it keeps
--- meaning something; below that, the ore just pops off the rock.
function Feedback.reveal(player: Player, payload)
	Net.to(player, "Reveal", payload)
end

--- One-shot client effect: screen shake, a sound, a burst of particles.
function Feedback.effect(player: Player, kind: string, payload)
	Net.to(player, "Effect", kind, payload)
end

function Feedback.effectAll(kind: string, payload)
	Net.all("Effect", kind, payload)
end

--- Server-wide announcement for a Mythic+ pull or a rift. These are the
--- moments that make a full server look at the same thing at once, which is
--- most of what "social" means in a mining game.
function Feedback.announce(title: string, body: string, color)
	Net.all("Toast", {
		title = title,
		body = body,
		kind = "announce",
		color = color,
		duration = 6,
	})
end

return Feedback

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX55">
        <Properties>
          <string name="Name">Hazards</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Hazards.luau — oxygen, and standing in the wrong place.

	Two pressures, and they work differently on purpose:

	  OXYGEN  a soft timer that scales with the layer. It never kills you
	          outright at first, it chews health, which is your cue to run for
	          a lift. This is the cost of depth itself.

	  ZONES   damage for being somewhere specific. Every hazard is a visible
	          object placed by Server/World.luau — a gas cloud, a magma vent,
	          a frost field — and this module only asks "is the player inside
	          one, and is it armed right now".

	The zone rewrite replaced a per-second dice roll that hurt you from
	nowhere. The old version was technically fair (it telegraphed) and felt
	arbitrary, because danger had no location: you could not look at a room
	and know where not to stand. Now you can, and every hit traces back to
	something the player could see.

	World owns the zones and their timing; this owns the consequences. Neither
	requires the other, which is what keeps World out of the Economy cycle.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local HazardConfig = require(Shared.Config.Hazards)
local Layers = require(Shared.Config.Layers)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)
local World = require(script.Parent.World)

local Hazards = {}

local SURFACE_DEPTH = 15 -- above this, you are breathing normally
local SUFFOCATION_DPS = 6
local SCAN_RADIUS = 30 -- studs; bigger than the largest zone
local BURST_DEBOUNCE = 1.6 -- one pulsing zone cannot hit twice inside this

-- player -> { [zone] = timestamp } of the last burst that landed.
local lastBurst: { [Player]: { [Instance]: number } } = {}
-- player -> zone they are currently inside, for enter/leave messaging.
local inside: { [Player]: Instance? } = {}
-- players whose walkspeed we have modified, so we can hand it back.
local slowed: { [Player]: boolean } = {}

local function humanoidOf(player: Player)
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function rootOf(player: Player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

--- The armed zone the player is standing in, if any.
local function zoneAt(player: Player)
	local root = rootOf(player)
	if not root then
		return nil, nil
	end

	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, SCAN_RADIUS)) do
		local kindId = part:GetAttribute("HazardZone")
		if kindId then
			local radius = part:GetAttribute("HazardRadius") or 12
			local height = part:GetAttribute("HazardHeight") or 12
			local offset = root.Position - part.Position
			local horizontal = Vector2.new(offset.X, offset.Z).Magnitude
			if horizontal <= radius and math.abs(offset.Y) <= height / 2 then
				return part, HazardConfig.Kinds[kindId]
			end
		end
	end

	return nil, nil
end

local function restoreSpeed(player: Player)
	if slowed[player] then
		slowed[player] = nil
		Economy.applyCharacter(player)
	end
end

local function applyZone(player: Player, zone: Instance?, kind, delta: number)
	local humanoid = humanoidOf(player)
	if not humanoid or humanoid.Health <= 0 then
		return
	end

	local previous = inside[player]
	inside[player] = zone

	if zone == nil then
		if previous then
			restoreSpeed(player)
		end
		return
	end

	-- Entering is announced once, with the hint that tells you the counter.
	if previous ~= zone then
		Feedback.effect(player, "hazardWarn", { kind = kind.name, text = kind.hint })
		Feedback.toast(player, {
			title = `{kind.icon} {kind.name}`,
			body = kind.hint,
			kind = "error",
			duration = 4,
		})
	end

	local resist = 1 - Economy.hazardResist(player)

	if kind.slow then
		slowed[player] = true
		humanoid.WalkSpeed = Economy.walkSpeed(player) * kind.slow
	end

	if not zone:GetAttribute("Armed") then
		return
	end

	if kind.mode == "persistent" then
		humanoid:TakeDamage(kind.dps * delta * resist)
		Feedback.effect(player, "hazardTick", { kind = kind.name })
		return
	end

	-- Pulsing: one burst is one hit, however long the window lasts.
	local record = lastBurst[player]
	if not record then
		record = {}
		lastBurst[player] = record
	end

	local now = os.clock()
	if now - (record[zone] or 0) < BURST_DEBOUNCE then
		return
	end
	record[zone] = now

	humanoid:TakeDamage(kind.burst * resist)
	Feedback.effect(player, "hazardHit", { kind = kind.name, text = kind.name, damage = kind.burst })
end

local function tick(delta: number)
	for _, player in ipairs(Players:GetPlayers()) do
		local session = Data.session(player)
		local humanoid = humanoidOf(player)

		if not session or not humanoid or humanoid.Health <= 0 then
			inside[player] = nil
			continue
		end

		-- Measured here rather than read from session.depth, which another
		-- loop maintains at a different rate. Reading it meant a player who
		-- had just surfaced kept suffocating for a tick or two on a stale
		-- number — invisible in play, and the sort of ordering bug that only
		-- ever gets worse.
		local root = rootOf(player)
		local depth = root and World.depthOf(root.Position) or 0
		local layer = Layers.at(depth)
		local maxOxygen = Economy.maxOxygen(player)

		if depth <= SURFACE_DEPTH then
			session.oxygen = math.min(maxOxygen, (session.oxygen or maxOxygen) + Config.OxygenRegenRate * delta)
		else
			session.oxygen = (session.oxygen or maxOxygen) - layer.oxygenDrain * delta
			if session.oxygen <= 0 then
				session.oxygen = 0
				humanoid:TakeDamage(SUFFOCATION_DPS * delta * (1 - Economy.hazardResist(player)))
				Feedback.effect(player, "suffocating", {})
			end
		end

		-- The tick is fast so zones feel responsive; the oxygen bar does not
		-- need that rate, so it is replicated about once a second.
		session.oxygenPushed = (session.oxygenPushed or 0) + delta
		if session.oxygenPushed >= 1 then
			session.oxygenPushed = 0
			Data.push(player, { oxygen = session.oxygen, oxygenMax = maxOxygen })
		end

		local zone, kind = zoneAt(player)
		applyZone(player, zone, kind, delta)
	end
end

function Hazards.start()
	Players.PlayerRemoving:Connect(function(player)
		lastBurst[player] = nil
		inside[player] = nil
		slowed[player] = nil
	end)

	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(Config.HazardTickRate)
			local now = os.clock()
			local delta = now - last
			last = now
			tick(delta)
		end
	end)
end

return Hazards

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX56">
        <Properties>
          <string name="Name">Leaderboards</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Leaderboards.luau — global boards, rendered on a wall at the surface.

	OrderedDataStore is the only Roblox store that can answer "top 10", and
	it only holds integers, so each board is its own store. Writes are
	throttled to record-beating events; unconditional writes on every bank
	would blow the DataStore budget on a busy server.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local Ranks = require(Shared.Config.Ranks)

local Data = require(script.Parent.Data)

local Leaderboards = {}

-- Same story as Data: GetOrderedDataStore throws in Studio without API
-- access, at module scope, and takes the whole service down with it. Without
-- them the global boards are empty; the live server board does not use them
-- at all and works either way.
local function openBoard(name: string)
	if not Config.UseDataStores then
		return nil
	end
	local ok, opened = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	return ok and opened or nil
end

local depthStore = openBoard("DeepRushDepth_v1")
local cashStore = openBoard("DeepRushBanked_v1")

local cache = { depth = {}, banked = {}, fetchedAt = 0 }
local lastWrite: { [number]: { depth: number, banked: number } } = {}

--- What each player has banked since joining THIS server.
---
--- The global boards are all-time and they move once a week; on a Tuesday
--- evening nobody on the server is on them and nobody ever will be. This one
--- resets when the server does, so the person standing next to you is on it,
--- and beating them is a thing you can do in the next twenty minutes. That is
--- the board players actually race.
local live: { [number]: number } = {}

local function nameFor(userId: number): string
	local player = Players:GetPlayerByUserId(userId)
	if player then
		return player.DisplayName
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	return ok and name or ("User " .. userId)
end

local function readBoard(store)
	if not store then
		return {}
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 10)
	end)
	if not ok then
		return {}
	end

	local rows = {}
	for rank, entry in ipairs(pages:GetCurrentPage()) do
		table.insert(rows, {
			rank = rank,
			userId = tonumber(entry.key) or 0,
			name = nameFor(tonumber(entry.key) or 0),
			value = entry.value,
		})
	end
	return rows
end

local function refresh()
	cache.depth = readBoard(depthStore)
	cache.banked = readBoard(cashStore)
	cache.fetchedAt = os.time()
end

--- Called after a successful deposit. Only writes when the player actually
--- beat their own recorded value.
function Leaderboards.submit(player: Player, payout: number)
	live[player.UserId] = (live[player.UserId] or 0) + math.max(payout or 0, 0)

	local profile = Data.get(player)
	-- Guarded on the stores themselves, not on the config flag: the flag can
	-- be true while the stores never opened.
	if not profile or not depthStore or not cashStore then
		return
	end

	local previous = lastWrite[player.UserId] or { depth = 0, banked = 0 }
	local depth = math.floor(profile.stats.bestDepth)
	local banked = math.floor(math.min(profile.stats.bankedTotal, 9e15))

	if depth > previous.depth then
		previous.depth = depth
		pcall(function()
			depthStore:SetAsync(tostring(player.UserId), depth)
		end)
	end

	-- Banked total only re-writes once it has moved by a visible margin.
	if banked > previous.banked * 1.05 + 1000 then
		previous.banked = banked
		pcall(function()
			cashStore:SetAsync(tostring(player.UserId), banked)
		end)
	end

	lastWrite[player.UserId] = previous
end

local function buildWall(name: string, cframe: CFrame, heading: string, headingColor: Color3)
	local anchor = Instance.new("Part")
	anchor.Name = name
	anchor.Size = Vector3.new(40, 24, 2)
	anchor.CFrame = cframe
	anchor.Anchored = true
	anchor.Color = Color3.fromRGB(24, 24, 30)
	anchor.Material = Enum.Material.Metal
	anchor.Parent = workspace:FindFirstChild("DeepRushWorld") or workspace

	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.CanvasSize = Vector2.new(800, 480)
	gui.LightInfluence = 0
	gui.Parent = anchor

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Color3.fromRGB(14, 14, 20)
	frame.Parent = gui

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 70)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.GothamBlack
	title.Text = heading
	title.TextColor3 = headingColor
	title.TextScaled = true
	title.Parent = frame

	local list = Instance.new("Frame")
	list.Name = "Rows"
	list.Position = UDim2.new(0, 20, 0, 80)
	list.Size = UDim2.new(1, -40, 1, -100)
	list.BackgroundTransparency = 1
	list.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.Parent = list

	return list
end

local function liveRows()
	local rows = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = Data.get(player)
		table.insert(rows, {
			userId = player.UserId,
			name = player.DisplayName,
			value = live[player.UserId] or 0,
			rank = 0,
			badge = Ranks.label(profile and profile.stats.bankedTotal or 0),
			rankId = Ranks.at(profile and profile.stats.bankedTotal or 0).id,
		})
	end
	table.sort(rows, function(a, b)
		if a.value == b.value then
			return a.name < b.name
		end
		return a.value > b.value
	end)
	for index, row in ipairs(rows) do
		row.rank = index
	end
	return rows
end

local function renderLive(list: Frame)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	for index, row in ipairs(liveRows()) do
		if index > 10 then
			break
		end
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 34)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Text = string.format("%d.  %s %s  —  %s", row.rank, row.badge, row.name, Format.short(row.value))
		label.TextColor3 = index == 1 and Color3.fromRGB(255, 210, 90) or Ranks.color(row.rankId)
		label.TextScaled = true
		label.Parent = list
	end
end

local function renderBoard(list: Frame)
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end

	if #cache.depth == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, 0, 0, 40)
		empty.BackgroundTransparency = 1
		empty.Font = Enum.Font.GothamMedium
		empty.Text = "No records yet. Be the first."
		empty.TextColor3 = Color3.fromRGB(140, 140, 160)
		empty.TextScaled = true
		empty.Parent = list
		return
	end

	for _, row in ipairs(cache.depth) do
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0, 34)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Text = string.format("%d.  %s  —  %s", row.rank, row.name, Format.depth(row.value))
		label.TextColor3 = row.rank == 1 and Color3.fromRGB(255, 210, 90) or Color3.fromRGB(225, 225, 235)
		label.TextScaled = true
		label.Parent = list
	end
end

--- The in-game player list. Players read this constantly and it costs us
--- almost nothing, so both headline numbers go there.
local function setupLeaderstats(player: Player)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"

	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "0"
	cash.Parent = stats

	local depth = Instance.new("StringValue")
	depth.Name = "Depth"
	depth.Value = "0m"
	depth.Parent = stats

	local rank = Instance.new("StringValue")
	rank.Name = "Rank"
	rank.Value = Ranks.label(0)
	rank.Parent = stats

	stats.Parent = player

	task.spawn(function()
		while player.Parent do
			local profile = Data.get(player)
			local session = Data.session(player)
			if profile then
				cash.Value = Format.short(profile.cash)
				depth.Value = Format.depth(session and session.depth or 0)
				rank.Value = Ranks.label(profile.stats.bankedTotal or 0)
			end
			task.wait(3)
		end
	end)
end

function Leaderboards.start()
	for _, player in ipairs(Players:GetPlayers()) do
		setupLeaderstats(player)
	end
	Players.PlayerAdded:Connect(setupLeaderstats)

	Net.handle("GetBoards", function()
		return { depth = cache.depth, banked = cache.banked, server = liveRows() }
	end)

	task.spawn(function()
		-- The world builds first; give it a beat before parenting to it.
		task.wait(2)
		local global = buildWall(
			"LeaderboardWall",
			CFrame.new(-52, 12, 76) * CFrame.Angles(0, math.rad(-35), 0),
			"DEEPEST DIVES",
			Color3.fromRGB(120, 220, 255)
		)
		local server = buildWall(
			"LiveBoardWall",
			CFrame.new(52, 12, 76) * CFrame.Angles(0, math.rad(35), 0),
			"THIS SERVER · TODAY",
			Color3.fromRGB(255, 205, 90)
		)

		-- The live board refreshes far faster than the global one, and costs
		-- nothing to: it reads players who are already in memory, while the
		-- global board is a DataStore call on a budget.
		local sinceGlobal = math.huge
		while true do
			if sinceGlobal >= Config.LeaderboardRefresh then
				refresh()
				renderBoard(global)
				sinceGlobal = 0
			end
			renderLive(server)
			task.wait(3)
			sinceGlobal += 3
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		lastWrite[player.UserId] = nil
		live[player.UserId] = nil
	end)
end

return Leaderboards

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX57">
        <Properties>
          <string name="Name">Mining</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Mining.luau — the swing, the roll, and the moment the number pops.

	Server-authoritative by construction: the client asks to start mining a
	node id, the server decides how long that takes, checks every 100ms that
	the player is still in range and alive, and only then rolls the ore. A
	client that spams Mine gets rate-limited by Net; a client that lies about
	its position gets caught by the range check here and by AntiCheat.

	Value is stored PRE-multiplier in cargo. The cash multiplier is applied
	at the vault, so the deposit screen can show "x3.5" as a visible reward
	rather than silently inflating every rock.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local Layers = require(Shared.Config.Layers)
local Ores = require(Shared.Config.Ores)
local Mutations = require(Shared.Config.Mutations)
local DroneConfig = require(Shared.Config.Drones)
local Rarity = require(Shared.Rarity)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Cargo = require(script.Parent.Cargo)
local Contracts = require(script.Parent.Contracts)
local ContractConfig = require(Shared.Config.Contracts)
local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)
local Quests = require(script.Parent.Quests)
local Rift = require(script.Parent.Rift)
local Season = require(script.Parent.Season)
local SeasonConfig = require(Shared.Config.Season)
local World = require(script.Parent.World)

local Mining = {}

local REVEAL_FROM_TIER = 4 -- Epic and up get the full-screen card
local ANNOUNCE_FROM_TIER = 6 -- Mythic and up wake the whole server
local RANGE_SLACK = 6 -- studs of forgiveness for latency

local rng = Random.new(os.time() + 4242)

local function rootOf(player: Player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function isAlive(player: Player): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	return humanoid ~= nil and humanoid.Health > 0
end

local function inRange(player: Player, node): boolean
	local root = rootOf(player)
	if not root then
		return false
	end
	return (root.Position - node.part.Position).Magnitude <= Config.MineReach + RANGE_SLACK
end

--- Drones are found, not farmed. This is the only place they drop.
local function rollDroneDrop(player: Player, depth: number, luck: number)
	local profile = Data.get(player)
	if not profile then
		return
	end

	if rng:NextNumber() > DroneConfig.dropChance(depth, luck) then
		return
	end

	local candidates = DroneConfig.droppableAt(depth)
	for _, drone in ipairs(candidates) do
		if not profile.drones.owned[drone.id] then
			profile.drones.owned[drone.id] = true
			if not profile.drones.equipped then
				profile.drones.equipped = drone.id
			end
			Data.push(player, { drones = Data.replace(table.clone(profile.drones)) })
			Feedback.reveal(player, {
				title = "DRONE FOUND",
				name = drone.name,
				tier = drone.rarity,
				body = drone.desc,
				kind = "drone",
			})
			Feedback.announce("🛠️ DRONE FOUND", `{player.DisplayName} pulled a {drone.name} out of {Format.depth(depth)}.`, { 120, 220, 255 })
			return
		end
	end
end

local function award(player: Player, node)
	local profile = Data.get(player)
	local session = Data.session(player)
	if not profile or not session then
		return
	end

	if Cargo.isFull(player) then
		-- A snatch can fill the hold mid-swing. Bail before rolling so nothing
		-- is consumed for a rock the player cannot carry.
		Feedback.toast(player, { title = "CARGO FULL", body = "Bank it before you dig more.", kind = "error" })
		return
	end

	local depth = node.depth
	local riftActive = Rift.isActiveFor(player)
	local luck = math.min(Economy.luck(player) * Rift.luckMultiplier(player), Config.MaxLuck)

	-- The live season window overrides the roll entirely: the Season Core is
	-- not in any drop table, it is granted by attendance.
	local seasonEntry = Season.tryDrop(player, depth)

	local ore, probability, mutation, luckyStrike
	if seasonEntry then
		ore = Ores.ById[seasonEntry.oreId]
		probability = SeasonConfig.OreChance
	else
		-- The node already decided what it is, and the player could see it on
		-- the way over. Luck is the second chance on top, and it can only
		-- improve the result — so the wall never lies about what is in it.
		local visible = node.ore
		if not visible then
			return
		end
		ore, probability, luckyStrike = Rarity.resolve(visible, depth, luck, rng)
		mutation = Mutations.roll(luck, riftActive, rng)
	end

	local tierIndex = Ores.TierIndex[ore.tier]
	local value = seasonEntry and seasonEntry.value
		or math.floor(ore.value * Layers.depthMultiplier(depth) * (mutation and mutation.multiplier or 1))

	local entry = {
		oreId = ore.id,
		tier = ore.tier,
		mutation = mutation and mutation.id or nil,
		value = value,
	}

	if not Cargo.add(player, entry) then
		Feedback.toast(player, {
			title = "CARGO FULL",
			body = "Ride a lift up and bank it.",
			kind = "error",
		})
		Feedback.effect(player, "full", {})
		return
	end

	World.consumeNode(node.id)

	-- Codex: first-time finds are their own small event.
	local isNew = (profile.codex[ore.id] or 0) == 0
	profile.codex[ore.id] = (profile.codex[ore.id] or 0) + 1
	profile.stats.minedTotal += 1

	local codexCount = 0
	for _ in pairs(profile.codex) do
		codexCount += 1
	end

	-- Your rarest-ever pull becomes part of your identity: it is rendered on
	-- your nameplate for everyone who walks past. Rank by tier first, then by
	-- value, so a mutated Legendary does not outrank a plain Mythic.
	local best = profile.stats.bestPull
	local bestTier = best and (Ores.TierIndex[best.tier] or 0) or 0
	if tierIndex > bestTier or (tierIndex == bestTier and value > (best and best.value or 0)) then
		profile.stats.bestPull = {
			oreId = ore.id,
			tier = ore.tier,
			mutation = entry.mutation,
			value = value,
			odds = probability,
		}
		Data.push(player, { stats = { bestPull = Data.replace(table.clone(profile.stats.bestPull)) } })
		require(script.Parent.Cosmetics).apply(player)
	end

	Data.push(player, {
		codex = { [ore.id] = profile.codex[ore.id] },
		stats = { minedTotal = profile.stats.minedTotal },
	})

	-- Quest metrics.
	Quests.record(player, "mine", 1)
	Quests.record(player, "codex", codexCount, "max")
	if tierIndex >= 3 then
		Quests.record(player, "mine_rare", 1)
	end
	if tierIndex >= 4 then
		Quests.record(player, "mine_epic", 1)
	end
	if riftActive then
		Quests.record(player, "rift_mine", 1)
		Contracts.award(player, ContractConfig.Points.perRiftOre)
	end

	if isNew then
		Contracts.award(player, ContractConfig.Points.newCodexEntry)
	elseif tierIndex >= 4 then
		Contracts.award(player, ContractConfig.Points.perEpicOre)
	elseif tierIndex >= 3 then
		Contracts.award(player, ContractConfig.Points.perRareOre)
	end

	-- Feedback, scaled to how rare the thing actually was.
	local displayName = mutation and `{mutation.name} {ore.name}` or ore.name
	Feedback.effect(player, "mined", {
		tier = ore.tier,
		value = value,
		name = displayName,
		mutation = entry.mutation,
		lucky = luckyStrike or nil,
		position = node.part.Position,
	})

	if tierIndex >= REVEAL_FROM_TIER or mutation or isNew or luckyStrike then
		Feedback.reveal(player, {
			title = isNew and "NEW DISCOVERY" or (luckyStrike and "LUCKY STRIKE" or "RARE PULL"),
			name = displayName,
			tier = ore.tier,
			mutation = entry.mutation,
			value = value,
			odds = probability,
			lucky = luckyStrike or nil,
			kind = "ore",
		})
	end

	if tierIndex >= ANNOUNCE_FROM_TIER then
		local tier = Ores.tier(ore.tier)
		Feedback.announce(
			`💎 {string.upper(ore.tier)}`,
			`{player.DisplayName} pulled {displayName} worth {Format.short(value)} at {Format.depth(depth)}.`,
			tier.color
		)
	end

	rollDroneDrop(player, depth, luck)
end

--- Start (or restart) a swing. The client re-fires this to chain nodes.
function Mining.begin(player: Player, nodeId: string)
	if not isAlive(player) then
		return
	end
	local session = Data.session(player)
	local node = World.getNode(nodeId)
	if not session or not node or not inRange(player, node) then
		return
	end

	if Cargo.isFull(player) then
		Feedback.toast(player, { title = "CARGO FULL", body = "Bank it before you dig more.", kind = "error" })
		return
	end

	local duration = Economy.mineTime(player)
	session.mining = {
		nodeId = nodeId,
		endsAt = os.clock() + duration,
		duration = duration,
	}

	-- The pickaxe chop is timed to the same duration, so the hit lands when
	-- the bar fills rather than on its own schedule.
	local Tools = require(script.Parent.Tools)
	Tools.swing(player, duration, nodeId)
	Feedback.effect(player, "swing", {
		duration = duration,
		nodeId = nodeId,
		chops = Tools.chopsFor(duration),
	})
end

function Mining.stop(player: Player)
	local session = Data.session(player)
	if session then
		session.mining = nil
	end
end

local function step()
	for _, player in ipairs(Players:GetPlayers()) do
		local session = Data.session(player)
		local active = session and session.mining
		if active then
			local node = World.getNode(active.nodeId)
			if not node or not inRange(player, node) or not isAlive(player) then
				session.mining = nil
			elseif os.clock() >= active.endsAt then
				session.mining = nil
				award(player, node)
			end
		end
	end
end

function Mining.start()
	Net.on("Mine", function(player, nodeId)
		if type(nodeId) == "string" then
			Mining.begin(player, nodeId)
		end
	end)

	task.spawn(function()
		while true do
			step()
			task.wait(0.1)
		end
	end)

	--- Depth is measured from the character the server can see, on a timer.
	---
	--- It used to be reported by the client, which was wrong twice over: a
	--- client that simply stopped sending it never ran out of air, and one
	--- that sent 3,000 collected the depth milestones and unlocked the
	--- rebirth gate without moving. Payout depth always came from the node's
	--- own recorded position, so cash was never at risk — but records,
	--- hazards and rift eligibility all were.
	task.spawn(function()
		while true do
			task.wait(0.4)
			for _, player in ipairs(Players:GetPlayers()) do
				local session = Data.session(player)
				local root = rootOf(player)
				if session and root then
					local depth = World.depthOf(root.Position)
					session.depth = depth

					local profile = Data.get(player)
					if profile and depth > profile.stats.bestDepth then
						local gained = depth - profile.stats.bestDepth
						profile.stats.bestDepth = depth
						Data.push(player, { stats = { bestDepth = depth } })
						Quests.record(player, "depth_alltime", depth, "max")
						Contracts.award(player, gained * ContractConfig.Points.perDepthRecord)
					end
					Quests.record(player, "depth", depth, "max")
					Data.push(player, { depth = depth })
				end
			end
		end
	end)
end

return Mining

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX58">
        <Properties>
          <string name="Name">Monetization</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Monetization.luau — passes, products, and the receipt handler.

	Everything degrades to a no-op while assetId is 0, so the game is fully
	playable before you have created a single product in the dashboard.

	ProcessReceipt is the one function in a Roblox game where a bug costs
	real money. The rules it follows here:
	  * grant first, then return PurchaseGranted — never the other way round;
	  * if the profile is not loaded, return NotProcessedYet so Roblox retries
	    rather than eating the purchase;
	  * record the purchase id so a retried receipt cannot double-grant.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ProductConfig = require(Shared.Config.Products)
local Format = require(Shared.Format)

local Crew = require(script.Parent.Crew)
local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)
local Rift = require(script.Parent.Rift)
local Cargo = require(script.Parent.Cargo)

local Monetization = {}

local function refreshGamepasses(player: Player)
	local session = Data.session(player)
	if not session then
		return
	end

	for _, pass in ipairs(ProductConfig.configuredGamepasses()) do
		local ok, owned = pcall(function()
			return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.assetId)
		end)
		if ok then
			session.gamepasses[pass.id] = owned
		end
	end

	Data.push(player, { gamepasses = Data.replace(table.clone(session.gamepasses)) })
	Economy.applyCharacter(player)
	Cargo.resync(player)
end

--- Cash packs scale with what the player can already earn, so a pack is
--- always worth roughly the same number of runs regardless of progression.
local function cashGrant(player: Player, factor: number): number
	local profile = Data.get(player)
	if not profile then
		return 0
	end
	local reference = math.max(profile.stats.bestSingleBank, 5000)
	return math.floor(reference * factor * (1 + profile.rebirths * 0.25))
end

local function applyProduct(player: Player, product): boolean
	local profile = Data.get(player)
	local session = Data.session(player)
	if not profile or not session then
		return false
	end

	local grant = product.grant

	if grant.cashOfBest then
		local amount = cashGrant(player, grant.cashOfBest)
		Economy.addCash(player, amount)
		Feedback.toast(player, { title = "+" .. Format.short(amount), body = product.name, kind = "cash" })
	end

	if grant.luckMultiplier and grant.minutes then
		Economy.addBuff(player, "luck", grant.luckMultiplier, grant.minutes * 60)
		Feedback.toast(player, {
			title = `{grant.luckMultiplier}x LUCK`,
			body = `Active for {grant.minutes} minutes.`,
			kind = "rift",
		})
	end

	if grant.oxygenMultiplier and grant.minutes then
		Economy.addBuff(player, "oxygen", grant.oxygenMultiplier, grant.minutes * 60)
		Feedback.toast(player, {
			title = "DEEP LUNGS",
			body = `Double air for {grant.minutes} minutes.`,
			kind = "cash",
		})
	end

	-- A deal that pays the buyer's whole crew. Bought by one person, felt by
	-- four — which is the only kind of purchase that makes a group play
	-- longer rather than shorter.
	if grant.crewCash and grant.minutes then
		local crew = Crew.of(player)
		local members = crew and crew.members or { player }
		for _, member in ipairs(members) do
			Economy.addBuff(member, "cash", grant.crewCash, grant.minutes * 60)
			Feedback.toast(member, {
				title = `{grant.crewCash}x CREW CASH`,
				body = `{player.DisplayName} bought rations for the crew.`,
				kind = "cash",
			})
		end
	end

	if grant.personalRift then
		Rift.grantPersonal(player, grant.personalRift)
	end

	if grant.restoreCargo then
		local loss = session.lastLoss
		if not loss or os.time() - loss.at > 120 then
			Feedback.toast(player, { title = "NOTHING TO RECOVER", body = "No recent loss on record.", kind = "error" })
			-- Still a valid purchase; refunding here would need a manual
			-- Robux refund, so we grant the equivalent in cash instead.
			Economy.addCash(player, cashGrant(player, 0.5))
		else
			session.lastLoss = nil
			-- Pull the crate out of the world first: the items in it are
			-- about to go straight back into the owner's hold.
			if loss.crateId then
				require(script.Parent.World).removeCrate(loss.crateId)
			end
			local recovered = 0
			for _, entry in ipairs(loss.items) do
				if Cargo.add(player, entry) then
					recovered += entry.value
				end
			end
			Feedback.toast(player, {
				title = "CARGO RECOVERED",
				body = Format.short(recovered) .. " back in your hold.",
				kind = "steal",
			})
		end
	end

	return true
end

function Monetization.start()
	local function hook(player: Player)
		task.spawn(function()
			-- Wait for the profile; gamepass state lives on the session.
			for _ = 1, 40 do
				if Data.isReady(player) then
					refreshGamepasses(player)
					return
				end
				task.wait(0.25)
			end
		end)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
	Players.PlayerAdded:Connect(hook)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, _passId, purchased)
		if purchased then
			refreshGamepasses(player)
			Feedback.effect(player, "purchase", {})
		end
	end)

	MarketplaceService.ProcessReceipt = function(receipt)
		local player = Players:GetPlayerByUserId(receipt.PlayerId)
		if not player then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local profile = Data.get(player)
		if not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		-- Idempotency: Roblox retries receipts, and a retry must not re-grant.
		profile.purchases.receipts = profile.purchases.receipts or {}
		if profile.purchases.receipts[receipt.PurchaseId] then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end

		local product = ProductConfig.byAssetId(receipt.ProductId)
		if not product then
			warn(`DeepRush: unknown product {receipt.ProductId}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		local ok, granted = pcall(applyProduct, player, product)
		if not ok or not granted then
			warn(`DeepRush: grant failed for {product.id}: {granted}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end

		profile.purchases.receipts[receipt.PurchaseId] = os.time()
		profile.purchases[product.id] = (profile.purchases[product.id] or 0) + 1

		-- Mark today's deal as taken so the shop stops offering it.
		local today = os.date("!*t")
		local dayKey = string.format("%d-%03d", today.year, today.yday)
		if profile.deals.day ~= dayKey then
			profile.deals = { day = dayKey, bought = {} }
		end
		profile.deals.bought[product.id] = true
		Data.push(player, { deals = Data.replace(table.clone(profile.deals)) })

		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return Monetization

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX59">
        <Properties>
          <string name="Name">Quests</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Quests.luau — the task layer, and the reason a player logs in tomorrow.

	Everything funnels through Quests.record(player, metric, value, mode).
	Systems do not know what a quest is; they just report facts ("this
	player mined an Epic"). Quests decides what that means. Adding a new
	daily quest is then a data edit in Config/Quests.luau, not a code change.

	Daily reset is UTC-midnight based so every player on earth flips at the
	same instant — timezone-local resets let players farm the boundary twice.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local QuestConfig = require(Shared.Config.Quests)
local Net = require(Shared.Net)

local ContractConfig = require(Shared.Config.Contracts)
local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)

local Quests = {}

local function today(): string
	local now = os.date("!*t")
	return string.format("%d-%03d", now.year, now.yday)
end

local function rollDailies(profile)
	local pool = table.clone(QuestConfig.DailyPool)
	local rng = Random.new(os.time() + math.random(1, 100000))

	local picked = {}
	for _ = 1, math.min(QuestConfig.DailyCount, #pool) do
		local index = rng:NextInteger(1, #pool)
		table.insert(picked, { id = pool[index].id, claimed = false })
		table.remove(pool, index)
	end

	profile.quests.daily = { day = today(), list = picked, rerolls = 0 }
	profile.quests.metrics = {} -- daily metrics reset with the quests
end

local function ensureDaily(player: Player): boolean
	local profile = Data.get(player)
	if not profile then
		return false
	end
	if profile.quests.daily.day == today() and #profile.quests.daily.list > 0 then
		return false
	end
	rollDailies(profile)
	return true
end

--- Read a metric, resolving the "_alltime" suffix to the lifetime table.
local function readMetric(profile, metric: string): number
	local base = metric:match("^(.-)_alltime$")
	if base then
		return profile.quests.alltime[base] or 0
	end
	return profile.quests.metrics[metric] or 0
end

--- Every quest currently live for this player, with progress attached.
function Quests.active(player: Player)
	local profile = Data.get(player)
	if not profile then
		return {}
	end
	ensureDaily(player)

	local out = { onboarding = nil, daily = {}, milestones = {} }

	local step = QuestConfig.Onboarding[profile.quests.onboarding]
	if step then
		out.onboarding = {
			id = step.id,
			name = step.name,
			desc = step.desc,
			target = step.target,
			progress = math.min(readMetric(profile, step.metric), step.target),
			reward = step.reward,
			index = profile.quests.onboarding,
			total = #QuestConfig.Onboarding,
		}
	end

	for _, entry in ipairs(profile.quests.daily.list) do
		local quest = QuestConfig.All[entry.id]
		if quest then
			table.insert(out.daily, {
				id = quest.id,
				name = quest.name,
				desc = quest.desc,
				target = quest.target,
				progress = math.min(readMetric(profile, quest.metric), quest.target),
				reward = quest.reward,
				claimed = entry.claimed,
			})
		end
	end

	for _, quest in ipairs(QuestConfig.Milestones) do
		if not profile.quests.milestones[quest.id] then
			table.insert(out.milestones, {
				id = quest.id,
				name = quest.name,
				desc = quest.desc,
				target = quest.target,
				progress = math.min(readMetric(profile, quest.metric), quest.target),
				reward = quest.reward,
			})
		end
	end

	out.rerolls = QuestConfig.DailyRerolls - profile.quests.daily.rerolls
	return out
end

-- Mining a single ore writes up to six metrics. Rebuilding and shipping the
-- whole board each time would cost a 30-player server real CPU for a panel
-- nobody has open, so writes only mark the board dirty and a slow loop flushes.
local dirty: { [Player]: boolean } = {}

local function syncQuests(player: Player)
	dirty[player] = true
end

local function flushQuests()
	for player in pairs(dirty) do
		dirty[player] = nil
		if player.Parent and Data.isReady(player) then
			Data.push(player, { questBoard = Data.replace(Quests.active(player)) })
		end
	end
end

--- The one entry point every other system uses.
--- mode: "count" accumulates, "max" keeps the best, "set" overwrites.
function Quests.record(player: Player, metric: string, value: number, mode: string?)
	local profile = Data.get(player)
	if not profile then
		return
	end
	ensureDaily(player)

	mode = mode or "count"
	local metrics = profile.quests.metrics
	local alltime = profile.quests.alltime

	if mode == "count" then
		metrics[metric] = (metrics[metric] or 0) + value
		alltime[metric] = (alltime[metric] or 0) + value
	elseif mode == "max" then
		metrics[metric] = math.max(metrics[metric] or 0, value)
		alltime[metric] = math.max(alltime[metric] or 0, value)
	else
		metrics[metric] = value
		alltime[metric] = math.max(alltime[metric] or 0, value)
	end

	syncQuests(player)
end

local function grant(player: Player, reward)
	local profile = Data.get(player)
	if not profile or not reward then
		return
	end

	require(script.Parent.Contracts).award(player, ContractConfig.Points.perQuestClaimed)

	if reward.cash then
		Economy.addCash(player, reward.cash)
	end
	if reward.luckMinutes then
		Economy.addBuff(player, "luck", 2, reward.luckMinutes * 60)
	end
	if reward.cosmetic then
		require(script.Parent.Cosmetics).unlock(player, reward.cosmetic)
	end
	if reward.drone and not profile.drones.owned[reward.drone] then
		profile.drones.owned[reward.drone] = true
		if not profile.drones.equipped then
			profile.drones.equipped = reward.drone
		end
		Data.push(player, { drones = Data.replace(table.clone(profile.drones)) })
	end
end

local function isComplete(profile, quest): boolean
	return readMetric(profile, quest.metric) >= quest.target
end

function Quests.claim(player: Player, questId: string)
	local profile = Data.get(player)
	local quest = QuestConfig.All[questId]
	if not profile or not quest or not isComplete(profile, quest) then
		return
	end

	-- Onboarding: only the current step is claimable, and claiming advances.
	local step = QuestConfig.Onboarding[profile.quests.onboarding]
	if step and step.id == questId then
		profile.quests.onboarding += 1
		grant(player, quest.reward)
		Feedback.toast(player, { title = "TASK DONE", body = quest.name, kind = "quest" })
		Data.push(player, { quests = { onboarding = profile.quests.onboarding } })
		syncQuests(player)
		return
	end

	for _, entry in ipairs(profile.quests.daily.list) do
		if entry.id == questId then
			if entry.claimed then
				return
			end
			entry.claimed = true
			grant(player, quest.reward)
			Feedback.toast(player, { title = "DAILY DONE", body = quest.name, kind = "quest" })
			Data.push(player, { quests = { daily = Data.replace(table.clone(profile.quests.daily)) } })
			syncQuests(player)
			return
		end
	end

	for _, milestone in ipairs(QuestConfig.Milestones) do
		if milestone.id == questId and not profile.quests.milestones[questId] then
			profile.quests.milestones[questId] = true
			grant(player, quest.reward)
			Feedback.broadcast({
				title = "MILESTONE",
				body = `{player.DisplayName} completed "{quest.name}"`,
				kind = "announce",
				duration = 5,
			})
			Data.push(player, { quests = { milestones = Data.replace(table.clone(profile.quests.milestones)) } })
			syncQuests(player)
			return
		end
	end
end

function Quests.reroll(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end
	if profile.quests.daily.rerolls >= QuestConfig.DailyRerolls then
		Feedback.toast(player, { title = "NO REROLLS LEFT", body = "Resets at midnight UTC.", kind = "error" })
		return
	end

	local usedRerolls = profile.quests.daily.rerolls + 1
	rollDailies(profile)
	profile.quests.daily.rerolls = usedRerolls
	Data.push(player, { quests = { daily = Data.replace(table.clone(profile.quests.daily)) } })
	syncQuests(player)
end

function Quests.start()
	Net.on("ClaimQuest", function(player, questId)
		if type(questId) == "string" then
			Quests.claim(player, questId)
		end
	end)

	Net.on("RerollDaily", function(player)
		Quests.reroll(player)
	end)

	-- The rules card lives with onboarding: it teaches the same six things the
	-- onboarding chain then makes you do.
	Net.on("IntroSeen", function(player)
		local profile = Data.get(player)
		if profile and not profile.seenIntro then
			profile.seenIntro = true
			Data.push(player, { seenIntro = true })
		end
	end)

	Data.loaded:connect(function(player)
		ensureDaily(player)
		-- Milestones read lifetime metrics, so a returning player may already
		-- have several waiting. Sync once so the board is correct on join.
		syncQuests(player)
	end)

	-- Profiles can finish loading before this service connects above, so cover
	-- anyone already in the server.
	for _, player in ipairs(Players:GetPlayers()) do
		if Data.isReady(player) then
			ensureDaily(player)
			syncQuests(player)
		end
	end

	Players.PlayerRemoving:Connect(function(player)
		dirty[player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			flushQuests()
		end
	end)
end

return Quests

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX60">
        <Properties>
          <string name="Name">Rebirth</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Rebirth.luau — the prestige reset.

	Wipes cash and upgrades. Keeps everything that is identity: codex,
	drones, records, milestones, title. That split is deliberate — a reset
	that erased your collection would make players hesitate, and a prestige
	system only works if pressing the button is obviously correct.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local RebirthConfig = require(Shared.Config.Rebirth)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)
local Quests = require(script.Parent.Quests)

local Rebirth = {}

function Rebirth.perform(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end

	local requirement = RebirthConfig.requirement(profile.rebirths)
	if profile.cash < requirement.cash then
		Feedback.toast(player, {
			title = "NOT YET",
			body = `Rebirth needs {Format.short(requirement.cash)} banked.`,
			kind = "error",
		})
		return
	end
	if profile.stats.bestDepth < requirement.depth then
		Feedback.toast(player, {
			title = "NOT DEEP ENOUGH",
			body = `Rebirth needs a record dive of {Format.depth(requirement.depth)}.`,
			kind = "error",
		})
		return
	end

	profile.rebirths += 1
	profile.cash = 0
	profile.upgrades = {}

	local bonuses = RebirthConfig.bonuses(profile.rebirths)
	local title = RebirthConfig.title(profile.rebirths)

	Data.push(player, {
		rebirths = profile.rebirths,
		cash = 0,
		upgrades = Data.replace({}),
	})

	Quests.record(player, "rebirths", profile.rebirths, "max")
	Economy.applyCharacter(player)

	Feedback.effect(player, "rebirth", { count = profile.rebirths })
	Feedback.reveal(player, {
		title = "REBIRTH " .. profile.rebirths,
		name = title,
		tier = "Legendary",
		body = `x{string.format("%.2f", bonuses.cashMultiplier)} cash · +{string.format("%.2f", bonuses.luck)} luck · +{bonuses.capacity} cargo`,
		kind = "rebirth",
	})
	Feedback.broadcast({
		title = "🔥 REBIRTH " .. profile.rebirths,
		body = `{player.DisplayName} is now a {title}.`,
		kind = "announce",
		duration = 5,
	})
end

function Rebirth.start()
	Net.on("Rebirth", function(player)
		Rebirth.perform(player)
	end)
end

return Rebirth

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX61">
        <Properties>
          <string name="Name">Rewards</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Rewards.luau — the two retention drips.

	LOGIN STREAK  escalating daily payout, day 7 is a real prize. Missing a
	              day drops you to day 1, which is the whole point.
	PLAYTIME      a chest every 10 minutes of session time. Cheap, but it
	              reliably converts a "one more run" into another 10 minutes.

	Both are pure gifts. Nothing here is gated behind a purchase, because a
	retention mechanic that costs Robux does not retain anybody.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local Format = require(Shared.Format)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)

local Rewards = {}

local STREAK_PAYOUT = { 1500, 3500, 7000, 14000, 28000, 60000, 150000 }

local function today(): string
	local now = os.date("!*t")
	return string.format("%d-%03d", now.year, now.yday)
end

local function yesterday(): string
	local now = os.date("!*t", os.time() - 86400)
	return string.format("%d-%03d", now.year, now.yday)
end

local function claimDaily(player: Player)
	local profile = Data.get(player)
	if not profile then
		return
	end

	local day = today()
	if profile.rewards.lastLogin == day then
		return
	end

	profile.rewards.streak = (profile.rewards.lastLogin == yesterday()) and (profile.rewards.streak + 1) or 1
	profile.rewards.lastLogin = day

	local index = math.min(profile.rewards.streak, #STREAK_PAYOUT)
	local payout = STREAK_PAYOUT[index] * (1 + profile.rebirths * 0.5)
	payout = math.floor(payout)

	Economy.addCash(player, payout)
	Data.push(player, { rewards = Data.replace(table.clone(profile.rewards)) })

	Feedback.reveal(player, {
		title = `DAY {profile.rewards.streak} STREAK`,
		name = "+" .. Format.short(payout),
		tier = profile.rewards.streak >= 7 and "Legendary" or "Rare",
		body = profile.rewards.streak >= 7 and "Maximum streak. Come back tomorrow to hold it."
			or `Come back tomorrow for {Format.short(STREAK_PAYOUT[math.min(index + 1, #STREAK_PAYOUT)])}.`,
		kind = "streak",
	})
end

local function playtimeLoop()
	while true do
		task.wait(Config.PlaytimeRewardInterval)
		for _, player in ipairs(Players:GetPlayers()) do
			local profile = Data.get(player)
			local session = Data.session(player)
			if profile and session then
				profile.rewards.chests += 1
				local payout = math.floor(2500 * (1 + profile.rebirths) * (1 + profile.rewards.chests * 0.15))
				Economy.addCash(player, payout)
				Economy.addBuff(player, "luck", 1.5, 300)
				Data.push(player, { rewards = Data.replace(table.clone(profile.rewards)) })
				Feedback.toast(player, {
					title = "⏱️ PLAYTIME CHEST",
					body = `+{Format.short(payout)} and 1.5x luck for 5 minutes.`,
					kind = "cash",
					duration = 5,
				})
			end
		end
	end
end

function Rewards.start()
	Data.loaded:connect(function(player)
		task.delay(3, claimDaily, player)
	end)
	task.spawn(playtimeLoop)
end

return Rewards

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX62">
        <Properties>
          <string name="Name">Rift</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Rift.luau — the scheduled server-wide event.

	A Rift Surge opens at a random layer every ~12 minutes for 90 seconds:
	5x luck for anyone inside that depth band, plus the Rift-Touched mutation
	that exists nowhere else.

	It does three jobs at once, which is why it earns its complexity:
	  * it collapses a spread-out server into one place, which is what makes
	    a server feel alive (and produces the steal drama);
	  * it gives a bored player a reason to stay two more minutes;
	  * it is the only content that reliably pulls veterans back up out of
	    the deep layers to mix with new players.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local Layers = require(Shared.Config.Layers)
local Net = require(Shared.Net)

local Data = require(script.Parent.Data)
local Feedback = require(script.Parent.Feedback)

local Rift = {}

Rift.active = nil -- { layer, minDepth, maxDepth, endsAt }

local rng = Random.new(os.time() + 991)

--- Is this player inside a rift right now — global or their own Rift Key?
function Rift.isActiveFor(player: Player): boolean
	local session = Data.session(player)
	if session and session.personalRift and session.personalRift > os.time() then
		return true
	end

	if not Rift.active or os.time() >= Rift.active.endsAt then
		return false
	end

	local depth = session and session.depth or 0
	return depth >= Rift.active.minDepth and depth <= Rift.active.maxDepth
end

function Rift.luckMultiplier(player: Player): number
	return Rift.isActiveFor(player) and Config.RiftLuckMultiplier or 1
end

function Rift.grantPersonal(player: Player, seconds: number)
	local session = Data.session(player)
	if not session then
		return
	end
	session.personalRift = os.time() + seconds
	Feedback.toast(player, {
		title = "PRIVATE RIFT OPEN",
		body = `{seconds}s of {Config.RiftLuckMultiplier}x luck, right here.`,
		kind = "rift",
	})
	Feedback.effect(player, "rift", { personal = true })
end

local function pickLayer()
	-- Weight toward layers people can actually reach: an event nobody can
	-- attend is worse than no event.
	local reachable = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = Data.get(player)
		if profile then
			table.insert(reachable, Layers.maxSafeDepth(profile.rebirths))
		end
	end

	local ceiling = 260 -- default when the server is fresh
	for _, depth in ipairs(reachable) do
		ceiling = math.max(ceiling, depth)
	end

	local options = {}
	for _, layer in ipairs(Layers.List) do
		if layer.minDepth < ceiling then
			table.insert(options, layer)
		end
	end
	return options[rng:NextInteger(1, #options)]
end

local function openRift()
	local layer = pickLayer()
	Rift.active = {
		layerId = layer.id,
		layerName = layer.name,
		minDepth = layer.minDepth,
		maxDepth = layer.maxDepth,
		endsAt = os.time() + Config.RiftDuration,
	}

	Feedback.announce(
		"⚡ RIFT SURGE",
		`{layer.name} — {Config.RiftLuckMultiplier}x luck for {Config.RiftDuration}s. Get to {math.floor(layer.minDepth)}m.`,
		{ 255, 90, 200 }
	)
	Feedback.effectAll("rift", { layer = layer.id })
end

local function closeRift()
	if not Rift.active then
		return
	end
	Rift.active = nil
	Feedback.announce("RIFT CLOSED", "The pressure equalises. Next surge is coming.", { 150, 150, 170 })
end

function Rift.state()
	if not Rift.active then
		return { active = false, nextIn = Rift.nextAt and math.max(0, Rift.nextAt - os.time()) or 0 }
	end
	return {
		active = true,
		layer = Rift.active.layerName,
		minDepth = Rift.active.minDepth,
		maxDepth = Rift.active.maxDepth,
		remaining = math.max(0, Rift.active.endsAt - os.time()),
	}
end

function Rift.start()
	Rift.nextAt = os.time() + Config.FirstRiftDelay

	task.spawn(function()
		while true do
			task.wait(1)

			if Rift.active then
				if os.time() >= Rift.active.endsAt then
					closeRift()
					Rift.nextAt = os.time() + Config.RiftInterval + rng:NextInteger(-Config.RiftJitter, Config.RiftJitter)
				end
			elseif os.time() >= Rift.nextAt then
				openRift()
			end

			-- Clients render the countdown, so they need the tick.
			for _, player in ipairs(Players:GetPlayers()) do
				if Data.isReady(player) then
					local state = Rift.state()
					state.mine = Rift.isActiveFor(player)
					Net.to(player, "Rift", state)
				end
			end
		end
	end)
end

return Rift

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX63">
        <Properties>
          <string name="Name">Season</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Season.luau — the live window, and the badge you only get by being there.

	Every weekend (UTC) a window opens. Inside it, and nowhere else, the Season
	Core drops. Mine twelve and you keep a title and a trail stamped with that
	season's name, permanently, and that season never comes back.

	The design intent is plain: give a player a specific reason to open the
	game on a specific day, and give them something everyone else can see
	afterwards. It feeds the platform's "play days" signal honestly, because
	the only way to get it is to actually turn up.

	What it will not do: it is never sold, never discounted, never extended for
	a purchase, and the threshold is low enough that one ordinary session
	inside the window earns it. Urgency that a player cannot satisfy is not
	urgency, it is just a bad evening.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Season)
local Format = require(Shared.Format)
local Net = require(Shared.Net)
local Ores = require(Shared.Config.Ores)

local Cosmetics = require(script.Parent.Cosmetics)
local Data = require(script.Parent.Data)
local Feedback = require(script.Parent.Feedback)

local Season = {}

local rng = Random.new(os.time() + 31337)
local wasOpen = nil

--- Roll the player's season record over when the season number changes. The
--- badge itself is a cosmetic and survives; only the progress counter resets.
local function ensureSeason(player: Player)
	local profile = Data.get(player)
	if not profile then
		return nil
	end

	local number = Config.number()
	if profile.season.number ~= number then
		profile.season = { number = number, cores = 0, badge = false }
		Data.push(player, { season = Data.replace(table.clone(profile.season)) })
	end
	return profile.season
end

function Season.state()
	local open = Config.isOpen()
	return {
		open = open,
		number = Config.number(),
		label = Config.badge(Config.number()).label,
		seconds = Config.secondsUntilChange(),
		requirement = Config.BadgeRequirement,
	}
end

local function grantBadge(player: Player)
	local profile = Data.get(player)
	local record = ensureSeason(player)
	if not profile or not record or record.badge then
		return
	end

	record.badge = true
	local badge = Config.badge(record.number)
	Cosmetics.unlock(player, badge.title)
	Cosmetics.unlock(player, badge.trail)
	Data.push(player, { season = Data.replace(table.clone(record)) })

	Feedback.broadcast({
		title = "🏅 SEASON BADGE",
		body = `{player.DisplayName} earned "{badge.label}". It cannot be earned again after this weekend.`,
		kind = "announce",
		duration = 7,
	})
end

--- Called by Mining on every swing inside the window. Returns a cargo entry
--- for the Season Core, or nil.
function Season.tryDrop(player: Player, depth: number)
	if not Config.isOpen() or depth < Config.Ore.minDepth then
		return nil
	end

	local record = ensureSeason(player)
	if not record then
		return nil
	end

	if rng:NextNumber() > Config.OreChance then
		return nil
	end

	record.cores += 1
	Data.push(player, { season = { cores = record.cores } })

	if record.cores >= Config.BadgeRequirement and not record.badge then
		grantBadge(player)
	else
		Feedback.toast(player, {
			title = `SEASON CORE {record.cores}/{Config.BadgeRequirement}`,
			body = "Only this weekend. Keep going.",
			kind = "rift",
		})
	end

	local ore = Ores.ById[Config.Ore.id]
	return {
		oreId = Config.Ore.id,
		tier = ore and ore.tier or Config.Ore.tier,
		mutation = nil,
		value = Config.Ore.value,
	}
end

local function announce(open: boolean)
	local badge = Config.badge(Config.number())
	if open then
		Feedback.announce(
			"🏅 SEASON WINDOW OPEN",
			`"{badge.label}" — mine {Config.BadgeRequirement} Season Cores below {Format.depth(Config.Ore.minDepth)} to keep the badge forever.`,
			{ 255, 205, 90 }
		)
		Feedback.effectAll("rift", { season = true })
	else
		Feedback.announce(
			"SEASON WINDOW CLOSED",
			`"{badge.label}" is gone. The next window opens in {Format.clock(Config.secondsUntilChange())}.`,
			{ 150, 150, 170 }
		)
	end
end

function Season.start()
	Data.loaded:connect(function(player)
		ensureSeason(player)
		task.delay(8, function()
			if not player.Parent or not Config.isOpen() then
				return
			end
			local record = Data.get(player) and Data.get(player).season
			if record and not record.badge then
				Feedback.toast(player, {
					title = "🏅 SEASON WINDOW IS OPEN",
					body = `{Config.badge(Config.number()).label} — this badge disappears when the weekend does.`,
					kind = "rift",
					duration = 7,
				})
			end
		end)
	end)

	task.spawn(function()
		while true do
			local open = Config.isOpen()
			if wasOpen ~= nil and open ~= wasOpen then
				announce(open)
			end
			wasOpen = open

			local state = Season.state()
			for _, player in ipairs(Players:GetPlayers()) do
				if Data.isReady(player) then
					local profile = Data.get(player)
					state.cores = profile.season.cores
					state.badge = profile.season.badge
					Net.to(player, "Season", state)
				end
			end

			task.wait(2)
		end
	end)
end

return Season

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX64">
        <Properties>
          <string name="Name">Steal</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Steal.luau — the social hook, and the part most likely to be abused.

	Two ways to take someone else's loot:
	  CRATES   when a miner dies, most of their unbanked cargo drops as a
	           crate. Theirs alone for a few seconds, then anyone's.
	  SNATCH   a short-range pull that only works on a MARKED player — one
	           whose hold is past the greed threshold.

	The design constraint we refuse to break: greed must be the only thing
	that makes you stealable. A cautious player can never be griefed, a
	brand-new player is immune outright, and a rich player who banks often is
	never a target. That turns theft from harassment into a bet the victim
	knowingly took.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local CrewConfig = require(Shared.Config.Crew)
local DroneConfig = require(Shared.Config.Drones)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Cargo = require(script.Parent.Cargo)
local Crew = require(script.Parent.Crew)
local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local World = require(script.Parent.World)
local Feedback = require(script.Parent.Feedback)
local Quests = require(script.Parent.Quests)

local Steal = {}

local function rootOf(player: Player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

--- New players cannot steal and cannot be stolen from. Both halves matter:
--- the first stops alt-account farming, the second stops the experience
--- every new player would otherwise have in their first two minutes.
function Steal.isProtected(player: Player): boolean
	local profile = Data.get(player)
	local session = Data.session(player)
	if not profile or not session then
		return true
	end

	local played = profile.stats.playtime + (os.clock() - session.joinedAt)
	if played < Config.NewPlayerGraceSeconds and profile.stats.bestDepth < Config.NewPlayerGraceDepth then
		return true
	end
	return false
end

local function nearestMarkedTarget(thief: Player)
	local root = rootOf(thief)
	if not root then
		return nil
	end

	local best, bestDistance = nil, Config.SnatchRange
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= thief and not Steal.isProtected(other) and Cargo.isMarked(other) then
			local otherRoot = rootOf(other)
			if otherRoot then
				local distance = (otherRoot.Position - root.Position).Magnitude
				if distance <= bestDistance then
					best, bestDistance = other, distance
				end
			end
		end
	end
	return best
end

function Steal.snatch(thief: Player)
	local session = Data.session(thief)
	if not session then
		return
	end

	if Steal.isProtected(thief) then
		Feedback.toast(thief, {
			title = "NOT YET",
			body = `Reach {Config.NewPlayerGraceDepth}m first. Until then nobody can rob you either.`,
			kind = "error",
		})
		return
	end

	local remaining = Config.SnatchCooldown - (os.time() - (session.lastSnatch or 0))
	if remaining > 0 then
		Feedback.toast(thief, { title = "SNATCH COOLING", body = `{math.ceil(remaining)}s left.`, kind = "error" })
		return
	end

	local victim = nearestMarkedTarget(thief)
	if not victim then
		Feedback.toast(thief, {
			title = "NO MARKED MINER",
			body = "Only greedy holds glow. Get closer to one.",
			kind = "error",
		})
		return
	end

	session.lastSnatch = os.time()

	-- Safe Pocket shrinks what can be taken, it never blocks the snatch —
	-- a fully immune target would make the marked glow a lie.
	local share = Config.GreedStealShare * (1 - Economy.protectedShare(victim))
	local items, value = Cargo.take(victim, share)
	if #items == 0 then
		return
	end

	local gained = Cargo.give(thief, items)

	local profile = Data.get(thief)
	if profile then
		profile.stats.steals += 1
		Data.push(thief, { stats = { steals = profile.stats.steals } })
	end
	Quests.record(thief, "steal", 1)
	Quests.record(thief, "steal_alltime", 1)

	Feedback.effect(thief, "snatch", { amount = gained, victim = victim.DisplayName })
	Feedback.toast(thief, {
		title = "SNATCHED " .. Format.short(gained),
		body = `Off {victim.DisplayName}. Bank it before someone does it to you.`,
		kind = "steal",
	})
	Feedback.effect(victim, "robbed", { amount = value, thief = thief.DisplayName })
	Feedback.toast(victim, {
		title = "-" .. Format.short(value),
		body = `{thief.DisplayName} snatched your cargo. Bank earlier next time.`,
		kind = "error",
	})
end

--- `maxDistance` exists for the Magnet Drone, whose reach is larger than a
--- player's arm. Requests coming from the client always use the default.
function Steal.grabCrate(player: Player, crateId: string, maxDistance: number?)
	local crate = World.getCrate(crateId)
	local root = rootOf(player)
	if not crate or not root then
		return
	end

	if (crate.part.Position - root.Position).Magnitude > (maxDistance or 14) then
		return
	end

	local isOwner = player.UserId == crate.owner
	if not isOwner and os.time() < crate.openAt then
		Feedback.toast(player, { title = "STILL THEIRS", body = "Wait for the crate to unlock.", kind = "error" })
		return
	end

	local gained = Cargo.give(player, crate.items)
	World.removeCrate(crateId)

	if not isOwner then
		local profile = Data.get(player)
		if profile then
			profile.stats.steals += 1
			Data.push(player, { stats = { steals = profile.stats.steals } })
		end
		Quests.record(player, "steal", 1)
		Quests.record(player, "steal_alltime", 1)
	end

	Feedback.effect(player, "crate", { amount = gained })
	Feedback.toast(player, {
		title = "+" .. Format.short(gained) .. " CARGO",
		body = isOwner and "Recovered your own crate." or "Someone else's bad day.",
		kind = "steal",
	})
end

--- Death: split the hold into kept / dropped / burned.
local function onDeath(player: Player)
	local profile = Data.get(player)
	local session = Data.session(player)
	if not profile or not session then
		return
	end

	local root = rootOf(player)
	local position = root and root.Position or Vector3.new(0, 10, 0)

	local items, value = Cargo.clear(player)
	profile.stats.deaths += 1
	session.cleanBanks = 0
	session.runDepth = 0
	Data.push(player, { stats = { deaths = profile.stats.deaths } })
	Quests.record(player, "clean_banks", 0, "set")

	if #items == 0 then
		return
	end

	-- Safe Pocket keeps a slice in hand through the respawn.
	local keepCount = math.floor(#items * Economy.protectedShare(player))
	local kept = {}
	for _ = 1, keepCount do
		local entry = table.remove(items)
		if not entry then
			break
		end
		table.insert(kept, entry)
	end

	local dropCount = math.floor(#items * (1 - Config.DeathCargoLoss))
	local dropped, droppedValue = {}, 0
	for _ = 1, dropCount do
		local entry = table.remove(items)
		if not entry then
			break
		end
		table.insert(dropped, entry)
		droppedValue += entry.value
	end

	session.pendingRestore = kept
	-- Whatever is still in `items` at this point burned on the way down.

	local crateId = nil
	if #dropped > 0 then
		crateId = World.spawnCrate(position + Vector3.new(0, 3, 0), player.UserId, dropped, droppedValue)
		Feedback.toast(player, {
			title = "CARGO DROPPED",
			body = `{Format.short(droppedValue)} is lying where you died. It unlocks to everyone in {Config.CrateFreeForAllDelay}s.`,
			kind = "error",
			duration = 6,
		})
	end

	-- Everything that left the hold, remembered for the Cargo Insurance
	-- product. The crate id rides along so a restore also removes the crate —
	-- otherwise a player could loot their own crate AND buy the recovery.
	local lost = {}
	for _, entry in ipairs(dropped) do
		table.insert(lost, entry)
	end
	for _, entry in ipairs(items) do
		table.insert(lost, entry)
	end
	session.lastLoss = { items = lost, crateId = crateId, at = os.time() }
end

--- The opposite of a snatch: give a crewmate's dropped crate back to them
--- and take a finder's fee in cash. In a game built on theft, one clearly
--- cooperative action is what makes a crew read as a crew.
function Steal.rescue(player: Player)
	local root = rootOf(player)
	if not root then
		return
	end

	for _, crate in ipairs(World.cratesNear(root.Position, CrewConfig.RescueRadius)) do
		local owner = Players:GetPlayerByUserId(crate.owner)
		if owner and owner ~= player and Crew.isMate(player, owner) then
			local returned = Cargo.give(owner, crate.items)
			World.removeCrate(crate.id)

			local fee = math.floor(crate.value * CrewConfig.RescueReward)
			Economy.addCash(player, fee)
			Quests.record(player, "rescue", 1)

			Feedback.effect(player, "crate", { amount = fee })
			Feedback.toast(player, {
				title = "CARGO RETURNED",
				body = `Gave {owner.DisplayName} their haul back. Finder's fee: {Format.short(fee)}.`,
				kind = "quest",
			})
			Feedback.toast(owner, {
				title = "+" .. Format.short(returned) .. " RECOVERED",
				body = `{player.DisplayName} brought your cargo back.`,
				kind = "cash",
			})
			return
		end
	end

	Feedback.toast(player, {
		title = "NOTHING TO RETURN",
		body = "Stand next to a crewmate's dropped crate.",
		kind = "error",
	})
end

--- Magnet Drone: hoover nearby crates without touching them.
local function magnetSweep()
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = Data.get(player)
		local root = rootOf(player)
		if profile and root then
			local radius = DroneConfig.bonusesOf(profile.drones.equipped).magnet
			if radius > 0 then
				for _, crate in ipairs(World.cratesNear(root.Position, radius)) do
					if player.UserId == crate.owner or os.time() >= crate.openAt then
						Steal.grabCrate(player, crate.id, radius)
					end
				end
			end
		end
	end
end

function Steal.start()
	Net.on("Snatch", function(player)
		Steal.snatch(player)
	end)

	Net.on("Rescue", function(player)
		Steal.rescue(player)
	end)

	Net.on("GrabCrate", function(player, crateId)
		if type(crateId) == "string" then
			Steal.grabCrate(player, crateId)
		end
	end)

	local function hookCharacter(player: Player, character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid then
			return
		end
		humanoid.Died:Connect(function()
			onDeath(player)
		end)

		-- Hand back whatever Safe Pocket saved.
		local session = Data.session(player)
		if session and session.pendingRestore then
			for _, entry in ipairs(session.pendingRestore) do
				Cargo.add(player, entry)
			end
			session.pendingRestore = nil
		end
	end

	local function hookPlayer(player: Player)
		if player.Character then
			task.spawn(hookCharacter, player, player.Character)
		end
		player.CharacterAdded:Connect(function(character)
			hookCharacter(player, character)
		end)
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hookPlayer(player)
	end
	Players.PlayerAdded:Connect(hookPlayer)

	-- Broadcast who is marked so clients can render the glow and the radar.
	task.spawn(function()
		while true do
			task.wait(1)
			local marked = {}
			for _, player in ipairs(Players:GetPlayers()) do
				if not Steal.isProtected(player) and Cargo.isMarked(player) then
					table.insert(marked, player.UserId)
				end
			end
			Net.all("Marked", marked)
			magnetSweep()
		end
	end)
end

return Steal

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX65">
        <Properties>
          <string name="Name">Surface</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Surface.luau — getting out, and cashing in.

	These two live together because to a player they are one thought: "I am
	full, get me up and pay me."

	The streak bonus only counts trips that went past Config.DeepBankDepth.
	Without that clause the optimal play is to hover at 10m banking single
	rocks, which is both boring and unbeatable — a classic idle-game exploit
	that we design out rather than patch later.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local Format = require(Shared.Format)
local Ranks = require(Shared.Config.Ranks)
local Net = require(Shared.Net)

local Cargo = require(script.Parent.Cargo)
local Contracts = require(script.Parent.Contracts)
local ContractConfig = require(Shared.Config.Contracts)
local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)
local Quests = require(script.Parent.Quests)
local World = require(script.Parent.World)

local Surface = {}

local LIFT_CHANNEL_SECONDS = 4

local function rootOf(player: Player)
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function atVault(player: Player): boolean
	local root = rootOf(player)
	if not root or not World.vaultPosition then
		return false
	end
	return (root.Position - World.vaultPosition).Magnitude <= Config.BankRadius
end

function Surface.deposit(player: Player)
	local profile = Data.get(player)
	local session = Data.session(player)
	if not profile or not session then
		return
	end

	if not atVault(player) then
		Feedback.toast(player, { title = "NOT AT THE VAULT", body = "Ride a lift up to the surface.", kind = "error" })
		return
	end

	local cargo = Cargo.get(player)
	if not cargo or #cargo.items == 0 then
		Feedback.toast(player, { title = "NOTHING TO BANK", body = "Go get some rocks.", kind = "error" })
		return
	end

	local deepEnough = (session.runDepth or 0) >= Config.DeepBankDepth
	if deepEnough then
		session.bankStreak = math.min((session.bankStreak or 0) + 1, math.floor(Config.BankStreakMax / Config.BankStreakStep))
	else
		session.bankStreak = 0
	end

	local streakBonus = math.min((session.bankStreak or 0) * Config.BankStreakStep, Config.BankStreakMax)
	local multiplier = Economy.cashMultiplier(player)
	local _, rawValue = Cargo.clear(player)
	local payout = math.floor(rawValue * multiplier * (1 + streakBonus))

	Economy.addCash(player, payout)

	local rankBefore = select(2, Ranks.at(profile.stats.bankedTotal))
	profile.stats.bankedTotal += payout
	profile.stats.bestSingleBank = math.max(profile.stats.bestSingleBank, payout)
	session.cleanBanks = (session.cleanBanks or 0) + 1
	session.runDepth = 0
	session.lastBank = os.time()

	Data.push(player, {
		stats = { bankedTotal = profile.stats.bankedTotal, bestSingleBank = profile.stats.bestSingleBank },
		streak = session.bankStreak,
	})

	Quests.record(player, "bank", payout)
	Quests.record(player, "bank_runs", 1)
	Quests.record(player, "bank_single", payout, "max")
	Quests.record(player, "clean_banks", session.cleanBanks, "set")
	-- Only trips that actually went down count, matching the streak rule.
	if deepEnough then
		Contracts.award(player, ContractConfig.Points.perDeepBank)
	end

	-- Feedback first, and the leaderboard write is allowed to fail.
	--
	-- This order is not cosmetic. Net wraps every handler in pcall, so when
	-- the leaderboard threw — as it does whenever the DataStore is unhappy —
	-- the player had already been paid and then got no toast, no sound and no
	-- effect. Banking looked broken while working perfectly.
	Feedback.effect(player, "bank", { amount = payout, streak = streakBonus })
	Feedback.toast(player, {
		title = "+" .. Format.short(payout),
		body = streakBonus > 0
			and `Banked. x{string.format("%.2f", multiplier)} multiplier, +{math.floor(streakBonus * 100)}% streak.`
			or `Banked. x{string.format("%.2f", multiplier)} multiplier.`,
		kind = "cash",
	})

	-- Rank up. Lifetime banked is the only figure that never falls, so this
	-- fires perhaps ten times in a player's whole history — which is exactly
	-- why it gets the reveal card and a line to the whole server rather than
	-- a toast nobody reads.
	local rank, rankAfter = Ranks.at(profile.stats.bankedTotal)
	if rankAfter > rankBefore then
		Feedback.reveal(player, {
			title = "RANK UP",
			name = `{rank.icon} {string.upper(rank.name)}`,
			body = `Lifetime banked {Format.short(profile.stats.bankedTotal)}. Everyone can see it over your head.`,
			kind = "rank",
		})
		Feedback.announce(
			`{rank.icon} RANK UP`,
			`{player.DisplayName} reached {rank.name}.`,
			rank.color
		)
		require(script.Parent.Cosmetics).apply(player)
	end

	local ok, err = pcall(function()
		require(script.Parent.Leaderboards).submit(player, payout)
	end)
	if not ok then
		warn("DeepRush: leaderboard submit failed: " .. tostring(err))
	end
end

--- The way out that always exists.
---
--- Lift pads are on every chunk now, but "every chunk" is not "everywhere":
--- a player can end up wedged, or on a ledge with nothing below, or simply
--- lost. A mining game where getting stuck is possible is a mining game where
--- someone loses an hour of cargo to level geometry.
---
--- It is deliberately worse than a lift: three times the channel, and any real
--- movement cancels it. That keeps the pads worth finding.
function Surface.emergencyAscent(player: Player)
	local session = Data.session(player)
	local root = rootOf(player)
	if not session or not root or session.lifting then
		return
	end

	if (session.depth or 0) < 20 then
		Feedback.toast(player, {
			title = "YOU ARE ALREADY UP",
			body = "Emergency ascent only works underground.",
			kind = "error",
		})
		return
	end

	session.lifting = true
	local origin = root.Position
	local seconds = Config.EmergencyAscentSeconds

	Feedback.effect(player, "lift", { duration = seconds })
	Feedback.toast(player, {
		title = "EMERGENCY ASCENT",
		body = `Hold still for {seconds}s. Moving cancels it.`,
		kind = "quest",
		duration = seconds,
	})

	task.spawn(function()
		local elapsed = 0
		while elapsed < seconds do
			task.wait(0.5)
			elapsed += 0.5

			local current = rootOf(player)
			if not player.Parent or not current then
				session.lifting = false
				return
			end

			if (current.Position - origin).Magnitude > Config.EmergencyAscentDrift then
				session.lifting = false
				Feedback.toast(player, {
					title = "ASCENT CANCELLED",
					body = "You moved. Stand still and try again.",
					kind = "error",
				})
				return
			end
		end

		session.lifting = false
		local current = rootOf(player)
		if not current or not World.spawnPosition then
			return
		end
		current.CFrame = CFrame.new(World.spawnPosition + Vector3.new(0, 3, 0))
		session.depth = 0
		Feedback.effect(player, "lifted", {})
	end)
end

--- Ride a lift pad back to the surface. The channel time is the real cost of
--- being deep; the Express Lift pass removes it, which is exactly the kind
--- of thing a pass should sell — time, not power.
function Surface.useLift(player: Player)
	local session = Data.session(player)
	local root = rootOf(player)
	if not session or not root or session.lifting then
		return
	end

	-- Must actually be standing on a pad.
	local onPad = false
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, 12)) do
		if part:GetAttribute("LiftPad") then
			onPad = true
			break
		end
	end

	if not onPad then
		Feedback.toast(player, { title = "NO LIFT HERE", body = "Find a green lift pad.", kind = "error" })
		return
	end

	local instant = Economy.hasGamepass(player, "fastlift")
	local channel = instant and 0 or LIFT_CHANNEL_SECONDS

	session.lifting = true
	Feedback.effect(player, "lift", { duration = channel })

	task.delay(channel, function()
		session.lifting = false
		local currentRoot = rootOf(player)
		if not currentRoot or not World.spawnPosition then
			return
		end
		currentRoot.CFrame = CFrame.new(World.spawnPosition + Vector3.new(0, 3, 0))
		session.depth = 0
		Feedback.effect(player, "lifted", {})
	end)
end

function Surface.start()
	Net.on("Bank", function(player)
		Surface.deposit(player)
	end)

	Net.on("UseLift", function(player)
		Surface.useLift(player)
	end)

	Net.on("EmergencyAscent", function(player)
		Surface.emergencyAscent(player)
	end)

	-- Track the deepest point of the current trip for the streak rule.
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local session = Data.session(player)
				if session then
					session.runDepth = math.max(session.runDepth or 0, session.depth or 0)
				end
			end
		end
	end)
end

return Surface

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX66">
        <Properties>
          <string name="Name">Tools</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Tools.luau — build the pickaxe, and swing it.

	A Motor6D rather than a WeldConstraint, because a weld cannot be animated
	and the swing is most of the point: a progress bar tells you mining is
	happening, an arm coming down tells you it is happening to THAT rock.

	Rig-agnostic: R15 characters have a RightHand, R6 characters have a
	"Right Arm". New experiences default to R15, but a place can be switched
	to R6 in one setting and nobody would think to update this file.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Tools)

local Data = require(script.Parent.Data)

local Tools = {}

local motors: { [Player]: Motor6D } = {}

local function handOf(character: Model)
	return character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm")
end

local function makePart(name: string, size: Vector3, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = material
	part.CanCollide = false
	part.Massless = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function rgb(triple)
	return Color3.fromRGB(triple[1], triple[2], triple[3])
end

--- Rebuild the pickaxe for whatever tier the player is currently on.
function Tools.equip(player: Player)
	local character = player.Character
	local profile = Data.get(player)
	if not character or not profile then
		return
	end

	local hand = handOf(character)
	if not hand then
		return
	end

	local existing = character:FindFirstChild("Pickaxe")
	if existing then
		existing:Destroy()
	end

	-- The motor too, and not only for tidiness. Re-equipping happens on every
	-- Drill Power level now, so leaving them behind hangs a dead Motor6D on
	-- the hand per upgrade — fifty of them by max level, each pointing at a
	-- pickaxe that no longer exists.
	local staleMotor = hand:FindFirstChild("PickaxeMotor")
	if staleMotor then
		staleMotor:Destroy()
	end
	motors[player] = nil

	local tier = Config.tierFor(profile.upgrades.drill or 0)

	local haft = makePart("Pickaxe", Vector3.new(0.28, 2.6, 0.28), rgb(tier.haft), Enum.Material.Wood)
	haft.CFrame = hand.CFrame
	haft.Parent = character

	local head = makePart(
		"Head",
		Vector3.new(tier.headSize[1], tier.headSize[2], tier.headSize[3]),
		rgb(tier.head),
		tier.neon and Enum.Material.Neon or Enum.Material.Metal
	)
	head.CFrame = haft.CFrame * CFrame.new(0, 1.3, 0)
	head.Parent = haft

	local headWeld = Instance.new("WeldConstraint")
	headWeld.Part0 = haft
	headWeld.Part1 = head
	headWeld.Parent = haft

	-- The tip, so the silhouette reads as a pick rather than a hammer.
	local tip = makePart("Tip", Vector3.new(0.5, 0.9, 0.4), rgb(tier.head), head.Material)
	tip.CFrame = head.CFrame * CFrame.new(-tier.headSize[1] / 2 + 0.2, -0.4, 0)
	tip.Parent = haft

	local tipWeld = Instance.new("WeldConstraint")
	tipWeld.Part0 = haft
	tipWeld.Part1 = tip
	tipWeld.Parent = haft

	if tier.neon then
		local glow = Instance.new("PointLight")
		glow.Color = rgb(tier.head)
		glow.Range = 14
		glow.Brightness = 2
		glow.Parent = head
	end

	local motor = Instance.new("Motor6D")
	motor.Name = "PickaxeMotor"
	motor.Part0 = hand
	motor.Part1 = haft
	motor.C0 = CFrame.new(Config.Grip[1], Config.Grip[2], Config.Grip[3])
	motor.Parent = hand

	motors[player] = motor
end

--- One chop, timed to the swing the server is already running.
--- Chop, for as long as the swing lasts.
---
--- One tween down and one back was a single lazy wave of a stick per rock,
--- and at a maxed drill it barely moved at all. A swing is now as many chops
--- as it has room for, each with a wind-up, a fast strike and a recoil — and
--- each one kicks the rock it lands on, so the rock is part of the animation
--- rather than a thing that vanishes at the end of it.
--- How many chops fit in a swing. One per ~0.42s: below that the strikes
--- blur into a vibration, above it the pick hangs in the air.
function Tools.chopsFor(duration: number): number
	return math.clamp(math.round(duration / 0.42), 1, 4)
end

function Tools.swing(player: Player, duration: number, nodeId: string?)
	local motor = motors[player]
	if not motor or not motor.Parent then
		return
	end

	local rest = CFrame.new(Config.Grip[1], Config.Grip[2], Config.Grip[3])
	local raised = rest * CFrame.Angles(math.rad(-Config.SwingAngle * 0.55), 0, math.rad(-12))
	local struck = rest * CFrame.Angles(math.rad(Config.SwingAngle * 0.45), 0, math.rad(6))

	-- One chop per ~0.42s of swing, so a slow pick lands four and a fast one
	-- lands one. Below that the strikes blur into a vibration.
	local chops = Tools.chopsFor(duration)
	local each = duration / chops

	task.spawn(function()
		for index = 1, chops do
			if not motor.Parent then
				return
			end

			local lift = each * 0.34
			local fall = each * 0.30
			local recover = each - lift - fall

			TweenService:Create(motor, TweenInfo.new(lift, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				C0 = raised,
			}):Play()
			task.wait(lift)

			if not motor.Parent then
				return
			end
			-- The strike is the fast part. Quad In means it accelerates into
			-- the rock instead of arriving at a constant speed.
			TweenService:Create(motor, TweenInfo.new(fall, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
				C0 = struck,
			}):Play()
			task.wait(fall)

			if nodeId then
				require(script.Parent.World).chipNode(nodeId, index / chops)
			end

			if motor.Parent then
				TweenService:Create(motor, TweenInfo.new(math.max(recover, 0.04), Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
					C0 = rest,
				}):Play()
			end
			task.wait(math.max(recover, 0.04))
		end
	end)
end

function Tools.start()
	local function hook(player: Player)
		player.CharacterAdded:Connect(function()
			-- The hand is not there on the first frame.
			task.wait(0.6)
			Tools.equip(player)
		end)
		if player.Character then
			task.delay(1, Tools.equip, player)
		end
	end

	for _, player in ipairs(Players:GetPlayers()) do
		hook(player)
	end
	Players.PlayerAdded:Connect(hook)

	Players.PlayerRemoving:Connect(function(player)
		motors[player] = nil
	end)
end

return Tools

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX67">
        <Properties>
          <string name="Name">Upgrades</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Upgrades.luau — the shop.

	Server recomputes the price from the player's CURRENT level on every
	purchase rather than trusting a price the client sent. That one rule kills
	the most common Roblox economy exploit outright.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local UpgradeConfig = require(Shared.Config.Upgrades)
local Format = require(Shared.Format)
local Net = require(Shared.Net)

local Data = require(script.Parent.Data)
local Economy = require(script.Parent.Economy)
local Feedback = require(script.Parent.Feedback)
local Quests = require(script.Parent.Quests)

local Upgrades = {}

function Upgrades.buy(player: Player, upgradeId: string)
	local profile = Data.get(player)
	local upgrade = UpgradeConfig.ById[upgradeId]
	if not profile or not upgrade then
		return
	end

	local level = profile.upgrades[upgradeId] or 0
	if level >= upgrade.maxLevel then
		Feedback.toast(player, { title = "MAXED", body = upgrade.name .. " is fully upgraded.", kind = "error" })
		return
	end

	local cost = UpgradeConfig.cost(upgradeId, level)
	if not Economy.spend(player, cost) then
		Feedback.toast(player, {
			title = "NOT ENOUGH CASH",
			body = `{upgrade.name} Lv{level + 1} costs {Format.short(cost)}.`,
			kind = "error",
		})
		return
	end

	profile.upgrades[upgradeId] = level + 1
	Data.push(player, { upgrades = { [upgradeId] = level + 1 } })

	Quests.record(player, "upgrade", 1)
	Economy.applyCharacter(player)

	-- Drill Power is the one upgrade with a visible form. Rebuild the pickaxe
	-- so crossing a tier is something the player and everyone near them sees.
	if upgradeId == "drill" then
		require(script.Parent.Tools).equip(player)
	end

	Feedback.effect(player, "upgrade", { id = upgradeId })
	Feedback.toast(player, {
		title = `{upgrade.name} Lv{level + 1}`,
		body = upgrade.format(level + 1),
		kind = "upgrade",
	})
end

function Upgrades.start()
	Net.on("BuyUpgrade", function(player, upgradeId)
		if type(upgradeId) == "string" then
			Upgrades.buy(player, upgradeId)
		end
	end)
end

return Upgrades

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX68">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	World.luau — the shaft, generated in chunks around whoever is in it.

	Shape of the world, and why:

	  DOWN IS FREE, UP IS EARNED. You descend by jumping into the shaft and
	  falling (Roblox has no fall damage, so a 900m drop is pure thrill and
	  costs nothing). You ascend on lift pads, which are spaced out and slow
	  unless you own the Express Lift. That asymmetry is the whole tension:
	  going deeper is always tempting and always a commitment.

	  SHELVES, NOT TUNNELS. Ore sits on shelves that jut out of the shaft
	  wall. You fall, you land, you clear the shelf, you drop again. It gives
	  the core loop a rhythm and it means a player never has to navigate.

	  CHUNKS. 150 studs of shaft each, built when someone is near and torn
	  down when nobody is. A 3,000m shaft as static geometry would be tens of
	  thousands of parts; this keeps a live server at a few hundred.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AudioConfig = require(Shared.Config.Audio)
local Config = require(Shared.Config.Game)
local HazardConfig = require(Shared.Config.Hazards)
local Layers = require(Shared.Config.Layers)
local Ores = require(Shared.Config.Ores)
local Rarity = require(Shared.Rarity)

local World = {}

local CHUNK_HEIGHT = 150 -- studs
local SHAFT_RADIUS = 62
local WALL_SEGMENTS = 10
local SHELVES_PER_CHUNK = 2
local NODES_PER_SHELF = 6
local LIFT_EVERY_CHUNKS = 1 -- every chunk: see the bedrock note in buildChunk
local KEEP_RADIUS = 2 -- chunks around a player kept alive
local MAX_DEPTH_METERS = 3000

local chunks: { [number]: Folder } = {}
local nodes: { [string]: any } = {}
local crates: { [string]: any } = {}
local nextId = 0

local container: Folder
local crateContainer: Folder

local rng = Random.new(os.time())

local function uid(prefix: string): string
	nextId += 1
	return prefix .. nextId
end

--- Depth in meters for a world position. y = 0 is the surface.
function World.depthOf(position: Vector3): number
	return math.max(0, (Config.SurfaceY - position.Y) / Config.StudsPerMeter)
end

function World.yForDepth(meters: number): number
	return Config.SurfaceY - meters * Config.StudsPerMeter
end

local function makePart(name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

--- Attach a positional looping sound to a part. Silently does nothing until
--- the slot has an asset id, which is why the game is never broken-sounding
--- before you upload anything — it is just quieter.
local function attachLoop(part: BasePart, slot: string, volume: number, maxDistance: number)
	local id = AudioConfig.source(slot)
	if id == "" then
		return
	end

	local sound = Instance.new("Sound")
	sound.Name = "Loop_" .. slot
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = volume
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = maxDistance
	sound.Parent = part
	sound:Play()
end

local function layerColor(layer): Color3
	return Color3.fromRGB(layer.rock[1], layer.rock[2], layer.rock[3])
end

-- Ore nodes ----------------------------------------------------------------

--- How each `look` from Ores.Appearance renders. `spike` stretches the vein
--- pieces: metal seams lie flat in the rock, crystals stab out of it.
local LOOKS = {
	metal = { material = Enum.Material.Metal, transparency = 0, reflectance = 0.35, spike = 1.1, sparkle = false },
	gem = { material = Enum.Material.Glass, transparency = 0.18, reflectance = 0.3, spike = 1.9, sparkle = true },
	crystal = { material = Enum.Material.Neon, transparency = 0.05, reflectance = 0, spike = 2.4, sparkle = true },
	stone = { material = Enum.Material.Slate, transparency = 0, reflectance = 0, spike = 0.9, sparkle = false },
	void = { material = Enum.Material.Neon, transparency = 0.4, reflectance = 0, spike = 1.6, sparkle = true },
}

local BEACON_FROM_TIER = 4 -- Epic and up get a light column you can see from a shelf away
local LABEL_FROM_TIER = 3 -- Rare and up name themselves when you get close

local function oreColor(oreId: string): Color3
	local rgb = Ores.appearance(oreId).color
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

--- Build everything that depends on WHICH ore this node is. Called on spawn
--- and again on every respawn, because a node that always regrows the same
--- diamond is a diamond farm, not a mine.
local function dressNode(part: BasePart, ore, layer, depth: number)
	for _, child in ipairs(part:GetChildren()) do
		child:Destroy()
	end

	local appearance = Ores.appearance(ore.id)
	local look = LOOKS[appearance.look] or LOOKS.gem
	local tierIndex = Ores.TierIndex[ore.tier] or 1
	local tier = Ores.Tiers[tierIndex]
	local vein = oreColor(ore.id)
	local size = part.Size.X

	part.Color = layerColor(layer):Lerp(vein, 0.12)
	part:SetAttribute("Ore", ore.id)
	part:SetAttribute("Tier", ore.tier)

	-- The seam itself. Enough pieces to read as a vein, few enough that a
	-- shelf of six nodes is not a hundred parts.
	for piece = 1, rng:NextInteger(3, 5) do
		local thickness = size * rng:NextNumber(0.16, 0.3)
		local offset = Vector3.new(
			rng:NextNumber(-size * 0.42, size * 0.42),
			rng:NextNumber(-size * 0.42, size * 0.42),
			rng:NextNumber(-size * 0.42, size * 0.42)
		)
		local shard = makePart(
			"Vein" .. piece,
			Vector3.new(thickness, thickness * look.spike * rng:NextNumber(0.8, 1.5), thickness),
			CFrame.new(part.Position + offset)
				* CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)),
			vein,
			look.material
		)
		shard.CanCollide = false
		shard.Transparency = look.transparency
		shard.Reflectance = look.reflectance
		shard.Parent = part
	end

	local light = Instance.new("PointLight")
	light.Name = "Glow"
	light.Range = 10 + tierIndex * 2.5
	light.Brightness = 0.5 + tier.glow * 2.4 + math.min(depth / 1800, 1)
	light.Color = vein
	light.Parent = part

	if look.sparkle then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Name = "Sparkle"
		emitter.Color = ColorSequence.new(vein)
		emitter.Size = NumberSequence.new(0.28)
		emitter.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.3, 0.1),
			NumberSequenceKeypoint.new(1, 1),
		})
		emitter.Lifetime = NumberRange.new(0.8, 1.6)
		emitter.Rate = 2 + tierIndex * 2
		emitter.Speed = NumberRange.new(0.4, 1.2)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.LightEmission = 1
		emitter.Parent = part
	end

	-- Rare and up say what they are. Below that the colour is enough, and a
	-- shelf of six labelled dirt clods is noise.
	if tierIndex >= LABEL_FROM_TIER then
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "Label"
		billboard.Size = UDim2.new(0, 190, 0, 46)
		billboard.StudsOffsetWorldSpace = Vector3.new(0, size * 0.9 + 2, 0)
		billboard.AlwaysOnTop = false
		billboard.MaxDistance = 120
		billboard.Parent = part

		local name = Instance.new("TextLabel")
		name.Size = UDim2.new(1, 0, 0.6, 0)
		name.BackgroundTransparency = 1
		name.Font = Enum.Font.GothamBlack
		name.Text = ore.name
		name.TextColor3 = vein
		name.TextStrokeTransparency = 0.3
		name.TextScaled = true
		name.Parent = billboard

		local rank = Instance.new("TextLabel")
		rank.Size = UDim2.new(1, 0, 0.4, 0)
		rank.Position = UDim2.new(0, 0, 0.6, 0)
		rank.BackgroundTransparency = 1
		rank.Font = Enum.Font.GothamBold
		rank.Text = string.upper(ore.tier)
		rank.TextColor3 = Color3.fromRGB(tier.color[1], tier.color[2], tier.color[3])
		rank.TextStrokeTransparency = 0.5
		rank.TextScaled = true
		rank.Parent = billboard
	end

	-- Epic and up throw a column of light up the shaft. This is the single
	-- biggest reason to keep descending instead of clearing one shelf: you
	-- can see, from where you are standing, that something down there is
	-- worth the drop.
	if tierIndex >= BEACON_FROM_TIER then
		local beacon = makePart(
			"Beacon",
			Vector3.new(size * 0.45, 110 + tierIndex * 28, size * 0.45),
			CFrame.new(part.Position + Vector3.new(0, 55 + tierIndex * 14, 0)),
			vein,
			Enum.Material.Neon
		)
		beacon.CanCollide = false
		beacon.Transparency = 0.86
		beacon.CastShadow = false
		beacon.Parent = part
	end
end

local function spawnNode(parent: Instance, position: Vector3, depth: number, layer)
	local id = uid("node")
	local size = rng:NextNumber(3.2, 5.4)

	local part = makePart(
		"OreNode",
		Vector3.new(size, size, size),
		CFrame.new(position) * CFrame.Angles(rng:NextNumber(0, 6), rng:NextNumber(0, 6), rng:NextNumber(0, 6)),
		layerColor(layer),
		Enum.Material.Rock
	)
	-- Solid, because walking through a boulder is the most obviously broken
	-- thing a mining game can do. Mined-out nodes go non-solid in
	-- World.consumeNode, so you are never stopped by an invisible rock.
	part.CanCollide = true
	part:SetAttribute("NodeId", id)
	part:SetAttribute("Depth", math.floor(depth))
	part.Parent = parent

	-- What this node IS, decided now and shown in the rock. The roll carries
	-- no luck: the wall does not know who will swing at it, and a node two
	-- players can see cannot be rolled on one player's stats. Luck moved to
	-- the swing instead — see Shared/Rarity.luau.
	local ore = Rarity.rollNodeOre(depth, rng)
	if ore then
		dressNode(part, ore, layer, depth)
	end

	nodes[id] = { id = id, part = part, depth = depth, layer = layer, ore = ore, alive = ore ~= nil }
	return id
end

--- A chop landing. `progress` is 0..1 through the swing.
---
--- The rock kicks back, the vein pieces go with it, and chips come off.
--- Without this the only thing that moved during mining was a progress bar,
--- and the rock simply blinked out at the end — which is why the whole action
--- read as a menu rather than as work.
---
--- Everything is driven from a stored rest pose rather than from wherever the
--- part currently is, so four chops in a row cannot walk a rock out of the
--- wall. The vein shards are positioned absolutely rather than welded — they
--- are anchored decoration — so they have to be moved by the same delta or
--- the rock jumps out from behind its own gold.
function World.chipNode(nodeId: string, progress: number)
	local node = nodes[nodeId]
	if not node or not node.alive or not node.part.Parent then
		return
	end

	local part = node.part
	if not node.rest then
		node.rest = part.CFrame
		node.veinRest = {}
		for _, child in ipairs(part:GetChildren()) do
			if child:IsA("BasePart") then
				node.veinRest[child] = child.CFrame
			end
		end
	end

	-- Deeper into the swing the rock gives more ground, so the last chop is
	-- visibly the one that breaks it.
	local give = 0.3 + progress * 0.7
	local offset = CFrame.new(
		rng:NextNumber(-0.5, 0.5) * give,
		-0.45 * give,
		rng:NextNumber(-0.5, 0.5) * give
	) * CFrame.Angles(rng:NextNumber(-0.09, 0.09) * give, rng:NextNumber(-0.12, 0.12) * give, 0)

	local settle = TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

	part.CFrame = node.rest * offset
	TweenService:Create(part, settle, { CFrame = node.rest }):Play()

	for child, rest in pairs(node.veinRest) do
		if child.Parent then
			child.CFrame = rest * offset
			TweenService:Create(child, settle, { CFrame = rest }):Play()
		end
	end

	local sparkle = part:FindFirstChild("Sparkle")
	if sparkle then
		sparkle:Emit(6 + math.floor(progress * 10))
	end

	local chips = part:FindFirstChild("Chips")
	if not chips then
		chips = Instance.new("ParticleEmitter")
		chips.Name = "Chips"
		chips.Color = ColorSequence.new(part.Color)
		chips.Size = NumberSequence.new(0.34)
		chips.Lifetime = NumberRange.new(0.3, 0.7)
		chips.Speed = NumberRange.new(6, 14)
		chips.SpreadAngle = Vector2.new(180, 180)
		chips.Acceleration = Vector3.new(0, -60, 0)
		chips.Rate = 0
		chips.LightEmission = 0.4
		chips.Parent = part
	end
	chips:Emit(8 + math.floor(progress * 12))
end

function World.getNode(nodeId: string)
	local node = nodes[nodeId]
	if node and node.alive and node.part.Parent then
		return node
	end
	return nil
end

--- Break a node: hide it, then bring it back as something else.
---
--- We never destroy and recreate the part, because the id has to stay stable
--- for the client's target lock. The dressing is rebuilt from a fresh roll,
--- which matters more now that the ore is visible: a node that regrew the
--- same diamond every nine seconds would be a diamond farm, and the first
--- player to find one would never move again.
function World.consumeNode(nodeId: string)
	local node = nodes[nodeId]
	if not node or not node.alive then
		return
	end

	node.alive = false
	local part = node.part
	if part.Parent then
		part.Transparency = 1
		part.CanCollide = false
		for _, child in ipairs(part:GetChildren()) do
			if child:IsA("BasePart") then
				child.Transparency = 1
			elseif child:IsA("PointLight") or child:IsA("ParticleEmitter") then
				child.Enabled = false
			elseif child:IsA("BillboardGui") then
				child.Enabled = false
			end
		end
	end

	task.delay(Config.NodeRespawn, function()
		if not node.part.Parent then
			return
		end
		local ore = Rarity.rollNodeOre(node.depth, rng)
		if not ore then
			return
		end
		node.ore = ore
		node.alive = true
		-- New dressing, new children: the old rest pose refers to parts that
		-- no longer exist, and the body must start from where it belongs
		-- rather than wherever the last chop left it mid-tween.
		if node.rest then
			node.part.CFrame = node.rest
		end
		node.rest = nil
		node.veinRest = nil
		node.part.Transparency = 0
		node.part.CanCollide = true
		dressNode(node.part, ore, node.layer, node.depth)
	end)
end

-- Chunk building -----------------------------------------------------------

local function buildShelf(parent: Instance, chunkIndex: number, slot: number)
	local baseY = -chunkIndex * CHUNK_HEIGHT
	local y = baseY - rng:NextNumber(20, CHUNK_HEIGHT - 20)
	local angle = rng:NextNumber(0, math.pi * 2)
	local depth = World.depthOf(Vector3.new(0, y, 0))
	local layer = Layers.at(depth)

	local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
	local shelfCenter = outward * (SHAFT_RADIUS - 17)
	local cframe = CFrame.lookAt(Vector3.new(shelfCenter.X, y, shelfCenter.Z), Vector3.new(0, y, 0))

	local shelf = makePart("Shelf", Vector3.new(54, 3, 36), cframe, layerColor(layer), Enum.Material.Rock)
	shelf.Parent = parent

	for _ = 1, NODES_PER_SHELF do
		local offset = cframe:PointToWorldSpace(Vector3.new(rng:NextNumber(-15, 15), 3.4, rng:NextNumber(-9, 9)))
		spawnNode(parent, offset, World.depthOf(offset), layer)
	end

	-- A couple of nodes embedded in the wall above the shelf, so the shelf
	-- is a place to stand rather than the only place ore exists.
	for _ = 1, 2 do
		local wallAngle = angle + rng:NextNumber(-0.35, 0.35)
		local wallY = y + rng:NextNumber(6, 22)
		local position = Vector3.new(math.cos(wallAngle), 0, math.sin(wallAngle)) * (SHAFT_RADIUS - 3)
		local at = Vector3.new(position.X, wallY, position.Z)
		spawnNode(parent, at, World.depthOf(at), layer)
	end

	return shelf, cframe, y
end

local function buildLiftPad(parent: Instance, cframe: CFrame)
	local pad = makePart(
		"LiftPad",
		Vector3.new(12, 1.4, 12),
		cframe * CFrame.new(0, 2.6, 0),
		Color3.fromRGB(90, 255, 180),
		Enum.Material.Neon
	)
	pad:SetAttribute("LiftPad", true)
	pad.Parent = parent

	-- A column of green light running up the shaft. The label only reads at
	-- 260 studs and only if you are looking at it; this you see from anywhere
	-- in the chunk, which is the difference between "there is a way up" and
	-- "I could not find one".
	local column = makePart(
		"LiftBeacon",
		Vector3.new(3.2, 150, 3.2),
		cframe * CFrame.new(0, 78, 0),
		Color3.fromRGB(90, 255, 180),
		Enum.Material.Neon
	)
	column.CanCollide = false
	column.CastShadow = false
	column.Transparency = 0.82
	column.Parent = pad

	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(120, 255, 200)
	glow.Range = 34
	glow.Brightness = 3
	glow.Parent = pad

	attachLoop(pad, "liftMotor", 0.3, 90)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(9, 3)
	billboard.StudsOffset = Vector3.new(0, 5, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 260
	billboard.Parent = pad

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = "▲ LIFT"
	label.TextColor3 = Color3.fromRGB(120, 255, 200)
	label.TextScaled = true
	label.TextStrokeTransparency = 0.4
	label.Parent = billboard
end

-- Hazard zones ------------------------------------------------------------

--- A danger zone you can see. Persistent kinds sit armed forever; pulsing
--- kinds run their own telegraph -> burst -> rest loop and flip an `Armed`
--- attribute, which is the only thing Server/Hazards.luau reads. Keeping the
--- animation here and the damage there means neither module has to know about
--- the other, which is what stops World and Economy forming a require cycle.
local function buildHazardZone(parent: Instance, cframe: CFrame, layer)
	local kind = HazardConfig.kindOf(layer)
	if not kind then
		return
	end

	local kindId = layer.hazard.kind
	local color = HazardConfig.color(kindId)

	local zone = makePart(
		"HazardZone",
		Vector3.new(kind.radius * 2, kind.height, kind.radius * 2),
		cframe * CFrame.new(0, kind.height / 2 - 2, 0),
		color,
		Enum.Material.ForceField
	)
	zone.CanCollide = false
	zone.Transparency = kind.transparency
	zone:SetAttribute("HazardZone", kindId)
	zone:SetAttribute("HazardRadius", kind.radius)
	zone:SetAttribute("HazardHeight", kind.height)
	zone:SetAttribute("Armed", kind.mode == "persistent")
	zone.Parent = parent

	local attachment = Instance.new("Attachment")
	attachment.Parent = zone

	local particles = Instance.new("ParticleEmitter")
	particles.Color = ColorSequence.new(color)
	particles.Size = NumberSequence.new(kind.mode == "pulsing" and 3.5 or 2.2)
	particles.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	particles.Lifetime = NumberRange.new(1.4, 2.8)
	particles.Rate = kind.particleRate
	particles.Speed = NumberRange.new(kind.particleSpeed * 0.5, kind.particleSpeed)
	particles.SpreadAngle = Vector2.new(50, 50)
	particles.LightEmission = 0.7
	particles.Parent = attachment

	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = kind.radius * 1.6
	light.Brightness = kind.mode == "persistent" and 1.6 or 0.5
	light.Parent = zone

	-- You should hear a gas pocket through rock before you round the corner
	-- into it. Range is generous for that reason.
	local slot = AudioConfig.ZoneLoops[kindId]
	if slot then
		attachLoop(zone, slot, kind.mode == "persistent" and 0.45 or 0.35, kind.radius * 6)
	end

	-- A floating sign, because a player should be able to name the thing that
	-- is about to hurt them before it does.
	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(11, 3)
	billboard.StudsOffset = Vector3.new(0, kind.height / 2 + 3, 0)
	billboard.AlwaysOnTop = false
	billboard.MaxDistance = 220
	billboard.Parent = zone

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = `{kind.icon} {kind.name}`
	label.TextColor3 = color
	label.TextScaled = true
	label.TextStrokeTransparency = 0.35
	label.Parent = billboard

	if kind.mode ~= "pulsing" then
		return
	end

	-- Pulsing zones are a rhythm, not a coin flip. Same period every cycle so
	-- a player can learn to walk through one.
	task.spawn(function()
		task.wait(rng:NextNumber(0, kind.rest))
		while zone.Parent do
			zone:SetAttribute("Armed", false)
			zone.Transparency = kind.transparency
			light.Brightness = 0.5
			particles.Rate = kind.particleRate * 0.4
			task.wait(kind.rest)
			if not zone.Parent then
				return
			end

			-- Telegraph: it gets brighter and louder before anything lands.
			particles.Rate = kind.particleRate * 1.6
			TweenService:Create(zone, TweenInfo.new(kind.telegraph), {
				Transparency = math.max(0, kind.transparency - 0.35),
			}):Play()
			TweenService:Create(light, TweenInfo.new(kind.telegraph), { Brightness = 5 }):Play()
			task.wait(kind.telegraph)
			if not zone.Parent then
				return
			end

			zone:SetAttribute("Armed", true)
			particles.Rate = kind.particleRate * 4
			zone.Transparency = math.max(0, kind.transparency - 0.5)

			if kind.debris then
				for _ = 1, 5 do
					local rock = makePart(
						"Debris",
						Vector3.new(rng:NextNumber(1.4, 3.4), rng:NextNumber(1.4, 3), rng:NextNumber(1.4, 3.4)),
						zone.CFrame * CFrame.new(
							rng:NextNumber(-kind.radius, kind.radius),
							kind.height / 2,
							rng:NextNumber(-kind.radius, kind.radius)
						),
						layerColor(layer),
						Enum.Material.Rock
					)
					rock.Anchored = false
					rock.CanCollide = false
					rock.Parent = zone.Parent
					task.delay(3, function()
						if rock.Parent then
							rock:Destroy()
						end
					end)
				end
			end

			task.wait(kind.active)
		end
	end)
end

-- Set dressing ------------------------------------------------------------

--- Rubble, a crate and a dropped lamp on a shelf. None of it is interactive;
--- all of it is the difference between "a ledge" and "somewhere people work".
local function dressShelf(parent: Instance, cframe: CFrame, layer)
	local color = layerColor(layer)

	for _ = 1, rng:NextInteger(3, 6) do
		local size = rng:NextNumber(1.2, 3.2)
		local rubble = makePart(
			"Rubble",
			Vector3.new(size, size * rng:NextNumber(0.5, 0.9), size * rng:NextNumber(0.7, 1.3)),
			cframe * CFrame.new(rng:NextNumber(-16, 16), 2 + size / 2, rng:NextNumber(-10, 10))
				* CFrame.Angles(0, rng:NextNumber(0, 6), 0),
			color:Lerp(Color3.fromRGB(0, 0, 0), rng:NextNumber(0.1, 0.35)),
			Enum.Material.Rock
		)
		rubble.Parent = parent
	end

	if rng:NextNumber() < 0.45 then
		local crate = makePart(
			"Prop",
			Vector3.new(3.4, 3.4, 3.4),
			cframe * CFrame.new(rng:NextNumber(-14, 14), 3.7, rng:NextNumber(-8, 8))
				* CFrame.Angles(0, rng:NextNumber(0, 6), 0),
			Color3.fromRGB(122, 88, 46),
			Enum.Material.WoodPlanks
		)
		crate.Parent = parent
	end

	if rng:NextNumber() < 0.5 then
		local lamp = makePart(
			"Prop",
			Vector3.new(1.2, 1.6, 1.2),
			cframe * CFrame.new(rng:NextNumber(-15, 15), 2.8, rng:NextNumber(-9, 9)),
			Color3.fromRGB(255, 226, 170),
			Enum.Material.Neon
		)

		lamp.Parent = parent

		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 214, 150)
		glow.Range = 26
		glow.Brightness = 2.2
		glow.Parent = lamp
	end
end

--- Timber frames and hanging lamps down the shaft wall. These do most of the
--- work of making the shaft feel built rather than generated: they give the
--- eye a repeating vertical rhythm to measure the fall against.
local function buildSupports(parent: Instance, chunkIndex: number)
	local baseY = -chunkIndex * CHUNK_HEIGHT
	local timber = Color3.fromRGB(96, 68, 38)

	for frame = 0, 1 do
		local y = baseY - 30 - frame * 78
		local angle = (chunkIndex * 1.1 + frame * 2.4) % (math.pi * 2)
		local outward = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local at = outward * (SHAFT_RADIUS - 2)
		local facing = CFrame.lookAt(Vector3.new(at.X, y, at.Z), Vector3.new(0, y, 0))

		local post = makePart("Support", Vector3.new(2.2, 26, 2.2), facing * CFrame.new(-9, 0, 0), timber, Enum.Material.Wood)
		post.Parent = parent

		local post2 = makePart("Support", Vector3.new(2.2, 26, 2.2), facing * CFrame.new(9, 0, 0), timber, Enum.Material.Wood)
		post2.Parent = parent

		local beam = makePart("Support", Vector3.new(20, 2.2, 2.2), facing * CFrame.new(0, 13, 0), timber, Enum.Material.Wood)
		beam.Parent = parent

		local lamp = makePart(
			"ShaftLamp",
			Vector3.new(1.6, 1.6, 1.6),
			facing * CFrame.new(0, 10, 1.4),
			Color3.fromRGB(255, 210, 140),
			Enum.Material.Neon
		)
		lamp.CanCollide = false
		lamp.Parent = parent

		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 200, 130)
		light.Range = 44
		light.Brightness = 2.6
		light.Parent = lamp
	end
end

--- Stalactites hanging into the shaft. Cheap, and they break up the ring
--- silhouette that otherwise reads as a stack of hoops.
local function buildStalactites(parent: Instance, chunkIndex: number, layer)
	local baseY = -chunkIndex * CHUNK_HEIGHT
	for _ = 1, 5 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local y = baseY - rng:NextNumber(4, CHUNK_HEIGHT - 4)
		local reach = rng:NextNumber(6, 18)
		local at = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (SHAFT_RADIUS - 4)
		local spike = makePart(
			"Spike",
			Vector3.new(rng:NextNumber(1.6, 3.6), reach, rng:NextNumber(1.6, 3.6)),
			CFrame.new(Vector3.new(at.X, y, at.Z))
				* CFrame.Angles(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3)),
			layerColor(layer):Lerp(Color3.fromRGB(0, 0, 0), 0.25),
			Enum.Material.Slate
		)
		spike.Parent = parent
	end
end

--- Decorative crystal clusters growing out of the wall.
---
--- Nothing to mine here — they carry no NodeId and targeting ignores them.
--- They exist because a 3,000m shaft of rock and six ore nodes per shelf
--- reads as unfinished, and because light coming out of the wall is what
--- makes a cave feel like a place rather than a tube. They take their colour
--- from the layer, so each stratum looks like somewhere else.
local function buildCrystals(parent: Instance, chunkIndex: number, layer)
	local baseY = -chunkIndex * CHUNK_HEIGHT
	local accent = layerColor(layer):Lerp(Color3.fromRGB(120, 210, 255), 0.65)

	for _ = 1, 7 do
		local angle = rng:NextNumber(0, math.pi * 2)
		local y = baseY - rng:NextNumber(6, CHUNK_HEIGHT - 6)
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local root = out * (SHAFT_RADIUS - 2)

		local anchorShard: BasePart? = nil
		for shard = 1, rng:NextInteger(2, 4) do
			local length = rng:NextNumber(2.5, 6.5)
			local jitter = Vector3.new(rng:NextNumber(-3, 3), rng:NextNumber(-3, 3), rng:NextNumber(-3, 3))
			local crystal = makePart(
				"WallCrystal" .. shard,
				Vector3.new(rng:NextNumber(0.5, 1.1), length, rng:NextNumber(0.5, 1.1)),
				CFrame.new(Vector3.new(root.X, y, root.Z) + jitter)
					* CFrame.Angles(rng:NextNumber(-1.2, 1.2), rng:NextNumber(0, 6), rng:NextNumber(-1.2, 1.2)),
				accent,
				Enum.Material.Neon
			)
			crystal.CanCollide = false
			crystal.CastShadow = false
			crystal.Transparency = 0.25
			crystal.Parent = parent
			anchorShard = anchorShard or crystal
		end

		if anchorShard then
			local glow = Instance.new("PointLight")
			glow.Range = 16
			glow.Brightness = 0.9
			glow.Color = accent
			glow.Parent = anchorShard
		end
	end
end

--- Lamps bolted to the shaft wall, every chunk, all the way down.
---
--- The strata carry their own ambient light and the ore lights itself, but
--- between the two there were long stretches lit by nothing at all. These
--- are what make the shaft read as a mine somebody built rather than a hole
--- that happens to have things in it — and they are the reason you can see
--- the far wall from a shelf.
local function buildLamps(parent: Instance, chunkIndex: number, layer)
	local baseY = -chunkIndex * CHUNK_HEIGHT
	local warm = Color3.fromRGB(255, 206, 140)

	for index = 1, 6 do
		local angle = (index / 6) * math.pi * 2 + chunkIndex * 0.4
		local y = baseY - (index / 6) * CHUNK_HEIGHT
		local out = Vector3.new(math.cos(angle), 0, math.sin(angle))
		local at = out * (SHAFT_RADIUS - 3)

		local bracket = makePart(
			"LampBracket",
			Vector3.new(1.2, 1.2, 3),
			CFrame.lookAt(Vector3.new(at.X, y, at.Z), Vector3.new(0, y, 0)),
			Color3.fromRGB(52, 50, 56),
			Enum.Material.Metal
		)
		bracket.CanCollide = false
		bracket.Parent = parent

		local bulb = makePart(
			"LampBulb",
			Vector3.new(2.2, 0.8, 2.2),
			CFrame.new(bracket.Position) * CFrame.new(0, -1, 0),
			warm,
			Enum.Material.Neon
		)
		bulb.CanCollide = false
		bulb.CastShadow = false
		bulb.Parent = parent

		local light = Instance.new("PointLight")
		light.Color = warm
		-- Deep lamps burn harder: down there they are most of the light there
		-- is, and the layer ambient has fallen away.
		light.Range = 46 + math.min(chunkIndex, 20) * 0.8
		light.Brightness = 2.2 + math.min(chunkIndex / 14, 1.6)
		light.Parent = bulb
	end
end

local function buildChunk(chunkIndex: number)
	if chunks[chunkIndex] then
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = "Chunk" .. chunkIndex
	chunks[chunkIndex] = folder

	local centerY = -chunkIndex * CHUNK_HEIGHT - CHUNK_HEIGHT / 2
	local depth = World.depthOf(Vector3.new(0, centerY, 0))
	local layer = Layers.at(depth)
	local color = layerColor(layer)

	-- Wall ring.
	local segmentWidth = 2 * math.pi * SHAFT_RADIUS / WALL_SEGMENTS + 4
	for i = 1, WALL_SEGMENTS do
		local angle = (i / WALL_SEGMENTS) * math.pi * 2
		local position = Vector3.new(math.cos(angle) * (SHAFT_RADIUS + 5), centerY, math.sin(angle) * (SHAFT_RADIUS + 5))
		local cframe = CFrame.lookAt(position, Vector3.new(0, centerY, 0))
		local wall = makePart(
			"Wall",
			Vector3.new(segmentWidth, CHUNK_HEIGHT + 2, 10),
			cframe,
			color:Lerp(Color3.fromRGB(0, 0, 0), rng:NextNumber(0, 0.18)),
			Enum.Material.Slate
		)
		wall.Parent = folder
	end

	buildSupports(folder, chunkIndex)
	buildStalactites(folder, chunkIndex, layer)
	buildCrystals(folder, chunkIndex, layer)
	buildLamps(folder, chunkIndex, layer)

	local hazardsWanted = HazardConfig.densityFor(layer)
	local hazardsPlaced = 0

	for slot = 1, SHELVES_PER_CHUNK do
		local _, cframe = buildShelf(folder, chunkIndex, slot)
		dressShelf(folder, cframe, layer)

		if slot == 1 and chunkIndex % LIFT_EVERY_CHUNKS == 0 and chunkIndex > 0 then
			buildLiftPad(folder, cframe)
		elseif hazardsPlaced < hazardsWanted then
			-- Never on the same shelf as a lift: the way out must always be
			-- somewhere a player can stand safely.
			buildHazardZone(folder, cframe * CFrame.new(rng:NextNumber(-10, 10), 0, 0), layer)
			hazardsPlaced += 1
		end
	end

	-- Any hazards the shelves could not hold go in the open shaft, where they
	-- are something to fall past rather than something to walk into.
	while hazardsPlaced < hazardsWanted do
		local angle = rng:NextNumber(0, math.pi * 2)
		local y = centerY + rng:NextNumber(-CHUNK_HEIGHT / 2, CHUNK_HEIGHT / 2)
		local at = Vector3.new(math.cos(angle), 0, math.sin(angle)) * rng:NextNumber(10, SHAFT_RADIUS - 22)
		buildHazardZone(folder, CFrame.new(Vector3.new(at.X, y, at.Z)), layer)
		hazardsPlaced += 1
	end

	-- The floor of the world, and the way off it.
	--
	-- This used to be bedrock and nothing else, which made the bottom of the
	-- shaft a permanent trap: the nearest lift pad sat below the floor, the
	-- next two were 172 and 536 studs overhead, and a Roblox character jumps
	-- about seven. Anyone who fell the whole way was stuck for good.
	if depth >= MAX_DEPTH_METERS then
		local floorY = World.yForDepth(MAX_DEPTH_METERS) - 6
		local floor = makePart(
			"Bedrock",
			Vector3.new(SHAFT_RADIUS * 2.4, 12, SHAFT_RADIUS * 2.4),
			CFrame.new(0, floorY, 0),
			Color3.fromRGB(8, 6, 12),
			Enum.Material.Basalt
		)
		floor.Parent = folder

		local dais = makePart(
			"BedrockDais",
			Vector3.new(30, 2, 30),
			CFrame.new(0, floorY + 7, 0),
			Color3.fromRGB(22, 18, 30),
			Enum.Material.Slate
		)
		dais.Parent = folder

		buildLiftPad(folder, CFrame.new(0, floorY + 6, 0))
	end

	folder.Parent = container
end

local function destroyChunk(chunkIndex: number)
	local folder = chunks[chunkIndex]
	if not folder then
		return
	end

	for _, descendant in ipairs(folder:GetDescendants()) do
		local id = descendant:GetAttribute("NodeId")
		if id then
			nodes[id] = nil
		end
	end

	folder:Destroy()
	chunks[chunkIndex] = nil
end

-- Surface hub --------------------------------------------------------------

local function buildSurface()
	-- The place file ships with a floor and a spawn so that opening it in
	-- Studio shows something and nobody can arrive before the world does.
	-- Both sit over the shaft mouth, so they go the moment the real surface
	-- is about to exist.
	local placeholder = workspace:FindFirstChild("StudioPlaceholder")
	if placeholder then
		placeholder:Destroy()
	end

	local hub = Instance.new("Folder")
	hub.Name = "Surface"

	-- Ring platform with the shaft mouth in the middle.
	local segments = 16
	for i = 1, segments do
		local angle = (i / segments) * math.pi * 2
		local radius = SHAFT_RADIUS + 45
		local position = Vector3.new(math.cos(angle) * radius, -2, math.sin(angle) * radius)
		local slab = makePart(
			"Deck",
			Vector3.new(56, 4, 46),
			CFrame.lookAt(position, Vector3.new(0, -2, 0)),
			Color3.fromRGB(96, 100, 108),
			Enum.Material.Metal
		)
		slab.Parent = hub
	end

	-- The vault. Standing near this is what "banking" means.
	local vault = makePart(
		"Vault",
		Vector3.new(22, 16, 14),
		CFrame.new(0, 6, SHAFT_RADIUS + 34),
		Color3.fromRGB(232, 184, 66),
		Enum.Material.Metal
	)
	vault:SetAttribute("Vault", true)
	vault.Parent = hub
	World.vaultPosition = vault.Position

	local vaultSign = Instance.new("BillboardGui")
	vaultSign.Size = UDim2.fromScale(16, 5)
	vaultSign.StudsOffset = Vector3.new(0, 12, 0)
	vaultSign.AlwaysOnTop = false
	vaultSign.MaxDistance = 400
	vaultSign.Parent = vault

	local vaultLabel = Instance.new("TextLabel")
	vaultLabel.Size = UDim2.fromScale(1, 1)
	vaultLabel.BackgroundTransparency = 1
	vaultLabel.Font = Enum.Font.GothamBlack
	vaultLabel.Text = "💰 VAULT — bank your cargo here"
	vaultLabel.TextColor3 = Color3.fromRGB(255, 225, 140)
	vaultLabel.TextScaled = true
	vaultLabel.TextStrokeTransparency = 0.3
	vaultLabel.Parent = vaultSign

	-- Spawn ring, deliberately close to the shaft mouth: a new player should
	-- see the hole and the vault in the same glance.
	local spawnLocation = Instance.new("SpawnLocation")
	spawnLocation.Name = "SurfaceSpawn"
	spawnLocation.Size = Vector3.new(24, 1, 24)
	spawnLocation.CFrame = CFrame.new(0, 1, SHAFT_RADIUS + 18)
	spawnLocation.Anchored = true
	spawnLocation.Neutral = true
	spawnLocation.Color = Color3.fromRGB(Config.SpawnColor[1], Config.SpawnColor[2], Config.SpawnColor[3])
	spawnLocation.Material = Enum.Material.Neon
	spawnLocation.Parent = hub

	-- A ring and a soft light around the pad. The surface has a gold vault, a
	-- green lift and red gate beacons; home needs its own colour or it is just
	-- another glowing square.
	local spawnColor = Color3.fromRGB(Config.SpawnColor[1], Config.SpawnColor[2], Config.SpawnColor[3])
	local ring = makePart(
		"SpawnRing",
		Vector3.new(34, 0.6, 34),
		CFrame.new(0, 0.4, SHAFT_RADIUS + 18),
		spawnColor,
		Enum.Material.Neon
	)
	ring.CanCollide = false
	ring.Transparency = 0.35
	ring.Parent = hub

	local spawnGlow = Instance.new("PointLight")
	spawnGlow.Color = spawnColor
	spawnGlow.Range = 40
	spawnGlow.Brightness = 2.4
	spawnGlow.Parent = spawnLocation
	World.spawnPosition = spawnLocation.Position + Vector3.new(0, 4, 0)

	local sign = makePart(
		"Sign",
		Vector3.new(40, 1, 1),
		CFrame.new(0, 14, SHAFT_RADIUS + 6),
		Color3.fromRGB(30, 30, 36),
		Enum.Material.SmoothPlastic
	)
	sign.Transparency = 1
	sign.CanCollide = false
	sign.Parent = hub

	local signGui = Instance.new("BillboardGui")
	signGui.Size = UDim2.fromScale(30, 6)
	signGui.AlwaysOnTop = false
	signGui.MaxDistance = 500
	signGui.Parent = sign

	local signLabel = Instance.new("TextLabel")
	signLabel.Size = UDim2.fromScale(1, 1)
	signLabel.BackgroundTransparency = 1
	signLabel.Font = Enum.Font.GothamBlack
	signLabel.Text = "▼ JUMP IN ▼"
	signLabel.TextColor3 = Color3.fromRGB(255, 90, 120)
	signLabel.TextScaled = true
	signLabel.TextStrokeTransparency = 0.3
	signLabel.Parent = signGui

	-- Headframe over the shaft mouth. This is the silhouette every real mine
	-- has, and it is what turns "a hole in a platform" into a place.
	local steel = Color3.fromRGB(72, 76, 86)
	for leg = 1, 4 do
		local angle = (leg / 4) * math.pi * 2 + math.pi / 4
		local at = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (SHAFT_RADIUS + 12)
		local tower = makePart(
			"Headframe",
			Vector3.new(3, 78, 3),
			CFrame.new(at.X, 38, at.Z) * CFrame.Angles(math.rad(math.sin(angle) * 6), 0, math.rad(-math.cos(angle) * 6)),
			steel,
			Enum.Material.Metal
		)
		tower.Parent = hub

		local brace = makePart(
			"Headframe",
			Vector3.new(3, 2.4, 2.4),
			CFrame.new(at.X * 0.62, 62, at.Z * 0.62),
			steel,
			Enum.Material.Metal
		)
		brace.Parent = hub
	end

	local wheelHouse = makePart("Headframe", Vector3.new(26, 4, 26), CFrame.new(0, 78, 0), steel, Enum.Material.Metal)
	wheelHouse.Parent = hub

	local wheel = makePart("Wheel", Vector3.new(3, 22, 22), CFrame.new(0, 88, 0), Color3.fromRGB(198, 96, 40), Enum.Material.Metal)
	wheel.Shape = Enum.PartType.Cylinder
	wheel.CanCollide = false
	wheel.Parent = hub

	-- A solid railing with a gate. Solid, because a barrier you walk through
	-- is scenery pretending to be architecture. With a gate, because jumping
	-- into the shaft is the entire game and the way in has to be obvious.
	local GATE_ANGLE = math.pi / 2 -- the spawn sits on +Z
	local GATE_HALF_WIDTH = 0.42 -- radians; about a 48-degree opening
	for post = 1, 28 do
		local angle = (post / 28) * math.pi * 2
		local offset = math.abs(((angle - GATE_ANGLE + math.pi) % (math.pi * 2)) - math.pi)
		if offset > GATE_HALF_WIDTH then
			local at = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (SHAFT_RADIUS + 4)
			local rail = makePart("Rail", Vector3.new(1.1, 5, 1.1), CFrame.new(at.X, 2.5, at.Z), Color3.fromRGB(216, 170, 60), Enum.Material.Metal)
			rail.Parent = hub
		end
	end

	-- Gate posts, taller and lit, so the opening reads as the entrance rather
	-- than as a hole someone forgot to fence.
	for _, side in ipairs({ -1, 1 }) do
		local angle = GATE_ANGLE + side * GATE_HALF_WIDTH
		local at = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (SHAFT_RADIUS + 4)
		local gatePost = makePart("GatePost", Vector3.new(2, 11, 2), CFrame.new(at.X, 5.5, at.Z), Color3.fromRGB(232, 184, 66), Enum.Material.Metal)
		gatePost.Parent = hub

		local beacon = makePart("GateBeacon", Vector3.new(2.4, 1.4, 2.4), CFrame.new(at.X, 11.4, at.Z), Color3.fromRGB(255, 120, 90), Enum.Material.Neon)
		beacon.CanCollide = false
		beacon.Parent = hub

		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 120, 90)
		glow.Range = 26
		glow.Brightness = 3
		glow.Parent = beacon
	end

	-- Floodlights. The surface should be the brightest place in the game, so
	-- that descending visibly costs you light.
	for mast = 1, 4 do
		local angle = (mast / 4) * math.pi * 2 + 0.4
		local at = Vector3.new(math.cos(angle), 0, math.sin(angle)) * (SHAFT_RADIUS + 40)
		local pole = makePart("Mast", Vector3.new(1.6, 30, 1.6), CFrame.new(at.X, 15, at.Z), steel, Enum.Material.Metal)
		pole.Parent = hub

		local head = makePart("Floodlight", Vector3.new(5, 3, 5), CFrame.new(at.X, 30, at.Z), Color3.fromRGB(255, 246, 214), Enum.Material.Neon)
		head.CanCollide = false
		head.Parent = hub

		local beam = Instance.new("SpotLight")
		beam.Color = Color3.fromRGB(255, 240, 205)
		beam.Range = 90
		beam.Brightness = 3
		beam.Angle = 110
		beam.Face = Enum.NormalId.Bottom
		beam.Parent = head
	end

	-- The upgrade shack, opposite the vault. It has no function; it is there
	-- so the surface has two landmarks instead of one, which is what makes it
	-- possible to say "meet me by the shack".
	local shack = makePart("Shack", Vector3.new(20, 12, 16), CFrame.new(-46, 4, SHAFT_RADIUS + 22), Color3.fromRGB(108, 74, 44), Enum.Material.WoodPlanks)
	shack.Parent = hub

	local roof = makePart("Shack", Vector3.new(24, 1.4, 20), CFrame.new(-46, 10.6, SHAFT_RADIUS + 22), Color3.fromRGB(150, 62, 42), Enum.Material.Metal)
	roof.Parent = hub

	local shackSign = Instance.new("BillboardGui")
	shackSign.Size = UDim2.fromScale(14, 3.5)
	shackSign.StudsOffset = Vector3.new(0, 9, 0)
	shackSign.MaxDistance = 300
	shackSign.Parent = shack

	local shackLabel = Instance.new("TextLabel")
	shackLabel.Size = UDim2.fromScale(1, 1)
	shackLabel.BackgroundTransparency = 1
	shackLabel.Font = Enum.Font.GothamBlack
	shackLabel.Text = "⛏️ UPGRADES"
	shackLabel.TextColor3 = Color3.fromRGB(120, 230, 255)
	shackLabel.TextScaled = true
	shackLabel.TextStrokeTransparency = 0.35
	shackLabel.Parent = shackSign

	-- Vault door, so the vault looks like something you put things into.
	local door = makePart("VaultDoor", Vector3.new(9, 11, 1.4), CFrame.new(0, 5, SHAFT_RADIUS + 26.6), Color3.fromRGB(52, 44, 24), Enum.Material.Metal)
	door.Parent = hub

	local dial = makePart("VaultDial", Vector3.new(1, 4, 4), CFrame.new(0, 6, SHAFT_RADIUS + 25.8), Color3.fromRGB(255, 226, 150), Enum.Material.Metal)
	dial.Shape = Enum.PartType.Cylinder
	dial.CanCollide = false
	dial.Parent = hub

	-- Scattered props. Cheap, and they carry most of the "people work here".
	local propRng = Random.new(4242)
	for _ = 1, 22 do
		local angle = propRng:NextNumber(0, math.pi * 2)
		local distance = propRng:NextNumber(SHAFT_RADIUS + 12, SHAFT_RADIUS + 62)
		local at = Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		local roll = propRng:NextNumber()

		if roll < 0.45 then
			local crate = makePart("Prop", Vector3.new(4, 4, 4), CFrame.new(at.X, 2, at.Z) * CFrame.Angles(0, propRng:NextNumber(0, 6), 0), Color3.fromRGB(122, 88, 46), Enum.Material.WoodPlanks)
			crate.Parent = hub
		elseif roll < 0.75 then
			local barrel = makePart("Prop", Vector3.new(3.6, 5, 3.6), CFrame.new(at.X, 2.5, at.Z), Color3.fromRGB(70, 96, 78), Enum.Material.Metal)
			barrel.Shape = Enum.PartType.Cylinder
			barrel.CFrame = CFrame.new(at.X, 2.5, at.Z) * CFrame.Angles(0, 0, math.rad(90))
			barrel.Parent = hub
		else
			local pile = makePart("Prop", Vector3.new(propRng:NextNumber(2, 5), propRng:NextNumber(1.4, 3), propRng:NextNumber(2, 5)), CFrame.new(at.X, 1.4, at.Z) * CFrame.Angles(0, propRng:NextNumber(0, 6), 0), Color3.fromRGB(96, 88, 78), Enum.Material.Rock)
			pile.Parent = hub
		end
	end

	hub.Parent = container
end

-- Crates -------------------------------------------------------------------

--- Drop a lootable crate. Owner-only for a few seconds, then anyone's.
function World.spawnCrate(position: Vector3, ownerUserId: number, items, value: number)
	local id = uid("crate")

	local part = makePart(
		"CargoCrate",
		Vector3.new(5, 5, 5),
		CFrame.new(position),
		Color3.fromRGB(214, 160, 60),
		Enum.Material.WoodPlanks
	)
	part:SetAttribute("CrateId", id)
	part:SetAttribute("Owner", ownerUserId)
	part.Anchored = false
	part.Parent = crateContainer

	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 200, 90)
	light.Range = 20
	light.Brightness = 2
	light.Parent = part

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(10, 3)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 300
	billboard.Parent = part

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = "📦 CARGO"
	label.TextColor3 = Color3.fromRGB(255, 210, 120)
	label.TextScaled = true
	label.TextStrokeTransparency = 0.35
	label.Parent = billboard

	-- It drops so it lands on whatever shelf is below you, then freezes.
	-- Left unanchored it would keep falling to the bottom of the shaft and be
	-- unrecoverable by the person who just lost it.
	task.delay(2.5, function()
		if part.Parent then
			part.Anchored = true
		end
	end)

	crates[id] = {
		id = id,
		part = part,
		owner = ownerUserId,
		items = items,
		value = value,
		openAt = os.time() + Config.CrateFreeForAllDelay,
	}

	task.delay(Config.CrateLifetime, function()
		World.removeCrate(id)
	end)

	return id
end

function World.getCrate(crateId: string)
	local crate = crates[crateId]
	if crate and crate.part.Parent then
		return crate
	end
	return nil
end

function World.removeCrate(crateId: string)
	local crate = crates[crateId]
	if not crate then
		return
	end
	if crate.part.Parent then
		crate.part:Destroy()
	end
	crates[crateId] = nil
end

function World.cratesNear(position: Vector3, radius: number)
	local found = {}
	for _, crate in pairs(crates) do
		if crate.part.Parent and (crate.part.Position - position).Magnitude <= radius then
			table.insert(found, crate)
		end
	end
	return found
end

-- Lifecycle ----------------------------------------------------------------

local function streamChunks()
	local wanted = { [0] = true }

	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if root then
			local index = math.max(0, math.floor(-root.Position.Y / CHUNK_HEIGHT))
			for offset = -KEEP_RADIUS, KEEP_RADIUS do
				local target = index + offset
				if target >= 0 and World.depthOf(Vector3.new(0, -target * CHUNK_HEIGHT, 0)) <= MAX_DEPTH_METERS then
					wanted[target] = true
				end
			end
		end
	end

	for index in pairs(wanted) do
		buildChunk(index)
	end
	for index in pairs(chunks) do
		if not wanted[index] then
			destroyChunk(index)
		end
	end
end

function World.start()
	-- FallenPartsDestroyHeight is NOT set here, and that is not an oversight.
	-- Roblox only lets a plugin write it, so the assignment threw with
	-- "lacking capability Plugin" and took the entire world generator with
	-- it. It is a saved property, so the builder writes -9,400 straight into
	-- the place file instead; see tools/build-rbxlx.mjs.
	--
	-- Why it has to be moved rather than dropped: the default is -500 and this
	-- shaft bottoms out at -9,000, so at the default the lower two thirds of
	-- the world — and every player and dropped crate in it — is deleted on
	-- arrival.

	container = Instance.new("Folder")
	container.Name = "DeepRushWorld"
	container.Parent = workspace

	crateContainer = Instance.new("Folder")
	crateContainer.Name = "Crates"
	crateContainer.Parent = container

	buildSurface()
	buildChunk(0)
	buildChunk(1)

	task.spawn(function()
		while true do
			streamChunks()
			task.wait(1)
		end
	end)

	-- Nobody falls out of the world.
	--
	-- Raising FallenPartsDestroyHeight to clear the shaft had a cost nobody
	-- would guess: a player who ends up under the geometry no longer dies and
	-- respawns after a second, they fall for ten. That reads exactly like a
	-- broken game. Bedrock is solid so this should never fire, but "should
	-- never" is not a thing to leave to chunk streaming.
	task.spawn(function()
		local floorY = World.yForDepth(MAX_DEPTH_METERS) - 30
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart")
				if root and root.Position.Y < floorY and World.spawnPosition then
					root.CFrame = CFrame.new(World.spawnPosition)
				end
			end
		end
	end)
end

return World

]]></ProtectedString>
          <bool name="Disabled">false</bool>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX70">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX3">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="RBX4">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="ModuleScript" referent="RBX5">
          <Properties>
            <string name="Name">Atmosphere</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Atmosphere.luau — what depth sounds and looks like.

	The world geometry says where you are; this says how far down. Three
	things move together as you descend:

	  LIGHT     fog closes in, ambient drops, the tint cools then goes wrong.
	            By the Abyss you can see about forty studs, which is what makes
	            a headlamp upgrade feel like a purchase rather than a stat.
	  SOUND     four ambience layers cross-fade by depth. Nothing switches;
	            everything bleeds, so the change is felt rather than noticed.
	  TENSION   a separate layer that rises when oxygen is low or a hazard has
	            you. It is the only audio that reacts to state rather than
	            position, which is why it reads as danger.

	All of it runs on the client. The server has no opinion about your fog.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local AudioConfig = require(Shared.Config.Audio)
local Layers = require(Shared.Config.Layers)
local Net = require(Shared.Net)

local State = require(script.Parent.State)

local Atmosphere = {}

local layers: { [string]: Sound } = {}
local tension: Sound
local colorCorrection: ColorCorrectionEffect
local bloom: BloomEffect
local depthOfField: DepthOfFieldEffect
local sunRays: SunRaysEffect
local haze

local tensionTarget = 0
local hazardUntil = 0

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * math.clamp(t, 0, 1)
end

--- 0 at `from`, 1 at `to`, and it fades back out past the band so a layer
--- does not stack forever once you are below it.
local function bandVolume(depth: number, band): number
	if depth < band.from then
		return 0
	end
	local span = math.max(band.to - band.from, 1)
	local ramp = math.clamp((depth - band.from) / (span * 0.35), 0, 1)
	local falloff = depth > band.to and math.clamp(1 - (depth - band.to) / (span * 0.5), 0, 1) or 1
	return ramp * falloff
end

local function buildAudio()
	local group = Instance.new("SoundGroup")
	group.Name = "DeepRushAmbience"
	group.Volume = 1
	group.Parent = SoundService

	for _, band in ipairs(AudioConfig.Ambience) do
		local custom = AudioConfig.source(band.custom)
		local sound = Instance.new("Sound")
		sound.Name = "Ambience_" .. band.id
		sound.SoundId = custom ~= "" and custom or AudioConfig.Builtin.rumble
		-- Built-ins are short one-shots; looping them at low pitch is what
		-- turns a snare of a clip into a bed. A real uploaded loop plays at
		-- its own pitch instead.
		sound.PlaybackSpeed = custom ~= "" and 1 or band.pitch
		sound.Looped = true
		sound.Volume = 0
		sound.SoundGroup = group
		sound.Parent = SoundService
		sound:Play()
		layers[band.id] = sound
	end

	tension = Instance.new("Sound")
	tension.Name = "Tension"
	tension.SoundId = AudioConfig.Builtin.wind
	tension.PlaybackSpeed = 0.45
	tension.Looped = true
	tension.Volume = 0
	tension.SoundGroup = group
	tension.Parent = SoundService
	tension:Play()

	local music = AudioConfig.source("music")
	if music ~= "" then
		local track = Instance.new("Sound")
		track.Name = "Music"
		track.SoundId = music
		track.Looped = true
		track.Volume = AudioConfig.MusicVolume
		track.SoundGroup = group
		track.Parent = SoundService
		track:Play()
	end
end

local function buildLighting()
	-- Lighting.Technology is NOT set here, and that is not an oversight.
	-- Roblox reserves it (RobloxScriptSecurity), so assigning it throws — and
	-- a throw here took this whole controller down with it, which is how a
	-- place shipped with no atmosphere at all. It is a saved property, so the
	-- builder writes Future straight into the place file instead; see
	-- lightingProps in tools/build-rbxlx.mjs.
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.6

	colorCorrection = Lighting:FindFirstChild("DeepRushGrade") or Instance.new("ColorCorrectionEffect")
	colorCorrection.Name = "DeepRushGrade"
	colorCorrection.Parent = Lighting

	-- Threshold deliberately high. Bloom at a low threshold smears the whole
	-- screen and reads as a cheap filter; up here only genuinely bright
	-- things glow, which in this game means neon ore, lift pads and the
	-- vault. The glow then means something.
	bloom = Lighting:FindFirstChild("DeepRushBloom") or Instance.new("BloomEffect")
	bloom.Name = "DeepRushBloom"
	bloom.Intensity = 0.9
	bloom.Size = 22
	bloom.Threshold = 1.35
	bloom.Parent = Lighting

	-- Focus sits just past mining range, so the rock in your hands is sharp
	-- and the shaft below you falls away. It is also the cheapest way to make
	-- a 3,000m hole read as deep rather than tall.
	depthOfField = Lighting:FindFirstChild("DeepRushDof") or Instance.new("DepthOfFieldEffect")
	depthOfField.Name = "DeepRushDof"
	depthOfField.FarIntensity = 0.35
	depthOfField.FocusDistance = 28
	depthOfField.InFocusRadius = 42
	depthOfField.NearIntensity = 0
	depthOfField.Parent = Lighting

	-- Surface only: it fades out with the sunlight as you descend.
	sunRays = Lighting:FindFirstChild("DeepRushSun") or Instance.new("SunRaysEffect")
	sunRays.Name = "DeepRushSun"
	sunRays.Intensity = 0.16
	sunRays.Spread = 0.9
	sunRays.Parent = Lighting

	haze = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	haze.Density = 0.3
	haze.Offset = 0.2
	haze.Glare = 0.1
	haze.Haze = 1
	haze.Parent = Lighting
end

local function step(delta: number)
	local depth = State.data.depth or 0
	local layer = Layers.at(depth)
	local blend = math.clamp(delta * 1.8, 0, 1)

	-- Lighting follows the layer the player is actually in.
	local ambient = Color3.fromRGB(layer.ambient[1], layer.ambient[2], layer.ambient[3])
	Lighting.Ambient = Lighting.Ambient:Lerp(ambient, blend)
	Lighting.OutdoorAmbient = Lighting.OutdoorAmbient:Lerp(ambient, blend)
	Lighting.FogEnd = lerp(Lighting.FogEnd, layer.fog, blend)
	Lighting.FogStart = lerp(Lighting.FogStart, layer.fog * 0.12, blend)

	local rock = Color3.fromRGB(layer.rock[1], layer.rock[2], layer.rock[3])
	Lighting.FogColor = Lighting.FogColor:Lerp(rock:Lerp(Color3.fromRGB(0, 0, 0), 0.72), blend)
	-- Floor at 1.2, not 0.35. The old floor arrived at 700m and left the
	-- bottom two thirds of the game lit only by whatever the player was
	-- standing next to.
	Lighting.Brightness = lerp(Lighting.Brightness, math.max(1.2, 2.4 - depth / 900), blend)

	-- The deep is desaturated and cold; the surface is not.
	local descent = math.clamp(depth / 1800, 0, 1)
	colorCorrection.Saturation = lerp(colorCorrection.Saturation, -0.12 - descent * 0.28, blend)
	colorCorrection.Contrast = lerp(colorCorrection.Contrast, 0.08 + descent * 0.12, blend)
	colorCorrection.Brightness = lerp(colorCorrection.Brightness, 0.02 + descent * 0.06, blend)
	colorCorrection.TintColor = colorCorrection.TintColor:Lerp(
		Color3.fromRGB(255, 250, 240):Lerp(Color3.fromRGB(170, 190, 235), descent),
		blend
	)
	haze.Density = lerp(haze.Density, 0.3 + descent * 0.32, blend)

	-- The post stack follows the same descent curve as the colour grade: the
	-- deeper you are the more the light you carry is the only light there is,
	-- so bloom climbs, the far field blurs out, and the sun stops existing.
	bloom.Intensity = lerp(bloom.Intensity, 0.9 + descent * 1.5, blend)
	depthOfField.FarIntensity = lerp(depthOfField.FarIntensity, 0.35 + descent * 0.35, blend)
	depthOfField.InFocusRadius = lerp(depthOfField.InFocusRadius, 42 - descent * 20, blend)
	sunRays.Intensity = lerp(sunRays.Intensity, math.max(0, 0.16 * (1 - depth / 220)), blend)

	-- Ambience.
	for _, band in ipairs(AudioConfig.Ambience) do
		local sound = layers[band.id]
		if sound then
			sound.Volume = lerp(sound.Volume, bandVolume(depth, band) * band.volume, blend)
		end
	end

	-- Tension: low oxygen, or a hazard within the last few seconds.
	local oxygenRatio = (State.data.oxygen or 60) / math.max(State.data.oxygenMax or 60, 1)
	local fromOxygen = oxygenRatio < 0.35 and (1 - oxygenRatio / 0.35) or 0
	local fromHazard = os.clock() < hazardUntil and 1 or 0
	tensionTarget = math.max(fromOxygen, fromHazard)
	tension.Volume = lerp(tension.Volume, tensionTarget * 0.5, blend * 0.8)
	tension.PlaybackSpeed = lerp(tension.PlaybackSpeed, 0.35 + tensionTarget * 0.5, blend)
end

function Atmosphere.start()
	buildAudio()
	buildLighting()

	Net.listen("Effect", function(kind)
		if kind == "hazardWarn" or kind == "hazardHit" or kind == "hazardTick" or kind == "suffocating" then
			hazardUntil = os.clock() + 3
		end
	end)

	RunService.Heartbeat:Connect(step)
end

return Atmosphere

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="RBX6">
          <Properties>
            <string name="Name">Client</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Client.client.luau — client start order.

	State first: every controller renders from it, and a HUD that builds
	before the first snapshot arrives shows zeroes for a frame.
]]

local CONTROLLERS = {
	"State",
	"Effects",
	"Atmosphere",
	"Mining",
	"Panels",
	"Notify",
	"Hud",
	"Crew",
	"Intro",
	"Onboarding",
}

for _, name in ipairs(CONTROLLERS) do
	local module = script.Parent:FindFirstChild(name)
	if not module then
		warn(`DeepRush: controller "{name}" is missing`)
		continue
	end

	local ok, controller = pcall(require, module)
	if not ok then
		warn(`DeepRush: controller "{name}" failed to load: {controller}`)
		continue
	end

	if type(controller) == "table" and type(controller.start) == "function" then
		local startOk, err = pcall(controller.start)
		if not startOk then
			warn(`DeepRush: controller "{name}" failed to start: {err}`)
		end
	end
end

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX7">
          <Properties>
            <string name="Name">Crew</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Crew.luau (client) — the co-play surface.

	Three things live here, all of them designed to work with the sound off
	and without anyone typing a word:

	  CREW BAR    who is with you, how much bonus you are earning right now,
	              and the one button that is currently relevant (drop a
	              beacon / join the one you are standing next to / leave).
	  PING WHEEL  four fixed signals. This is the entire coordination
	              vocabulary, which is the point: since the January 2026
	              age-check rollout, two players in different age brackets may
	              not be able to chat at all, and a game that needs typing to
	              be played together is a game that quietly excludes them.
	  INVITE      Roblox's own invite prompt, offered at the moments a player
	              actually wants a friend here rather than on a timer.
]]

local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local CrewConfig = require(Shared.Config.Crew)
local Net = require(Shared.Net)

local Ui = require(script.Parent.Ui)

local Crew = {}

local player = Players.LocalPlayer
local theme = Ui.THEME

local state = { members = {}, bonusNear = 0 }
local widgets = {}
local canInvite = false

local function rootPart()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

-- World markers ------------------------------------------------------------

local function pingColor(kind: string): Color3
	for _, pingType in ipairs(CrewConfig.PingTypes) do
		if pingType.id == kind then
			return Color3.fromRGB(pingType.color[1], pingType.color[2], pingType.color[3])
		end
	end
	return theme.cyan
end

local function pingLabel(kind: string): string
	for _, pingType in ipairs(CrewConfig.PingTypes) do
		if pingType.id == kind then
			return pingType.icon .. " " .. pingType.label
		end
	end
	return "•"
end

--- Drop a marker in the world where a teammate pinged. Always on top, so it
--- is findable through rock — the whole value of a ping is that it works when
--- you cannot see each other.
local function showPing(payload)
	if typeof(payload) ~= "table" or typeof(payload.position) ~= "Vector3" then
		return
	end

	local anchor = Instance.new("Part")
	anchor.Size = Vector3.new(0.4, 0.4, 0.4)
	anchor.Position = payload.position + Vector3.new(0, 4, 0)
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.Transparency = 1
	anchor.Parent = workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(12, 3.5)
	billboard.AlwaysOnTop = true
	billboard.MaxDistance = 1000
	billboard.Parent = anchor

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = pingLabel(payload.kind)
	label.TextColor3 = pingColor(payload.kind)
	label.TextScaled = true
	label.TextStrokeTransparency = 0.25
	label.Parent = billboard

	local from = Instance.new("TextLabel")
	from.Size = UDim2.fromScale(1, 0.4)
	from.Position = UDim2.fromScale(0, 1)
	from.BackgroundTransparency = 1
	from.Font = Enum.Font.GothamMedium
	from.Text = payload.from or ""
	from.TextColor3 = theme.muted
	from.TextScaled = true
	from.TextStrokeTransparency = 0.4
	from.Parent = billboard

	TweenService:Create(anchor, TweenInfo.new(payload.lifetime or 8), {
		Position = anchor.Position + Vector3.new(0, 3, 0),
	}):Play()

	task.delay(payload.lifetime or 8, function()
		if anchor.Parent then
			anchor:Destroy()
		end
	end)
end

-- UI -----------------------------------------------------------------------

local function buildBar(parent)
	-- Sits in the bottom-centre stack above the ping row and the cargo bar.
	local bar = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(360, 96),
		position = UDim2.new(0.5, 0, 1, -140),
		anchor = Vector2.new(0.5, 1),
		color = theme.panel,
		transparency = 0.15,
	})
	Ui.stroke(bar, theme.panelLight, 2)
	Ui.padding(bar, 8)
	widgets.bar = bar
	widgets.barStroke = bar:FindFirstChildOfClass("UIStroke")

	widgets.title = Ui.text({
		parent = bar,
		size = UDim2.new(1, 0, 0, 20),
		text = "SOLO",
		color = theme.muted,
		align = Enum.TextXAlignment.Left,
		scaled = false,
		textSize = 15,
	})

	widgets.roster = Ui.text({
		parent = bar,
		size = UDim2.new(1, 0, 0, 34),
		position = UDim2.fromOffset(0, 20),
		text = "Dig with someone for +cash and +luck.",
		color = theme.muted,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		scaled = false,
		textSize = 13,
		wrap = true,
	})

	widgets.action = Ui.button({
		parent = bar,
		size = UDim2.new(1, 0, 0, 40),
		position = UDim2.new(0, 0, 1, 0),
		anchor = Vector2.new(0, 1),
		text = "🤝 DROP BEACON",
		color = theme.panelLight,
		stroke = theme.cyan,
		scaled = false,
		onClick = function()
			-- One button, three meanings, decided by what is around you.
			if #state.members > 0 then
				Net.fire("CrewLeave")
			elseif widgets.beaconNear then
				Net.fire("CrewJoin")
			else
				Net.fire("CrewBeacon")
			end
		end,
	})
end

local function buildPingWheel(parent)
	-- A horizontal row rather than a wheel: a radial menu needs a drag, and
	-- a drag is exactly what you cannot spare while falling.
	local wheel = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(372, 46),
		position = UDim2.new(0.5, 0, 1, -86),
		anchor = Vector2.new(0.5, 1),
		transparency = 1,
		radius = false,
	})

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 6)
	layout.FillDirection = Enum.FillDirection.Horizontal
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.Parent = wheel

	for _, pingType in ipairs(CrewConfig.PingTypes) do
		Ui.button({
			parent = wheel,
			size = UDim2.fromOffset(54, 46),
			text = pingType.icon,
			color = theme.panel,
			stroke = Color3.fromRGB(pingType.color[1], pingType.color[2], pingType.color[3]),
			onClick = function()
				Net.fire("Ping", pingType.id)
			end,
		})
	end

	widgets.rescue = Ui.button({
		parent = wheel,
		size = UDim2.fromOffset(54, 46),
		text = "🫱",
		color = theme.green,
		textColor = Color3.fromRGB(10, 30, 20),
		visible = false,
		onClick = function()
			Net.fire("Rescue")
		end,
	})

	widgets.invite = Ui.button({
		parent = wheel,
		size = UDim2.fromOffset(54, 46),
		text = "➕",
		color = theme.panelLight,
		stroke = theme.accent,
		visible = false,
		onClick = function()
			local ok, err = pcall(function()
				SocialService:PromptGameInvite(player)
			end)
			if not ok then
				warn("DeepRush: invite prompt failed: " .. tostring(err))
			end
		end,
	})
end

local function render()
	local count = #state.members
	if count > 0 then
		widgets.title.Text = `CREW {count}/{CrewConfig.MaxSize}`
		widgets.title.TextColor3 = state.bonusNear > 0 and theme.green or theme.muted

		local names = {}
		for _, member in ipairs(state.members) do
			if member.userId ~= player.UserId then
				table.insert(names, `{member.name} · {member.depth}m`)
			end
		end
		widgets.roster.Text = table.concat(names, "\n")

		if state.bonusNear > 0 then
			local cash = math.floor(state.bonusNear * CrewConfig.CashPerMember * 100)
			local luck = state.bonusNear * CrewConfig.LuckPerMember
			widgets.title.Text ..= `  ·  +{cash}% cash, +{string.format("%.2f", luck)} luck`
		else
			widgets.title.Text ..= "  ·  too far apart"
		end

		widgets.action.Text = "LEAVE CREW"
		if widgets.barStroke then
			widgets.barStroke.Color = state.bonusNear > 0 and theme.green or theme.panelLight
		end
	elseif widgets.beaconNear then
		widgets.title.Text = "BEACON NEARBY"
		widgets.title.TextColor3 = theme.cyan
		widgets.roster.Text = "Someone is looking for a crew."
		widgets.action.Text = "🤝 JOIN CREW"
		if widgets.barStroke then
			widgets.barStroke.Color = theme.cyan
		end
	else
		widgets.title.Text = "SOLO"
		widgets.title.TextColor3 = theme.muted
		widgets.roster.Text = "Dig within 120 studs of a crewmate for +cash and +luck."
		widgets.action.Text = "🤝 DROP BEACON"
		if widgets.barStroke then
			widgets.barStroke.Color = theme.panelLight
		end
	end

	widgets.invite.Visible = canInvite and count < CrewConfig.MaxSize
end

--- Contextual scan: is there a beacon to join, or a crewmate's crate to hand
--- back? Both change which button is on screen.
local function scan()
	local root = rootPart()
	if not root then
		return
	end

	local beaconNear = false
	local crateNear = false
	local mates = {}
	for _, member in ipairs(state.members) do
		mates[member.userId] = true
	end

	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, CrewConfig.JoinRadius)) do
		local beaconOwner = part:GetAttribute("CrewBeacon")
		if beaconOwner and beaconOwner ~= player.UserId then
			beaconNear = true
		end
	end

	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, CrewConfig.RescueRadius)) do
		local crateOwner = part:GetAttribute("Owner")
		if crateOwner and mates[crateOwner] and crateOwner ~= player.UserId then
			crateNear = true
		end
	end

	local changed = beaconNear ~= widgets.beaconNear
	widgets.beaconNear = beaconNear
	widgets.rescue.Visible = crateNear
	if changed then
		render()
	end
end

function Crew.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DeepRushCrew"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 2
	gui.Parent = player:WaitForChild("PlayerGui")

	buildBar(gui)
	buildPingWheel(gui)
	render()

	Net.listen("Crew", function(payload)
		if typeof(payload) == "table" then
			state = payload
			render()
		end
	end)

	Net.listen("Pings", showPing)

	-- Asked once: the answer does not change during a session, and the call
	-- yields.
	task.spawn(function()
		local ok, result = pcall(function()
			return SocialService:CanSendGameInviteAsync(player)
		end)
		canInvite = ok and result == true
		render()
	end)

	task.spawn(function()
		while true do
			task.wait(0.5)
			local ok, err = pcall(scan)
			if not ok then
				warn("DeepRush: crew scan failed: " .. tostring(err))
			end
		end
	end)
end

return Crew

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX8">
          <Properties>
            <string name="Name">Effects</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Effects.luau — game feel.

	All of it is client-side and reactive to server "Effect" signals, so the
	server stays authoritative about what happened while the client decides
	how loud it is. Sounds are Roblox built-ins (rbxasset://) so the place
	works the moment you open it — swap in your own asset ids later.
]]

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)
local Ores = require(Shared.Config.Ores)
local Net = require(Shared.Net)

local Effects = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local AudioConfig = require(Shared.Config.Audio)

--- Built-ins by default; anything uploaded and configured wins. The mining
--- hit is the sound a player hears thousands of times a session, so it is the
--- one most worth replacing.
local SOUNDS = {
	hit = AudioConfig.source("pickHit") ~= "" and AudioConfig.source("pickHit")
		or "rbxasset://sounds/snap.wav",
	reveal = AudioConfig.source("rareReveal") ~= "" and AudioConfig.source("rareReveal")
		or "rbxasset://sounds/bass.wav",
	ping = "rbxasset://sounds/electronicpingshort.wav",
	click = "rbxasset://sounds/clickfast.wav",
	whoosh = "rbxasset://sounds/swoosh.wav",
	boom = "rbxasset://sounds/bass.wav",
}

local shakeUntil = 0
local shakeStrength = 0

function Effects.sound(name: string, volume: number?, pitch: number?)
	local id = SOUNDS[name]
	if not id then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.5
	sound.PlaybackSpeed = pitch or 1
	sound.Parent = SoundService
	sound:Play()
	Debris:AddItem(sound, 5)
end

function Effects.shake(strength: number, duration: number)
	shakeStrength = math.max(shakeStrength, strength)
	shakeUntil = math.max(shakeUntil, os.clock() + duration)
end

--- A burst of coloured chunks where the rock broke.
local function burst(position: Vector3, color: Color3, count: number)
	local emitterPart = Instance.new("Part")
	emitterPart.Size = Vector3.new(1, 1, 1)
	emitterPart.Position = position
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.Transparency = 1
	emitterPart.Parent = workspace

	local attachment = Instance.new("Attachment")
	attachment.Parent = emitterPart

	local particles = Instance.new("ParticleEmitter")
	particles.Color = ColorSequence.new(color)
	particles.Size = NumberSequence.new(0.7)
	particles.Lifetime = NumberRange.new(0.35, 0.8)
	particles.Speed = NumberRange.new(9, 20)
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Rate = 0
	particles.Acceleration = Vector3.new(0, -40, 0)
	particles.LightEmission = 1
	particles.LightInfluence = 0
	particles.Parent = attachment
	particles:Emit(count)

	-- A single frame of real light where the rock broke. Cheap, and it is
	-- what makes the break read as an impact rather than a sprite.
	local flash = Instance.new("PointLight")
	flash.Color = color
	flash.Brightness = 6
	flash.Range = 26
	flash.Parent = emitterPart
	TweenService:Create(flash, TweenInfo.new(0.35), { Brightness = 0 }):Play()

	Debris:AddItem(emitterPart, 1.5)
end

--- An expanding ring of light. Reserved for things worth turning around for:
--- a rare pull, a rank up. Everything cheaper uses burst alone.
local function shockwave(position: Vector3, color: Color3, size: number)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Ball
	ring.Size = Vector3.new(2, 2, 2)
	ring.Position = position
	ring.Anchored = true
	ring.CanCollide = false
	ring.CastShadow = false
	ring.Material = Enum.Material.Neon
	ring.Color = color
	ring.Transparency = 0.35
	ring.Parent = workspace

	TweenService:Create(ring, TweenInfo.new(0.55, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Size = Vector3.new(size, size, size),
		Transparency = 1,
	}):Play()

	Debris:AddItem(ring, 0.8)
end

Effects.shockwave = shockwave

--- A tint pulse over the whole screen, on its own grade so it never fights
--- with the depth colour grade Atmosphere is lerping every frame.
local flashGrade: ColorCorrectionEffect
local function flash(color: Color3, strength: number)
	if not flashGrade then
		flashGrade = Instance.new("ColorCorrectionEffect")
		flashGrade.Name = "DeepRushFlash"
		flashGrade.Brightness = 0
		flashGrade.Parent = game:GetService("Lighting")
	end

	flashGrade.TintColor = color
	flashGrade.Brightness = strength
	TweenService:Create(flashGrade, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Brightness = 0,
	}):Play()
end

Effects.flash = flash

--- The floating "+1.2K" that sells the whole game.
local function popNumber(position: Vector3, text: string, color: Color3, scale: number)
	local anchor = Instance.new("Part")
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.Position = position
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.Transparency = 1
	anchor.Parent = workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(8 * scale, 3 * scale)
	billboard.AlwaysOnTop = true
	billboard.Parent = anchor

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextStrokeTransparency = 0.2
	label.Parent = billboard

	TweenService:Create(anchor, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = position + Vector3.new(0, 9, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(1.1), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()

	Debris:AddItem(anchor, 1.3)
end

Effects.popNumber = popNumber

local handlers = {}

handlers.mined = function(payload)
	local tier = Ores.tier(payload.tier)
	local color = Ores.color(payload.tier)

	if payload.position then
		burst(payload.position, color, 14 + math.floor(tier.shake * 20))
		popNumber(payload.position, "+" .. Format.short(payload.value), color, 1 + tier.shake * 0.5)

		-- Epic and up get a ring you can see from the other side of the
		-- shaft, which is also how other players learn that something good
		-- happens down there.
		if tier.shake >= 0.4 then
			shockwave(payload.position, color, 16 + tier.shake * 14)
		end
	end

	Effects.sound("hit", 0.45, 0.9 + math.random() * 0.25)
	if tier.shake > 0 then
		Effects.shake(tier.shake * 1.6, 0.25 + tier.shake * 0.2)
		Effects.sound("ping", 0.5, 1 + tier.shake * 0.3)
		flash(color, math.min(tier.shake, 1) * 0.12)
	end

	-- Luck beating the vein is its own moment, separate from how rare the
	-- result was: a Rare that luck produced should feel different from a Rare
	-- that was simply lying there.
	if payload.lucky then
		Effects.sound("ping", 0.6, 1.6)
		Effects.shake(1.1, 0.28)
		flash(Color3.fromRGB(255, 240, 180), 0.16)
		if payload.position then
			shockwave(payload.position, Color3.fromRGB(255, 235, 160), 22)
		end
	end
end

handlers.swing = function(payload)
	-- One knock per chop, following the same schedule the server animates to.
	-- The pickaxe used to swing in silence and then the rock made one noise as
	-- it vanished, which is backwards: the work should be audible and the
	-- break should be the payoff.
	local chops = math.clamp(tonumber(payload and payload.chops) or 1, 1, 4)
	local duration = tonumber(payload and payload.duration) or 0.5
	local each = duration / chops

	task.spawn(function()
		for index = 1, chops do
			task.wait(each * 0.64)
			-- Each strike a little lower than the last, so a long swing reads
			-- as digging in rather than as a loop.
			Effects.sound("hit", 0.4, 1.08 - index * 0.06 + math.random() * 0.05)
			task.wait(each * 0.36)
		end
	end)
end

handlers.full = function()
	Effects.sound("click", 0.4, 0.7)
end

handlers.bank = function(payload)
	Effects.sound("boom", 0.6, 1.2)
	Effects.shake(0.6, 0.2)
end

handlers.snatch = function()
	Effects.sound("whoosh", 0.7, 1.1)
	Effects.shake(1.2, 0.3)
end

handlers.robbed = function()
	Effects.sound("boom", 0.7, 0.7)
	Effects.shake(2.2, 0.5)
end

handlers.crate = function()
	Effects.sound("ping", 0.6, 1.3)
end

handlers.upgrade = function()
	Effects.sound("ping", 0.5, 1.5)
end

handlers.purchase = function()
	Effects.sound("boom", 0.7, 1.4)
end

handlers.rebirth = function()
	Effects.sound("boom", 0.9, 0.6)
	Effects.shake(3, 1.2)
end

handlers.rift = function()
	Effects.sound("boom", 0.8, 0.9)
	Effects.shake(2, 0.8)
end

handlers.hazardWarn = function()
	Effects.sound("ping", 0.5, 0.5)
	Effects.shake(0.8, 0.9)
end

handlers.hazardHit = function()
	Effects.sound("boom", 0.8, 0.8)
	Effects.shake(3, 0.6)
end

handlers.suffocating = function()
	Effects.shake(1.2, 0.6)
end

handlers.hazardTick = function()
	-- Persistent zones tick several times a second. Anything louder than this
	-- turns standing in gas into a jackhammer.
	Effects.shake(0.35, 0.15)
end

handlers.lift = function()
	Effects.sound("whoosh", 0.6, 0.8)
end

handlers.lifted = function()
	Effects.sound("ping", 0.6, 1.2)
end

function Effects.start()
	Net.listen("Effect", function(kind, payload)
		local handler = handlers[kind]
		if handler then
			local ok, err = pcall(handler, payload or {})
			if not ok then
				warn("DeepRush: effect " .. tostring(kind) .. " failed: " .. tostring(err))
			end
		end
	end)

	-- Camera shake, applied on top of whatever the camera is already doing.
	RunService.RenderStepped:Connect(function(delta)
		if os.clock() > shakeUntil then
			shakeStrength = math.max(0, shakeStrength - delta * 8)
			if shakeStrength <= 0.01 then
				return
			end
		end

		local offset = Vector3.new(
			(math.random() - 0.5) * shakeStrength,
			(math.random() - 0.5) * shakeStrength,
			0
		) * 0.35

		camera.CFrame = camera.CFrame * CFrame.new(offset)
	end)
end

return Effects

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX9">
          <Properties>
            <string name="Name">Hud</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Hud.luau — everything on screen during play.

	Layout priorities, in order:
	  1. DEPTH, dead centre top and huge. It is the score, the progress bar
	     and the brag, all at once.
	  2. CARGO, bottom centre, colour-shifting to red as greed rises. A player
	     must be able to read "I am a target now" without reading a word.
	  3. Contextual actions, bottom right. BANK only exists at the vault,
	     LIFT only on a pad, SNATCH only when someone marked is in range —
	     so the button that is showing is always the button you want.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config.Game)
local Format = require(Shared.Format)
local Layers = require(Shared.Config.Layers)
local Net = require(Shared.Net)
local Ores = require(Shared.Config.Ores)
local Ranks = require(Shared.Config.Ranks)
local ToolConfig = require(Shared.Config.Tools)
local UpgradeConfig = require(Shared.Config.Upgrades)
local RebirthConfig = require(Shared.Config.Rebirth)

local Mining = require(script.Parent.Mining)
local Panels = require(script.Parent.Panels)
local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)

local Hud = {}

local player = Players.LocalPlayer
local theme = Ui.THEME

local widgets = {}
local vaultPart: BasePart? = nil

local function rootPart()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function findVault()
	task.spawn(function()
		while not vaultPart do
			for _, descendant in ipairs(workspace:GetDescendants()) do
				if descendant:IsA("BasePart") and descendant:GetAttribute("Vault") then
					vaultPart = descendant
					return
				end
			end
			task.wait(1)
		end
	end)
end

local function buildTopLeft(parent)
	local holder = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(240, 142),
		position = UDim2.fromOffset(16, 16),
		color = theme.panel,
		transparency = 0.15,
	})
	Ui.stroke(holder, theme.panelLight, 2)
	Ui.padding(holder, 10)

	widgets.cash = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 38),
		text = "💰 0",
		color = theme.gold,
		align = Enum.TextXAlignment.Left,
		font = Enum.Font.GothamBlack,
	})

	-- Rank sits directly under the money, because it is the other number
	-- players compare. It is the one line in this panel that another player
	-- can also see, over your head.
	widgets.rank = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 20),
		position = UDim2.fromOffset(0, 38),
		text = "◆ UNRANKED",
		color = theme.muted,
		align = Enum.TextXAlignment.Left,
		font = Enum.Font.GothamBlack,
		scaled = false,
		textSize = 16,
	})

	widgets.pick = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 18),
		position = UDim2.fromOffset(0, 60),
		text = "⛏️ Rusted Pick",
		color = theme.text,
		align = Enum.TextXAlignment.Left,
		scaled = false,
		textSize = 14,
	})

	widgets.title = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 18),
		position = UDim2.fromOffset(0, 80),
		text = "Surface Rat",
		color = theme.muted,
		align = Enum.TextXAlignment.Left,
		scaled = false,
		textSize = 14,
	})

	local barHolder, barFill, barLabel = Ui.bar({
		parent = holder,
		size = UDim2.new(1, 0, 0, 16),
		position = UDim2.fromOffset(0, 102),
		color = theme.cyan,
		text = "LV 1",
		textSize = 12,
	})
	widgets.xpFill = barFill
	widgets.xpLabel = barLabel

	widgets.rankBar = select(2, Ui.bar({
		parent = holder,
		size = UDim2.new(1, 0, 0, 8),
		position = UDim2.fromOffset(0, 122),
		color = theme.gold,
		text = "",
		textSize = 9,
	}))
end

local function buildTopCenter(parent)
	local holder = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(300, 120),
		position = UDim2.new(0.5, 0, 0, 12),
		anchor = Vector2.new(0.5, 0),
		transparency = 1,
		radius = false,
	})

	widgets.depth = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 62),
		text = "0m",
		color = theme.text,
		font = Enum.Font.GothamBlack,
	})

	widgets.layer = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 22),
		position = UDim2.fromOffset(0, 60),
		text = "Topsoil",
		color = theme.muted,
		scaled = false,
		textSize = 16,
	})

	local _, oxygenFill, oxygenLabel = Ui.bar({
		parent = holder,
		size = UDim2.new(1, -40, 0, 14),
		position = UDim2.new(0.5, 0, 0, 88),
		anchor = Vector2.new(0.5, 0),
		color = theme.cyan,
		text = "AIR",
		textSize = 11,
	})
	widgets.oxygenFill = oxygenFill
	widgets.oxygenLabel = oxygenLabel
end

local function buildRiftChip(parent)
	local chip = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(210, 62),
		position = UDim2.new(1, -16, 0, 16),
		anchor = Vector2.new(1, 0),
		color = theme.panel,
		transparency = 0.15,
	})
	Ui.stroke(chip, theme.accent, 2)
	Ui.padding(chip, 8)

	widgets.riftTitle = Ui.text({
		parent = chip,
		size = UDim2.new(1, 0, 0, 22),
		text = "NEXT RIFT",
		color = theme.accent,
		scaled = false,
		textSize = 15,
	})

	widgets.riftBody = Ui.text({
		parent = chip,
		size = UDim2.new(1, 0, 0, 24),
		position = UDim2.fromOffset(0, 22),
		text = "--:--",
		color = theme.text,
		font = Enum.Font.GothamBlack,
		scaled = false,
		textSize = 20,
	})

	widgets.riftChip = chip

	local season = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(210, 62),
		position = UDim2.new(1, -16, 0, 88),
		anchor = Vector2.new(1, 0),
		color = theme.panel,
		transparency = 0.15,
		visible = false,
	})
	Ui.stroke(season, theme.gold, 2)
	Ui.padding(season, 8)

	widgets.seasonTitle = Ui.text({
		parent = season,
		size = UDim2.new(1, 0, 0, 22),
		text = "SEASON",
		color = theme.gold,
		scaled = false,
		textSize = 15,
	})

	widgets.seasonBody = Ui.text({
		parent = season,
		size = UDim2.new(1, 0, 0, 24),
		position = UDim2.fromOffset(0, 22),
		text = "",
		color = theme.text,
		font = Enum.Font.GothamBlack,
		scaled = false,
		textSize = 19,
	})

	widgets.seasonChip = season
end

local function buildCargo(parent)
	local holder = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(360, 58),
		position = UDim2.new(0.5, 0, 1, -18),
		anchor = Vector2.new(0.5, 1),
		color = theme.panel,
		transparency = 0.15,
	})
	Ui.stroke(holder, theme.panelLight, 2)
	Ui.padding(holder, 8)

	widgets.cargoStroke = holder:FindFirstChildOfClass("UIStroke")
	-- Server/Crew.luau's client half stacks the ping row and crew strip
	-- directly above this, so nothing here may grow downward.

	local _, fill, label = Ui.bar({
		parent = holder,
		size = UDim2.new(1, 0, 0, 22),
		color = theme.green,
		text = "CARGO 0 / 8",
		textSize = 13,
	})
	widgets.cargoFill = fill
	widgets.cargoLabel = label

	widgets.cargoValue = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 18),
		position = UDim2.fromOffset(0, 24),
		text = "worth 0",
		color = theme.muted,
		scaled = false,
		textSize = 14,
	})
end

local function buildMenu(parent)
	local holder = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(124, 236),
		position = UDim2.new(0, 16, 1, -18),
		anchor = Vector2.new(0, 1),
		transparency = 1,
		radius = false,
	})

	local layout = Instance.new("UIGridLayout")
	layout.CellSize = UDim2.fromOffset(58, 50)
	layout.CellPadding = UDim2.fromOffset(6, 6)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = holder

	local entries = {
		{ icon = "⛏️", tab = "shop", color = theme.panelLight },
		{ icon = "📋", tab = "tasks", color = theme.panelLight },
		{ icon = "📜", tab = "contract", color = theme.gold },
		{ icon = "📅", tab = "descent", color = theme.panelLight },
		{ icon = "📖", tab = "codex", color = theme.panelLight },
		{ icon = "✨", tab = "looks", color = theme.panelLight },
		{ icon = "🛠️", tab = "drones", color = theme.panelLight },
		{ icon = "🏆", tab = "boards", color = theme.panelLight },
		{ icon = "🔥", tab = "rebirth", color = theme.accent },
	}

	for index, entry in ipairs(entries) do
		local button = Ui.button({
			parent = holder,
			size = UDim2.fromOffset(58, 50),
			text = entry.icon,
			color = entry.color,
			onClick = function()
				Panels.toggle(entry.tab)
			end,
		})
		button.LayoutOrder = index

		-- The tasks button carries the "you have something to claim" dot,
		-- which is most of why anyone opens the panel at all.
		if entry.tab == "tasks" then
			widgets.taskDot = Ui.frame({
				parent = button,
				size = UDim2.fromOffset(16, 16),
				position = UDim2.new(1, -4, 0, 4),
				anchor = Vector2.new(1, 0),
				color = theme.accent,
				radius = 8,
				z = 5,
				visible = false,
			})
		end
	end
end

local function buildActions(parent)
	local holder = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(180, 280),
		position = UDim2.new(1, -16, 1, -18),
		anchor = Vector2.new(1, 1),
		transparency = 1,
		radius = false,
	})

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Right
	layout.Parent = holder

	widgets.bankButton = Ui.button({
		parent = holder,
		size = UDim2.fromOffset(176, 58),
		text = "💰 BANK",
		color = theme.gold,
		textColor = Color3.fromRGB(30, 24, 10),
		onClick = function()
			Net.fire("Bank")
		end,
		visible = false,
	})

	widgets.liftButton = Ui.button({
		parent = holder,
		size = UDim2.fromOffset(176, 58),
		text = "▲ LIFT UP",
		color = theme.green,
		textColor = Color3.fromRGB(10, 30, 20),
		onClick = function()
			Net.fire("UseLift")
		end,
		visible = false,
	})

	-- Only ever present when Roblox actually has an ad to serve; see
	-- Server/Ads.luau.
	widgets.adButton = Ui.button({
		parent = holder,
		size = UDim2.fromOffset(176, 48),
		text = "🎬 FREE 2x LUCK",
		color = theme.cyan,
		textColor = Color3.fromRGB(10, 20, 26),
		scaled = false,
		visible = false,
		onClick = function()
			Net.fire("WatchAd")
		end,
	})

	-- Always there once you are underground. It is the answer to "I am stuck",
	-- and a player who has ever needed it will look for it again.
	widgets.escapeButton = Ui.button({
		parent = holder,
		size = UDim2.fromOffset(176, 48),
		text = "🆘 EMERGENCY UP",
		color = theme.panelLight,
		stroke = theme.danger,
		scaled = false,
		visible = false,
		onClick = function()
			Net.fire("EmergencyAscent")
		end,
	})

	widgets.grabButton = Ui.button({
		parent = holder,
		size = UDim2.fromOffset(176, 58),
		text = "📦 GRAB CARGO",
		color = theme.gold,
		textColor = Color3.fromRGB(30, 24, 10),
		onClick = function()
			if widgets.nearestCrateId then
				Net.fire("GrabCrate", widgets.nearestCrateId)
			end
		end,
		visible = false,
	})

	widgets.snatchButton = Ui.button({
		parent = holder,
		size = UDim2.fromOffset(176, 58),
		text = "🫳 SNATCH",
		color = theme.accent,
		onClick = function()
			Net.fire("Snatch")
		end,
		visible = false,
	})

	-- Touch devices get an explicit mine button; mouse players hold LMB.
	if UserInputService.TouchEnabled then
		local mineButton = Ui.button({
			parent = holder,
			size = UDim2.fromOffset(176, 74),
			text = "⛏️ MINE",
			color = theme.panelLight,
			stroke = theme.cyan,
		})
		mineButton.MouseButton1Down:Connect(function()
			Mining.setHolding(true)
		end)
		mineButton.MouseButton1Up:Connect(function()
			Mining.setHolding(false)
		end)
		mineButton.MouseLeave:Connect(function()
			Mining.setHolding(false)
		end)
	end
end

local function buildReticle(parent)
	local holder = Ui.frame({
		parent = parent,
		size = UDim2.fromOffset(180, 40),
		position = UDim2.new(0.5, 0, 0.5, 40),
		anchor = Vector2.new(0.5, 0.5),
		transparency = 1,
		radius = false,
	})

	widgets.reticle = Ui.text({
		parent = holder,
		size = UDim2.new(1, 0, 0, 18),
		text = "",
		color = theme.muted,
		scaled = false,
		textSize = 14,
	})

	local _, fill = Ui.bar({
		parent = holder,
		size = UDim2.new(1, 0, 0, 8),
		position = UDim2.fromOffset(0, 22),
		color = theme.gold,
		radius = 4,
	})
	widgets.swingFill = fill
	widgets.swingHolder = fill.Parent
	widgets.swingHolder.Visible = false
end

-- Rendering ----------------------------------------------------------------

local function renderState()
	local data = State.data

	widgets.cash.Text = "💰 " .. Format.short(data.cash)
	widgets.title.Text = RebirthConfig.title(data.rebirths or 0)
		.. (data.rebirths > 0 and `  ·  R{data.rebirths}` or "")

	-- Rank comes from lifetime banked, which the server already pushes for
	-- the stats panel, so the badge and its bar cost no extra traffic.
	local banked = (data.stats and data.stats.bankedTotal) or 0
	local rank = Ranks.at(banked)
	local upcoming = Ranks.next(banked)
	widgets.rank.Text = `{rank.icon} {string.upper(rank.name)}`
	widgets.rank.TextColor3 = Ranks.color(rank.id)
	widgets.rankBar.Size = UDim2.fromScale(Ranks.progress(banked), 1)
	widgets.rankBar.BackgroundColor3 = upcoming and Ranks.color(upcoming.id) or Ranks.color(rank.id)

	local drill = (data.upgrades and data.upgrades.drill) or 0
	local swing = math.max(Config.MinMineTime, Config.BaseMineTime * (1 - UpgradeConfig.value("drill", drill)))
	widgets.pick.Text = `⛏️ {ToolConfig.tierFor(drill).name}  ·  {string.format("%.2f", swing)}s`

	local needed = math.floor(Config.BaseXpToLevel * (Config.LevelCurve ^ ((data.level or 1) - 1)))
	widgets.xpFill.Size = UDim2.fromScale(math.clamp((data.xp or 0) / needed, 0, 1), 1)
	widgets.xpLabel.Text = `LV {data.level or 1}`

	local capacity = data.cargo.capacity or 8
	local ratio = math.clamp((data.cargo.count or 0) / capacity, 0, 1)
	widgets.cargoFill.Size = UDim2.fromScale(ratio, 1)
	widgets.cargoLabel.Text = `CARGO {data.cargo.count or 0} / {capacity}`
	widgets.cargoValue.Text = "worth " .. Format.short(data.cargo.value or 0)

	-- Anything claimable lights the dot on the tasks button.
	if widgets.taskDot then
		local board = data.questBoard or {}
		local claimable = false
		if board.onboarding and board.onboarding.progress >= board.onboarding.target then
			claimable = true
		end
		for _, list in ipairs({ board.daily or {}, board.milestones or {} }) do
			for _, quest in ipairs(list) do
				if not quest.claimed and quest.progress >= quest.target then
					claimable = true
				end
			end
		end
		widgets.taskDot.Visible = claimable
	end

	local marked = ratio >= Config.GreedMarkThreshold
	widgets.cargoFill.BackgroundColor3 = marked and theme.accent or theme.green
	if widgets.cargoStroke then
		widgets.cargoStroke.Color = marked and theme.accent or theme.panelLight
	end
	if marked then
		widgets.cargoValue.Text = `worth {Format.short(data.cargo.value or 0)}  ·  ⚠ MARKED — you can be snatched`
		widgets.cargoValue.TextColor3 = theme.accent
	else
		widgets.cargoValue.TextColor3 = theme.muted
	end
end

local function renderRift()
	local rift = State.rift or {}
	if rift.active then
		widgets.riftTitle.Text = rift.mine and "⚡ RIFT — YOU'RE IN IT" or "⚡ RIFT OPEN"
		widgets.riftTitle.TextColor3 = rift.mine and theme.green or theme.accent
		widgets.riftBody.Text = `{rift.layer or "?"} · {Format.clock(rift.remaining or 0)}`
	else
		widgets.riftTitle.Text = "NEXT RIFT"
		widgets.riftTitle.TextColor3 = theme.muted
		widgets.riftBody.Text = Format.clock(rift.nextIn or 0)
	end
end

local function renderContextual()
	local root = rootPart()
	if not root then
		return
	end

	local nearVault = vaultPart ~= nil
		and (root.Position - vaultPart.Position).Magnitude <= Config.BankRadius
	widgets.bankButton.Visible = nearVault and (State.data.cargo.count or 0) > 0

	local onPad = false
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, 12)) do
		if part:GetAttribute("LiftPad") then
			onPad = true
			break
		end
	end
	widgets.liftButton.Visible = onPad

	-- Hidden on a pad, because there the fast option is right there.
	widgets.escapeButton.Visible = (State.data.depth or 0) > 20 and not onPad

	-- Dropped crates: the server has always accepted the pickup, but until
	-- now nothing on screen asked for it.
	local nearestCrate, nearestDistance = nil, 14
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, 14)) do
		local crateId = part:GetAttribute("CrateId")
		if crateId then
			local distance = (part.Position - root.Position).Magnitude
			if distance < nearestDistance then
				nearestCrate, nearestDistance = crateId, distance
			end
		end
	end
	widgets.nearestCrateId = nearestCrate
	widgets.grabButton.Visible = nearestCrate ~= nil

	-- Snatch shows only when a marked player is actually in range.
	local snatchable = false
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and State.marked[other.UserId] then
			local otherRoot = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot and (otherRoot.Position - root.Position).Magnitude <= Config.SnatchRange then
				snatchable = true
				break
			end
		end
	end
	widgets.snatchButton.Visible = snatchable

	local depth = State.data.depth or 0
	widgets.depth.Text = Format.depth(depth)
	local layer = Layers.at(depth)
	widgets.layer.Text = string.upper(layer.name)

	local oxygenRatio = math.clamp((State.data.oxygen or 0) / math.max(State.data.oxygenMax or 60, 1), 0, 1)
	widgets.oxygenFill.Size = UDim2.fromScale(oxygenRatio, 1)
	widgets.oxygenFill.BackgroundColor3 = oxygenRatio < 0.25 and theme.danger or theme.cyan
	widgets.oxygenLabel.Text = oxygenRatio >= 0.999 and "AIR OK"
		or `AIR {math.floor(oxygenRatio * 100)}%`

	local progress = Mining.progress()
	widgets.swingHolder.Visible = progress > 0
	widgets.swingFill.Size = UDim2.fromScale(progress, 1)

	-- The reticle names what you are aiming at. The node already shows its
	-- ore in the rock; this is the confirmation, in words, that the blue
	-- glitter over there really is a diamond and not a quartz.
	local aim = Mining.target()
	if aim then
		local ore = Ores.ById[aim:GetAttribute("Ore") or ""]
		local tier = Ores.tier(aim:GetAttribute("Tier") or "Common")
		widgets.reticle.Text = progress > 0 and "MINING..."
			or (ore and `◈ {ore.name}  ·  {string.upper(ore.tier)}` or "◈ HOLD TO MINE")
		widgets.reticle.TextColor3 = Color3.fromRGB(tier.color[1], tier.color[2], tier.color[3])
	else
		widgets.reticle.Text = ""
	end
end

function Hud.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DeepRushHud"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = player:WaitForChild("PlayerGui")

	buildTopLeft(gui)
	buildTopCenter(gui)
	buildRiftChip(gui)
	buildCargo(gui)
	buildMenu(gui)
	buildActions(gui)
	buildReticle(gui)

	findVault()

	Net.listen("Season", function(state)
		if typeof(state) ~= "table" or not widgets.seasonChip then
			return
		end

		if state.open then
			-- While the window is live this is the most important thing on
			-- screen after depth, so it gets the loud colour and the count.
			widgets.seasonChip.Visible = true
			widgets.seasonTitle.Text = state.badge and "🏅 BADGE SECURED" or "🏅 SEASON OPEN"
			widgets.seasonTitle.TextColor3 = state.badge and theme.green or theme.gold
			widgets.seasonBody.Text = state.badge
				and `{state.label or ""} · yours`
				or `{state.cores or 0}/{state.requirement or 0} · {Format.clock(state.seconds or 0)} left`
		elseif (state.seconds or 0) < 86400 * 2 then
			-- Only advertise the next window when it is close enough to plan
			-- around. A five-day countdown is noise.
			widgets.seasonChip.Visible = true
			widgets.seasonTitle.Text = "SEASON WINDOW IN"
			widgets.seasonTitle.TextColor3 = theme.muted
			widgets.seasonBody.Text = Format.clock(state.seconds or 0)
		else
			widgets.seasonChip.Visible = false
		end
	end)

	Net.listen("Ad", function(payload)
		if typeof(payload) == "table" and widgets.adButton then
			widgets.adButton.Visible = payload.available == true
		end
	end)

	State.changed:connect(renderState)
	State.riftChanged:connect(renderRift)
	renderState()
	renderRift()

	RunService.RenderStepped:Connect(renderContextual)
end

return Hud

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX10">
          <Properties>
            <string name="Name">Intro</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Intro.luau — the rules card, shown before the first dig.

	Six lines, each one a rule a player would otherwise have to lose something
	to learn. It is the cheapest retention work in the game: the platform
	grades a new experience hardest on whether anyone comes back the next day,
	and most of the reasons they do not are simply not knowing what the game
	wanted from them.

	Rules for the rules:
	  * Six lines, no paragraphs. Anything longer gets skipped, and a skipped
	    tutorial is worse than none because it costs the click as well.
	  * Every line is a verb. "Hold to mine", not "Mining is done by holding".
	  * It appears once. The flag lives on the profile, so it does not come
	    back on a new device or after a rejoin.
	  * It stays reachable. The "?" button re-opens it, because the person who
	    needs it most is the one who skipped it.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)

local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)

local Intro = {}

local player = Players.LocalPlayer
local theme = Ui.THEME

local gui: ScreenGui
local card: Frame
local shown = false

local RULES = {
	{ icon = "⛏️", title = "THE ROCK SHOWS WHAT IS IN IT", body = "Gold, silver, diamond — each one has its own colour and glow in the wall. Look at one and hold to mine it." },
	{ icon = "⬇️", title = "DEEPER PAYS MORE", body = "Every metre multiplies what the rock is worth. 1,400m ore is not 1,400m of walking — it is a different game." },
	{ icon = "💰", title = "BANK IT OR LOSE IT", body = "Cargo is not yours until you ride a lift up and deposit it at the vault." },
	{ icon = "⚠️", title = "A FULL HOLD MAKES YOU A TARGET", body = "Past 60% you glow, and other miners can snatch from you. Bank early and nobody can touch you." },
	{ icon = "☣️", title = "WALK AROUND THE GLOWING ZONES", body = "Gas, vents and frost are visible and named. The pulsing ones have a rhythm you can walk through." },
	{ icon = "▲", title = "LIFTS ARE THE ONLY WAY UP", body = "Falling is free and fast. Climbing back is the part you pay for — plan the trip. Stuck? Stand still and hold Emergency Ascent." },
	{ icon = "◈", title = "RANK IS FOREVER", body = "Everything you ever bank counts toward your rank, and it never goes down. It is written over your head for everyone to read." },
}

local function buildCard(parent)
	local holder = Ui.frame({
		parent = parent,
		size = UDim2.new(0.62, 0, 0.86, 0),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		color = theme.bg,
		radius = 20,
	})
	Ui.stroke(holder, theme.gold, 3)

	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = Vector2.new(340, 380)
	constraint.MaxSize = Vector2.new(720, 860)
	constraint.Parent = holder

	Ui.text({
		parent = holder,
		size = UDim2.new(1, -40, 0, 32),
		position = UDim2.fromOffset(28, 22),
		text = "⛏ DEEP RUSH",
		color = theme.gold,
		align = Enum.TextXAlignment.Left,
		font = Enum.Font.GothamBold,
		scaled = false,
		textSize = 22,
	})

	Ui.text({
		parent = holder,
		size = UDim2.new(1, -40, 0, 46),
		position = UDim2.fromOffset(28, 52),
		text = "SEVEN THINGS AND YOU'RE READY",
		color = theme.text,
		align = Enum.TextXAlignment.Left,
		font = Enum.Font.GothamBlack,
		scaled = false,
		textSize = 34,
	})

	local list = Instance.new("ScrollingFrame")
	list.Size = UDim2.new(1, -48, 1, -190)
	list.Position = UDim2.fromOffset(24, 108)
	list.BackgroundTransparency = 1
	list.BorderSizePixel = 0
	list.ScrollBarThickness = 5
	list.ScrollBarImageColor3 = theme.panelLight
	list.AutomaticCanvasSize = Enum.AutomaticSize.Y
	list.CanvasSize = UDim2.new()
	list.Parent = holder

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list

	for index, rule in ipairs(RULES) do
		local row = Ui.frame({
			parent = list,
			size = UDim2.new(1, -6, 0, 74),
			color = theme.panel,
		})
		row.LayoutOrder = index
		Ui.stroke(row, theme.panelLight, 2)
		Ui.padding(row, 10)

		Ui.text({
			parent = row,
			size = UDim2.fromOffset(44, 44),
			position = UDim2.fromOffset(0, 4),
			text = rule.icon,
			scaled = true,
		})

		Ui.text({
			parent = row,
			size = UDim2.new(1, -56, 0, 22),
			position = UDim2.fromOffset(54, 0),
			text = rule.title,
			color = theme.gold,
			align = Enum.TextXAlignment.Left,
			scaled = false,
			textSize = 18,
		})

		Ui.text({
			parent = row,
			size = UDim2.new(1, -56, 0, 32),
			position = UDim2.fromOffset(54, 22),
			text = rule.body,
			color = theme.muted,
			align = Enum.TextXAlignment.Left,
			valign = Enum.TextYAlignment.Top,
			scaled = false,
			textSize = 14,
			wrap = true,
		})
	end

	Ui.button({
		parent = holder,
		size = UDim2.new(1, -48, 0, 60),
		position = UDim2.new(0.5, 0, 1, -20),
		anchor = Vector2.new(0.5, 1),
		text = "⛏  START DIGGING",
		color = theme.gold,
		textColor = Color3.fromRGB(28, 22, 8),
		scaled = false,
		onClick = function()
			Intro.hide(true)
		end,
	})

	return holder
end

function Intro.show()
	if shown then
		return
	end
	shown = true
	gui.Enabled = true

	card.Size = UDim2.new(0.55, 0, 0.78, 0)
	card.BackgroundTransparency = 1
	TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0.62, 0, 0.86, 0),
		BackgroundTransparency = 0,
	}):Play()
end

function Intro.hide(remember: boolean?)
	if not shown then
		return
	end
	shown = false

	local out = TweenService:Create(card, TweenInfo.new(0.22), {
		BackgroundTransparency = 1,
		Size = UDim2.new(0.55, 0, 0.78, 0),
	})
	out:Play()
	out.Completed:Once(function()
		gui.Enabled = false
	end)

	if remember then
		Net.fire("IntroSeen")
	end
end

function Intro.start()
	gui = Instance.new("ScreenGui")
	gui.Name = "DeepRushIntro"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 20
	gui.IgnoreGuiInset = true
	gui.Enabled = false
	gui.Parent = player:WaitForChild("PlayerGui")

	local dim = Ui.frame({
		parent = gui,
		size = UDim2.fromScale(1, 1),
		color = Color3.fromRGB(0, 0, 0),
		transparency = 0.35,
		radius = false,
	})
	dim.ZIndex = 1

	card = buildCard(gui)
	card.ZIndex = 2

	-- The person who most needs the rules is the one who skipped them, so
	-- they stay one tap away.
	local help = Instance.new("ScreenGui")
	help.Name = "DeepRushHelpButton"
	help.ResetOnSpawn = false
	help.DisplayOrder = 4
	help.Parent = player:WaitForChild("PlayerGui")

	Ui.button({
		parent = help,
		size = UDim2.fromOffset(44, 44),
		position = UDim2.new(0, 258, 0, 16),
		text = "?",
		color = theme.panel,
		stroke = theme.panelLight,
		onClick = function()
			if shown then
				Intro.hide(false)
			else
				Intro.show()
			end
		end,
	})

	-- Wait for the first state snapshot before deciding: showing the card to a
	-- returning player who already dismissed it is the exact opposite of the
	-- point.
	task.spawn(function()
		for _ = 1, 60 do
			if State.data.seenIntro ~= nil then
				break
			end
			task.wait(0.25)
		end
		if not State.data.seenIntro then
			Intro.show()
		end
	end)
end

return Intro

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX11">
          <Properties>
            <string name="Name">Mining</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Mining.luau (client) — targeting and input.

	Targeting rule: among the nodes in reach, pick the one closest to where
	the camera is looking, not the one closest to the body. On a phone the
	camera IS the aim, and "nearest to me" picks the rock behind your feet.

	The client never decides that a rock broke. It asks, the server times the
	swing and answers. Everything here is presentation plus intent.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Ores = require(Shared.Config.Ores)
local Config = require(Shared.Config.Game)
local Net = require(Shared.Net)

local State = require(script.Parent.State)

local Mining = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local holding = false
local swingEndsAt = 0
local swingDuration = 0
local target = nil
local highlight: Highlight

local RETRY_GAP = 0.15 -- kept comfortably under the server's 12/s limit

local function rootPart()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

--- Nodes in reach, scored by how close they are to the camera's aim.
local function findTarget()
	local root = rootPart()
	if not root then
		return nil
	end

	local origin = camera.CFrame.Position
	local look = camera.CFrame.LookVector

	local best, bestScore = nil, -1
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, Config.MineReach)) do
		if part:GetAttribute("NodeId") and part.Transparency < 1 then
			local toPart = (part.Position - origin)
			local distance = toPart.Magnitude
			if distance > 0.1 then
				local alignment = toPart.Unit:Dot(look)
				-- Require it to be roughly in front, then prefer centred.
				if alignment > 0.35 then
					local score = alignment - (distance / Config.MineReach) * 0.25
					if score > bestScore then
						best, bestScore = part, score
					end
				end
			end
		end
	end

	return best
end

function Mining.setHolding(value: boolean)
	holding = value
end

function Mining.isHolding(): boolean
	return holding
end

function Mining.target()
	return target
end

--- 0..1 progress of the current swing, for the HUD ring.
function Mining.progress(): number
	if swingDuration <= 0 or os.clock() >= swingEndsAt then
		return 0
	end
	return 1 - ((swingEndsAt - os.clock()) / swingDuration)
end

local lastRequest = 0

local function tick()
	target = findTarget()

	if highlight then
		highlight.Adornee = target
		highlight.Enabled = target ~= nil
		-- Tinted to the tier the node is showing, so the outline confirms
		-- what you were already looking at rather than washing it out.
		if target then
			local tier = Ores.tier(target:GetAttribute("Tier") or "Common")
			local color = Color3.fromRGB(tier.color[1], tier.color[2], tier.color[3])
			highlight.FillColor = color
			highlight.OutlineColor = color:Lerp(Color3.fromRGB(255, 255, 255), 0.55)
			highlight.FillTransparency = 0.82 - math.min(tier.glow, 1) * 0.18
		end
	end

	local autoMine = State.data.gamepasses and State.data.gamepasses.autodrill
	local wantsToMine = holding or autoMine == true

	if not wantsToMine or not target then
		return
	end

	-- A full hold means the server will refuse anyway; asking anyway just
	-- burns the rate limit and hides real requests behind it.
	local cargo = State.data.cargo
	if cargo and (cargo.count or 0) >= (cargo.capacity or math.huge) then
		return
	end
	if os.clock() < swingEndsAt then
		return
	end
	if os.clock() - lastRequest < RETRY_GAP then
		return
	end

	lastRequest = os.clock()
	Net.fire("Mine", target:GetAttribute("NodeId"))
end

function Mining.start()
	highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 220, 130)
	highlight.FillTransparency = 0.75
	highlight.OutlineColor = Color3.fromRGB(255, 240, 190)
	highlight.OutlineTransparency = 0
	highlight.Enabled = false
	highlight.Parent = workspace

	-- The server tells us how long this swing takes; we render the bar.
	Net.listen("Effect", function(kind, payload)
		if kind == "swing" and payload and payload.duration then
			swingDuration = payload.duration
			swingEndsAt = os.clock() + payload.duration
		elseif kind == "mined" or kind == "full" then
			swingEndsAt = 0
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holding = false
		end
	end)

	-- Keyboard/gamepad alternative so the game is playable without aiming.
	ContextActionService:BindAction("DeepRushMine", function(_, inputState)
		holding = inputState == Enum.UserInputState.Begin
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.E, Enum.KeyCode.ButtonR2)

	RunService.Heartbeat:Connect(tick)
end

return Mining

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX12">
          <Properties>
            <string name="Name">Notify</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Notify.luau — toasts and the rare-pull reveal card.

	The reveal card is the single most important 1.5 seconds in the game. It
	is what a player screenshots, what they clip, and what makes a friend ask
	what they are playing. So it gets the tier colour, the real odds, and a
	deliberate slam-in animation rather than a polite fade.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)
local Mutations = require(Shared.Config.Mutations)
local Net = require(Shared.Net)
local Ores = require(Shared.Config.Ores)

local Effects = require(script.Parent.Effects)
local Ui = require(script.Parent.Ui)

local Notify = {}

local player = Players.LocalPlayer
local theme = Ui.THEME

local toastHolder: Frame
local revealHolder: Frame

local KIND_COLOR = {
	cash = theme.gold,
	quest = theme.cyan,
	error = theme.danger,
	steal = theme.accent,
	upgrade = theme.green,
	rift = theme.accent,
	level = theme.cyan,
	announce = theme.gold,
}

local MAX_TOASTS = 5

local function pushToast(payload)
	if typeof(payload) ~= "table" then
		return
	end

	-- Oldest first out, so a burst of pickups cannot bury the screen.
	local existing = {}
	for _, child in ipairs(toastHolder:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(existing, child)
		end
	end
	if #existing >= MAX_TOASTS then
		existing[1]:Destroy()
	end

	local accent = KIND_COLOR[payload.kind or "cash"] or theme.cyan
	if payload.color then
		accent = Color3.fromRGB(payload.color[1], payload.color[2], payload.color[3])
	end

	local card = Ui.frame({
		parent = toastHolder,
		size = UDim2.new(1, 0, 0, 62),
		color = theme.panel,
	})
	Ui.stroke(card, accent, 2)
	Ui.padding(card, 8)

	Ui.text({
		parent = card,
		size = UDim2.new(1, 0, 0, 24),
		text = tostring(payload.title or ""),
		color = accent,
		align = Enum.TextXAlignment.Left,
		scaled = false,
		textSize = 18,
	})

	Ui.text({
		parent = card,
		size = UDim2.new(1, 0, 0, 22),
		position = UDim2.fromOffset(0, 24),
		text = tostring(payload.body or ""),
		color = theme.muted,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		scaled = false,
		textSize = 14,
		wrap = true,
	})

	card.Position = UDim2.fromOffset(340, 0)
	TweenService:Create(card, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.fromOffset(0, 0),
	}):Play()

	if payload.kind ~= "error" then
		Effects.sound("ping", 0.35, 1.2)
	end

	task.delay(payload.duration or 3.5, function()
		if not card.Parent then
			return
		end
		local out = TweenService:Create(card, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
		out:Play()
		out.Completed:Wait()
		card:Destroy()
	end)
end

local function showReveal(payload)
	if typeof(payload) ~= "table" then
		return
	end

	revealHolder:ClearAllChildren()

	local tierColor = payload.tier and Ores.color(payload.tier) or theme.gold
	local mutationColor = Mutations.color(payload.mutation)

	local card = Ui.frame({
		parent = revealHolder,
		size = UDim2.fromScale(1, 1),
		color = theme.bg,
		transparency = 0.05,
		radius = 18,
	})
	Ui.stroke(card, mutationColor or tierColor, 4)
	Ui.padding(card, 14)

	Ui.text({
		parent = card,
		size = UDim2.new(1, 0, 0, 26),
		text = tostring(payload.title or "RARE PULL"),
		color = theme.muted,
		scaled = false,
		textSize = 17,
	})

	Ui.text({
		parent = card,
		size = UDim2.new(1, 0, 0, 54),
		position = UDim2.fromOffset(0, 26),
		text = tostring(payload.name or ""),
		color = mutationColor or tierColor,
		font = Enum.Font.GothamBlack,
		scaled = false,
		textSize = 36,
	})

	local subtitle = payload.tier and string.upper(payload.tier) or ""
	if payload.lucky then
		-- Luck is a second roll on top of what the node was showing, so when
		-- it fires the card says so. An invisible curve nobody can point at
		-- is the one thing a rarity game must not have.
		subtitle = "⚡ LUCK BEAT THE VEIN  ·  " .. subtitle
	end
	if payload.value then
		subtitle ..= `  ·  {Format.short(payload.value)}`
	end
	if payload.odds and payload.odds > 0 then
		subtitle ..= `  ·  {Format.odds(payload.odds)}`
	end

	Ui.text({
		parent = card,
		size = UDim2.new(1, 0, 0, 26),
		position = UDim2.fromOffset(0, 82),
		text = subtitle,
		color = tierColor,
		scaled = false,
		textSize = 18,
	})

	if payload.body then
		Ui.text({
			parent = card,
			size = UDim2.new(1, 0, 0, 30),
			position = UDim2.fromOffset(0, 108),
			text = tostring(payload.body),
			color = theme.muted,
			scaled = false,
			textSize = 14,
			wrap = true,
		})
	end

	-- Slam in, hold, drop out.
	card.Size = UDim2.fromScale(1.35, 1.35)
	card.Position = UDim2.fromScale(-0.17, -0.17)
	TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromScale(0, 0),
	}):Play()

	Effects.sound("reveal", 0.7, 1)
	Effects.shake(1.4, 0.3)
	-- The card is the moment; the screen should agree with it. Rank ups get
	-- the hardest pulse in the game, because they happen about ten times in a
	-- player's entire history.
	Effects.flash(payload.kind == "rank" and theme.gold or (mutationColor or tierColor), payload.kind == "rank" and 0.3 or 0.18)

	task.delay(3.2, function()
		if card.Parent then
			local out = TweenService:Create(card, TweenInfo.new(0.3), { BackgroundTransparency = 1 })
			out:Play()
			out.Completed:Wait()
			card:Destroy()
		end
	end)
end

function Notify.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DeepRushNotify"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 10
	gui.Parent = player:WaitForChild("PlayerGui")

	toastHolder = Ui.frame({
		parent = gui,
		size = UDim2.fromOffset(320, 400),
		position = UDim2.new(1, -16, 0, 92),
		anchor = Vector2.new(1, 0),
		transparency = 1,
		radius = false,
	})

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.VerticalAlignment = Enum.VerticalAlignment.Top
	layout.Parent = toastHolder

	revealHolder = Ui.frame({
		parent = gui,
		size = UDim2.fromOffset(440, 160),
		position = UDim2.fromScale(0.5, 0.32),
		anchor = Vector2.new(0.5, 0.5),
		transparency = 1,
		radius = false,
	})

	Net.listen("Toast", pushToast)
	Net.listen("Reveal", showReveal)
end

return Notify

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX13">
          <Properties>
            <string name="Name">Onboarding</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Onboarding.luau — the first two minutes.

	Roblox decides whether a game lives on D1 retention, and D1 is mostly
	settled before a new player has been in the world for three minutes. So a
	first-timer is never allowed to wonder what to do: there is one objective
	on screen and one waypoint in the world pointing at it, and both follow
	the server's onboarding quest chain rather than a separate script that
	could drift out of sync with it.

	It removes itself the moment the chain is done. A tutorial that overstays
	is worse than no tutorial.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Format = require(Shared.Format)

local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)

local Onboarding = {}

local player = Players.LocalPlayer
local theme = Ui.THEME

local banner: Frame
local titleLabel: TextLabel
local bodyLabel: TextLabel
local waypoint: BasePart
local waypointLabel: TextLabel

--- Where the player should be looking right now, per onboarding step.
local WAYPOINTS = {
	ob_mine = { kind = "shaft", text = "▼ JUMP IN & MINE" },
	ob_bank = { kind = "vault", text = "▼ BANK HERE" },
	ob_upgrade = { kind = "none" },
	ob_depth = { kind = "shaft", text = "▼ GO DEEPER" },
	ob_rare = { kind = "shaft", text = "▼ DIG DEEPER FOR RARES" },
	ob_deep = { kind = "shaft", text = "▼ FILL YOUR HOLD" },
}

local vaultPart: BasePart? = nil

local function rootPart()
	local character = player.Character
	return character and character:FindFirstChild("HumanoidRootPart")
end

local function findVault()
	if vaultPart and vaultPart.Parent then
		return vaultPart
	end
	for _, descendant in ipairs(workspace:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant:GetAttribute("Vault") then
			vaultPart = descendant
			return vaultPart
		end
	end
	return nil
end

--- Nearest lift pad, used once the hold is full and the player is deep.
local function nearestLift()
	local root = rootPart()
	if not root then
		return nil
	end
	local best, bestDistance = nil, math.huge
	for _, part in ipairs(workspace:GetPartBoundsInRadius(root.Position, 260)) do
		if part:GetAttribute("LiftPad") then
			local distance = (part.Position - root.Position).Magnitude
			if distance < bestDistance then
				best, bestDistance = part, distance
			end
		end
	end
	return best
end

local function currentStep()
	local board = State.data.questBoard
	return board and board.onboarding or nil
end

local function update()
	local step = currentStep()

	if not step then
		banner.Visible = false
		waypoint.Transparency = 1
		waypointLabel.Visible = false
		return
	end

	banner.Visible = true
	titleLabel.Text = `STEP {step.index}/{step.total} — {step.name}`
	bodyLabel.Text = `{step.desc}   ({Format.short(step.progress)}/{Format.short(step.target)})`
	if step.progress >= step.target then
		bodyLabel.Text = "DONE — open 📋 Tasks to claim your reward"
		bodyLabel.TextColor3 = theme.green
	else
		bodyLabel.TextColor3 = theme.muted
	end

	-- Waypoint: a full hold overrides the scripted step, because "get back
	-- up" is genuinely the right advice at that moment.
	local root = rootPart()
	if not root then
		return
	end

	-- 60%, not full. Waiting for a full hold meant the arrow to the way out
	-- only appeared once the player had already stopped being able to mine,
	-- and "can I even get back up?" is a question people ask well before
	-- that. Sixty is also where the greed mark makes you a target, so it is
	-- the moment surfacing starts being the right call anyway.
	local capacity = State.data.cargo.capacity or 8
	local loaded = (State.data.cargo.count or 0) >= capacity * 0.6
	local depth = State.data.depth or 0

	local targetPosition, text
	if loaded and depth > 20 then
		local lift = nearestLift()
		if lift then
			targetPosition, text = lift.Position + Vector3.new(0, 6, 0), "▼ RIDE UP"
		end
	end

	if not targetPosition then
		local config = WAYPOINTS[step.id] or { kind = "none" }
		if config.kind == "vault" then
			local vault = findVault()
			if vault then
				targetPosition, text = vault.Position + Vector3.new(0, 12, 0), config.text
			end
		elseif config.kind == "shaft" and depth < 12 then
			targetPosition, text = Vector3.new(0, 6, 0), config.text
		end
	end

	if targetPosition then
		waypoint.Position = targetPosition
		waypoint.Transparency = 1
		waypointLabel.Text = text or "▼"
		waypointLabel.Visible = true
	else
		waypointLabel.Visible = false
	end
end

function Onboarding.start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "DeepRushOnboarding"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 3
	gui.Parent = player:WaitForChild("PlayerGui")

	banner = Ui.frame({
		parent = gui,
		size = UDim2.fromOffset(420, 62),
		position = UDim2.new(0.5, 0, 0, 142),
		anchor = Vector2.new(0.5, 0),
		color = theme.panel,
		transparency = 0.1,
		visible = false,
	})
	Ui.stroke(banner, theme.cyan, 2)
	Ui.padding(banner, 8)

	titleLabel = Ui.text({
		parent = banner,
		size = UDim2.new(1, 0, 0, 22),
		text = "",
		color = theme.cyan,
		scaled = false,
		textSize = 16,
	})

	bodyLabel = Ui.text({
		parent = banner,
		size = UDim2.new(1, 0, 0, 22),
		position = UDim2.fromOffset(0, 22),
		text = "",
		color = theme.muted,
		scaled = false,
		textSize = 14,
	})

	waypoint = Instance.new("Part")
	waypoint.Name = "OnboardingWaypoint"
	waypoint.Size = Vector3.new(1, 1, 1)
	waypoint.Anchored = true
	waypoint.CanCollide = false
	waypoint.Transparency = 1
	waypoint.Parent = workspace

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromScale(14, 4)
	billboard.AlwaysOnTop = true
	billboard.Parent = waypoint

	waypointLabel = Instance.new("TextLabel")
	waypointLabel.Size = UDim2.fromScale(1, 1)
	waypointLabel.BackgroundTransparency = 1
	waypointLabel.Font = Enum.Font.GothamBlack
	waypointLabel.TextColor3 = theme.cyan
	waypointLabel.TextScaled = true
	waypointLabel.TextStrokeTransparency = 0.3
	waypointLabel.Visible = false
	waypointLabel.Parent = billboard

	State.changed:connect(update)

	-- The waypoint tracks a moving player, so it needs its own slow tick
	-- rather than only updating when state changes.
	task.spawn(function()
		while true do
			task.wait(0.5)
			local ok, err = pcall(update)
			if not ok then
				warn("DeepRush: onboarding update failed: " .. tostring(err))
			end
		end
	end)
end

return Onboarding

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX14">
          <Properties>
            <string name="Name">Panels</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Panels.luau — every full-screen menu, behind one tab switcher.

	Content is rebuilt on open rather than kept live. A mining game's menus
	are read for a few seconds at a time, and rebuilding 30 rows costs far
	less than keeping six panels subscribed to every state patch.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local ContractConfig = require(Shared.Config.Contracts)
local CosmeticConfig = require(Shared.Config.Cosmetics)
local DroneConfig = require(Shared.Config.Drones)
local Format = require(Shared.Format)
local Layers = require(Shared.Config.Layers)
local Net = require(Shared.Net)
local Ores = require(Shared.Config.Ores)
local ProductConfig = require(Shared.Config.Products)
local RebirthConfig = require(Shared.Config.Rebirth)
local Ranks = require(Shared.Config.Ranks)
local UpgradeConfig = require(Shared.Config.Upgrades)

local State = require(script.Parent.State)
local Ui = require(script.Parent.Ui)

local Panels = {}

local player = Players.LocalPlayer
local theme = Ui.THEME

local gui: ScreenGui
local window: Frame
local titleLabel: TextLabel
local content: ScrollingFrame
local currentTab: string? = nil

local TAB_TITLES = {
	contract = "WEEKLY CONTRACT",
	descent = "DESCENT LOG",
	looks = "APPEARANCE",
	shop = "UPGRADES",
	tasks = "TASKS",
	codex = "ORE CODEX",
	drones = "DRONES",
	boards = "LEADERBOARDS",
	rebirth = "REBIRTH",
}

local function clear()
	for _, child in ipairs(content:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end
end

--- One standard row: icon, title, subtitle, action button.
local function row(props)
	local holder = Ui.frame({
		parent = content,
		size = UDim2.new(1, -8, 0, props.height or 76),
		color = theme.panel,
	})
	Ui.stroke(holder, props.accent or theme.panelLight, 2)
	Ui.padding(holder, 10)

	if props.icon then
		Ui.text({
			parent = holder,
			size = UDim2.fromOffset(44, 44),
			text = props.icon,
			scaled = true,
		})
	end

	Ui.text({
		parent = holder,
		size = UDim2.new(1, -220, 0, 24),
		position = UDim2.fromOffset(props.icon and 52 or 0, 0),
		text = props.title or "",
		color = props.titleColor or theme.text,
		align = Enum.TextXAlignment.Left,
		scaled = false,
		textSize = 18,
	})

	Ui.text({
		parent = holder,
		size = UDim2.new(1, -220, 0, 34),
		position = UDim2.fromOffset(props.icon and 52 or 0, 24),
		text = props.body or "",
		color = theme.muted,
		align = Enum.TextXAlignment.Left,
		valign = Enum.TextYAlignment.Top,
		scaled = false,
		textSize = 14,
		wrap = true,
	})

	if props.progress then
		local _, fill = Ui.bar({
			parent = holder,
			size = UDim2.new(1, -200, 0, 8),
			position = UDim2.new(0, props.icon and 52 or 0, 1, -10),
			anchor = Vector2.new(0, 1),
			color = props.accent or theme.cyan,
			radius = 4,
		})
		fill.Size = UDim2.fromScale(math.clamp(props.progress, 0, 1), 1)
	end

	if props.action then
		Ui.button({
			parent = holder,
			size = UDim2.fromOffset(150, 46),
			position = UDim2.new(1, 0, 0.5, 0),
			anchor = Vector2.new(1, 0.5),
			text = props.action,
			color = props.actionColor or theme.cyan,
			textColor = props.actionTextColor or Color3.fromRGB(10, 20, 26),
			scaled = false,
			onClick = props.onAction,
		})
	end

	return holder
end

local function header(text: string)
	Ui.text({
		parent = content,
		size = UDim2.new(1, -8, 0, 34),
		text = text,
		color = theme.muted,
		align = Enum.TextXAlignment.Left,
		scaled = false,
		textSize = 15,
	})
end

-- Tabs ---------------------------------------------------------------------

local function renderShop()
	local deal = ProductConfig.dealOfTheDay()
	if deal and deal.assetId ~= 0 then
		local bought = (State.data.deals and State.data.deals.bought or {})[deal.id] == true
		header("TODAY'S DEAL — rotates at midnight UTC")
		row({
			icon = deal.icon,
			title = deal.name,
			body = deal.desc,
			accent = bought and theme.green or theme.accent,
			action = bought and "BOUGHT" or (deal.robux .. " R$"),
			actionColor = bought and theme.green or theme.accent,
			actionTextColor = Color3.fromRGB(255, 255, 255),
			onAction = function()
				if not bought then
					MarketplaceService:PromptProductPurchase(player, deal.assetId)
				end
			end,
		})
	end

	header("SPEND CASH — everything here is permanent")

	for _, upgrade in ipairs(UpgradeConfig.List) do
		local level = State.data.upgrades[upgrade.id] or 0
		local maxed = level >= upgrade.maxLevel
		local cost = UpgradeConfig.cost(upgrade.id, level)
		local affordable = State.data.cash >= cost

		row({
			icon = upgrade.icon,
			title = `{upgrade.name}  ·  Lv {level}/{upgrade.maxLevel}`,
			body = (function()
				local body = `{upgrade.desc}\nNow: {upgrade.format(level)}`
				-- The pickaxe is the one upgrade with a visible reward, so the
				-- card says which one is coming and when. A number that will
				-- change your model in nine levels is worth saving for.
				local upcoming = upgrade.id == "drill" and UpgradeConfig.nextPickaxe(level) or nil
				if upcoming then
					body ..= `\nNext pickaxe: {upcoming.name} at Lv {upcoming.from}`
				end
				return body
			end)(),
			progress = level / upgrade.maxLevel,
			accent = maxed and theme.green or theme.panelLight,
			action = maxed and "MAXED" or Format.short(cost),
			actionColor = maxed and theme.panelLight or (affordable and theme.gold or theme.panelLight),
			actionTextColor = affordable and Color3.fromRGB(30, 24, 10) or theme.muted,
			onAction = function()
				if not maxed then
					Net.fire("BuyUpgrade", upgrade.id)
				end
			end,
		})
	end

	local passes = ProductConfig.configuredGamepasses()
	if #passes > 0 then
		header("PASSES — permanent, account-wide")
		for _, pass in ipairs(passes) do
			local owned = State.data.gamepasses[pass.id] == true
			row({
				icon = pass.icon,
				title = pass.name,
				body = pass.desc,
				accent = owned and theme.green or theme.accent,
				action = owned and "OWNED" or "GET",
				actionColor = owned and theme.green or theme.accent,
				actionTextColor = Color3.fromRGB(255, 255, 255),
				onAction = function()
					if not owned then
						MarketplaceService:PromptGamePassPurchase(player, pass.assetId)
					end
				end,
			})
		end
	end
end

local function renderTasks()
	local board = State.data.questBoard or {}

	if board.onboarding then
		header(`GETTING STARTED — {board.onboarding.index}/{board.onboarding.total}`)
		local quest = board.onboarding
		local done = quest.progress >= quest.target
		row({
			icon = "🎯",
			title = quest.name,
			body = `{quest.desc}\n{Format.short(quest.progress)} / {Format.short(quest.target)}  ·  reward {Format.short(quest.reward.cash or 0)}`,
			progress = quest.progress / quest.target,
			accent = done and theme.green or theme.cyan,
			action = done and "CLAIM" or "IN PROGRESS",
			actionColor = done and theme.green or theme.panelLight,
			actionTextColor = done and Color3.fromRGB(10, 30, 20) or theme.muted,
			onAction = function()
				if done then
					Net.fire("ClaimQuest", quest.id)
					task.delay(0.35, function()
						if currentTab == "tasks" then
							Panels.open("tasks")
						end
					end)
				end
			end,
		})
	end

	header(`DAILY — resets at midnight UTC  ·  {board.rerolls or 0} reroll left`)
	for _, quest in ipairs(board.daily or {}) do
		local done = quest.progress >= quest.target
		row({
			icon = quest.claimed and "✅" or "📋",
			title = quest.name,
			body = `{quest.desc}\n{Format.short(quest.progress)} / {Format.short(quest.target)}  ·  reward {Format.short(quest.reward.cash or 0)}`,
			progress = quest.progress / quest.target,
			accent = quest.claimed and theme.panelLight or (done and theme.green or theme.panelLight),
			action = quest.claimed and "DONE" or (done and "CLAIM" or "…"),
			actionColor = (done and not quest.claimed) and theme.green or theme.panelLight,
			actionTextColor = (done and not quest.claimed) and Color3.fromRGB(10, 30, 20) or theme.muted,
			onAction = function()
				if done and not quest.claimed then
					Net.fire("ClaimQuest", quest.id)
					task.delay(0.35, function()
						if currentTab == "tasks" then
							Panels.open("tasks")
						end
					end)
				end
			end,
		})
	end

	if (board.rerolls or 0) > 0 then
		row({
			icon = "🎲",
			title = "Reroll dailies",
			body = "Swap all three for a fresh set. One per day.",
			action = "REROLL",
			actionColor = theme.accent,
			actionTextColor = Color3.fromRGB(255, 255, 255),
			onAction = function()
				Net.fire("RerollDaily")
				task.delay(0.35, function()
					if currentTab == "tasks" then
						Panels.open("tasks")
					end
				end)
			end,
		})
	end

	header("MILESTONES")
	for _, quest in ipairs(board.milestones or {}) do
		local done = quest.progress >= quest.target
		row({
			icon = "🏔️",
			title = quest.name,
			body = `{quest.desc}\n{Format.short(quest.progress)} / {Format.short(quest.target)}  ·  reward {Format.short(quest.reward.cash or 0)}`,
			progress = quest.progress / quest.target,
			accent = done and theme.gold or theme.panelLight,
			action = done and "CLAIM" or "LOCKED",
			actionColor = done and theme.gold or theme.panelLight,
			actionTextColor = done and Color3.fromRGB(30, 24, 10) or theme.muted,
			onAction = function()
				if done then
					Net.fire("ClaimQuest", quest.id)
					task.delay(0.35, function()
						if currentTab == "tasks" then
							Panels.open("tasks")
						end
					end)
				end
			end,
		})
	end
end

local function renderCodex()
	local found = 0
	for _ in pairs(State.data.codex or {}) do
		found += 1
	end
	header(`{found} / {#Ores.List} ORES FOUND — deeper layers hold rarer rock`)

	for _, ore in ipairs(Ores.List) do
		local count = (State.data.codex or {})[ore.id] or 0
		local discovered = count > 0
		row({
			height = 64,
			icon = discovered and "💎" or "❔",
			title = discovered and `{ore.name}  ·  {ore.tier}` or "???",
			titleColor = discovered and Ores.color(ore.tier) or theme.muted,
			body = discovered
				and `Found {count}x  ·  base value {Format.short(ore.value)}  ·  {Format.depth(ore.minDepth)}+`
				or `Somewhere below {Format.depth(ore.minDepth)}`,
			accent = discovered and Ores.color(ore.tier) or theme.panelLight,
		})
	end
end

local function renderDrones()
	header("ONE EQUIPPED AT A TIME — ownership survives rebirth")

	for _, drone in ipairs(DroneConfig.List) do
		local owned = (State.data.drones.owned or {})[drone.id] == true
		local equipped = State.data.drones.equipped == drone.id

		local bonuses = {}
		for stat, value in pairs(drone.bonus) do
			table.insert(bonuses, `{stat} +{value}`)
		end

		local action, actionColor
		if equipped then
			action, actionColor = "EQUIPPED", theme.green
		elseif owned then
			action, actionColor = "EQUIP", theme.cyan
		elseif drone.cost then
			action, actionColor = Format.short(drone.cost), theme.gold
		else
			action, actionColor = "FIND IT", theme.panelLight
		end

		row({
			icon = "🛠️",
			title = `{drone.name}  ·  {drone.rarity}`,
			titleColor = Ores.color(drone.rarity),
			body = `{drone.desc}\n{table.concat(bonuses, "  ·  ")}`,
			accent = equipped and theme.green or (owned and theme.cyan or theme.panelLight),
			action = action,
			actionColor = actionColor,
			actionTextColor = Color3.fromRGB(15, 20, 25),
			onAction = function()
				if owned then
					Net.fire("EquipDrone", drone.id)
				elseif drone.cost then
					Net.fire("BuyDrone", drone.id)
				end
				task.delay(0.35, function()
					if currentTab == "drones" then
						Panels.open("drones")
					end
				end)
			end,
		})
	end
end

local function renderBoards()
	local boards = Net.invoke("GetBoards") or { depth = {}, banked = {}, server = {} }

	-- This server first, and on purpose. The all-time boards are a wall of
	-- strangers with numbers nobody here will reach today; the people on this
	-- one are in the shaft right now and can be overtaken before you log off.
	header("THIS SERVER — banked since the server started")
	for _, entry in ipairs(boards.server or {}) do
		row({
			height = 58,
			icon = entry.rank == 1 and "🥇" or (entry.rank == 2 and "🥈" or (entry.rank == 3 and "🥉" or "▫️")),
			title = `#{entry.rank}  {entry.badge or ""} {entry.name}`,
			body = "Banked here: " .. Format.short(entry.value),
			accent = entry.rank == 1 and theme.gold or theme.panelLight,
		})
	end

	header("YOUR RANK")
	do
		local banked = (State.data.stats or {}).bankedTotal or 0
		local rank = Ranks.at(banked)
		local upcoming = Ranks.next(banked)
		row({
			height = 58,
			icon = rank.icon,
			title = `{string.upper(rank.name)}  ·  {Format.short(banked)} banked for life`,
			body = upcoming
					and `Next: {upcoming.name} at {Format.short(upcoming.at)}  ·  {math.floor(Ranks.progress(banked) * 100)}%`
				or "Top of the ladder. There is nothing above this.",
			accent = Ranks.color(rank.id),
		})
	end

	header("GLOBAL — updates every 90 seconds")

	if #(boards.depth or {}) == 0 then
		row({ icon = "🕳️", title = "No records yet", body = "Be the first name on this wall." })
	end

	for _, entry in ipairs(boards.depth or {}) do
		row({
			height = 58,
			icon = entry.rank == 1 and "🥇" or (entry.rank == 2 and "🥈" or (entry.rank == 3 and "🥉" or "▫️")),
			title = `#{entry.rank}  {entry.name}`,
			body = "Deepest dive: " .. Format.depth(entry.value),
			accent = entry.rank == 1 and theme.gold or theme.panelLight,
		})
	end

	header("RICHEST MINERS")
	for _, entry in ipairs(boards.banked or {}) do
		row({
			height = 58,
			icon = "💰",
			title = `#{entry.rank}  {entry.name}`,
			body = "Banked lifetime: " .. Format.short(entry.value),
			accent = entry.rank == 1 and theme.gold or theme.panelLight,
		})
	end
end

local function renderRebirth()
	local rebirths = State.data.rebirths or 0
	local requirement = RebirthConfig.requirement(rebirths)
	local current = RebirthConfig.bonuses(rebirths)
	local upcoming = RebirthConfig.bonuses(rebirths + 1)

	local cashOk = (State.data.cash or 0) >= requirement.cash
	local depthOk = ((State.data.stats or {}).bestDepth or 0) >= requirement.depth
	local ready = cashOk and depthOk

	header("REBIRTH KEEPS your codex, drones, records and title")
	header("REBIRTH WIPES your cash and upgrades")

	row({
		icon = "🔥",
		title = `Rebirth {rebirths} → {rebirths + 1}  ·  {RebirthConfig.title(rebirths + 1)}`,
		body = `Now: x{string.format("%.2f", current.cashMultiplier)} cash · +{string.format("%.2f", current.luck)} luck · +{current.capacity} cargo`
			.. `\nAfter: x{string.format("%.2f", upcoming.cashMultiplier)} cash · +{string.format("%.2f", upcoming.luck)} luck · +{upcoming.capacity} cargo`,
		accent = ready and theme.accent or theme.panelLight,
		action = ready and "REBIRTH" or "LOCKED",
		actionColor = ready and theme.accent or theme.panelLight,
		actionTextColor = Color3.fromRGB(255, 255, 255),
		height = 96,
		onAction = function()
			if ready then
				Net.fire("Rebirth")
				task.delay(0.5, function()
					Panels.close()
				end)
			end
		end,
	})

	row({
		icon = cashOk and "✅" or "❌",
		title = "Cash on hand",
		body = `{Format.short(State.data.cash or 0)} / {Format.short(requirement.cash)}`,
		progress = (State.data.cash or 0) / requirement.cash,
		accent = cashOk and theme.green or theme.danger,
	})

	row({
		icon = depthOk and "✅" or "❌",
		title = "Record dive",
		body = `{Format.depth((State.data.stats or {}).bestDepth or 0)} / {Format.depth(requirement.depth)}`,
		progress = ((State.data.stats or {}).bestDepth or 0) / requirement.depth,
		accent = depthOk and theme.green or theme.danger,
	})

	header("LAYERS UNLOCKED BY REBIRTH")
	for _, layer in ipairs(Layers.List) do
		local unlocked = rebirths >= layer.gate
		row({
			height = 58,
			icon = unlocked and "🔓" or "🔒",
			title = `{layer.name}  ·  {Format.depth(layer.minDepth)}+`,
			body = unlocked and layer.blurb or `Needs rebirth {layer.gate}`,
			accent = unlocked and theme.panelLight or theme.danger,
		})
	end
end

local function renderContract()
	local contract = State.data.contract or { points = 0, dayPoints = 0, claimed = {} }
	local points = contract.points or 0
	local dayPoints = contract.dayPoints or 0

	header(`{string.upper(ContractConfig.nameForWeek())} — resets Monday, midnight UTC`)

	local capped = dayPoints >= ContractConfig.DailyPointCap
	row({
		icon = capped and "✅" or "⚡",
		title = `{Format.short(points)} / {Format.short(ContractConfig.totalPoints())} contract points`,
		body = capped
			and "Today's contract work is done. Everything else still pays — the ladder refills at midnight."
			or `Today: {dayPoints} / {ContractConfig.DailyPointCap}. Banking, rare pulls, new ores, depth records and crew time all count.`,
		progress = points / ContractConfig.totalPoints(),
		accent = capped and theme.green or theme.gold,
		height = 92,
	})

	for index, tier in ipairs(ContractConfig.Tiers) do
		local reached = points >= tier.points
		local claimed = (contract.claimed or {})[tostring(index)] == true
		local extras = {}
		if tier.reward.luckMinutes then
			table.insert(extras, `{tier.reward.luckMinutes} min 2x luck`)
		end
		if tier.reward.cosmetic then
			local cosmetic = CosmeticConfig.ById[tier.reward.cosmetic]
			table.insert(extras, cosmetic and cosmetic.name or tier.reward.cosmetic)
		end
		if tier.reward.drone then
			local drone = DroneConfig.ById[tier.reward.drone]
			table.insert(extras, drone and drone.name or tier.reward.drone)
		end

		row({
			icon = claimed and "✅" or (reached and "🎁" or "🔒"),
			title = `Tier {index}  ·  {Format.short(tier.points)} pts`,
			body = `{Format.short(tier.reward.cash or 0)} cash`
				.. (#extras > 0 and ("  ·  " .. table.concat(extras, "  ·  ")) or ""),
			progress = math.min(points / tier.points, 1),
			accent = claimed and theme.panelLight or (reached and theme.gold or theme.panelLight),
			action = claimed and "DONE" or (reached and "CLAIM" or "LOCKED"),
			actionColor = (reached and not claimed) and theme.gold or theme.panelLight,
			actionTextColor = (reached and not claimed) and Color3.fromRGB(30, 24, 10) or theme.muted,
			onAction = function()
				if reached and not claimed then
					Net.fire("ClaimContract", index)
					task.delay(0.35, function()
						if currentTab == "contract" then
							Panels.open("contract")
						end
					end)
				end
			end,
		})
	end
end

local function renderDescent()
	local descent = State.data.descent or { days = 0, claimed = {} }
	local days = descent.days or 0

	header(`{days} DISTINCT DAYS PLAYED — these rewards are one-time`)
	header("Coming back on a new day is what moves this. Playing longer today does not.")

	for index, milestone in ipairs(ContractConfig.DescentLog) do
		local reached = days >= milestone.days
		local claimed = (descent.claimed or {})[tostring(index)] == true
		local extras = {}
		if milestone.reward.cosmetic then
			local cosmetic = CosmeticConfig.ById[milestone.reward.cosmetic]
			table.insert(extras, cosmetic and cosmetic.name or milestone.reward.cosmetic)
		end
		if milestone.reward.drone then
			local drone = DroneConfig.ById[milestone.reward.drone]
			table.insert(extras, drone and drone.name or milestone.reward.drone)
		end

		row({
			icon = claimed and "✅" or (reached and "🎁" or "📅"),
			title = `Day {milestone.days}  ·  {milestone.label}`,
			body = `{Format.short(milestone.reward.cash or 0)} cash`
				.. (#extras > 0 and ("  ·  " .. table.concat(extras, "  ·  ")) or ""),
			progress = math.min(days / milestone.days, 1),
			accent = claimed and theme.panelLight or (reached and theme.cyan or theme.panelLight),
			action = claimed and "DONE" or (reached and "CLAIM" or `{milestone.days - days} DAYS`),
			actionColor = (reached and not claimed) and theme.cyan or theme.panelLight,
			actionTextColor = (reached and not claimed) and Color3.fromRGB(10, 20, 26) or theme.muted,
			onAction = function()
				if reached and not claimed then
					Net.fire("ClaimDescent", index)
					task.delay(0.35, function()
						if currentTab == "descent" then
							Panels.open("descent")
						end
					end)
				end
			end,
		})
	end
end

local function renderLooks()
	local cosmetics = State.data.cosmetics or { owned = {}, equipped = {} }
	local owned = cosmetics.owned or {}
	local equipped = cosmetics.equipped or {}

	header("EVERYONE IN THE SHAFT SEES THESE — that is the whole point")

	local sections = {
		{ kind = "lamp", label = "HELMET LAMPS — lights the rock around you" },
		{ kind = "trail", label = "TRAILS — what people see when you fall past" },
		{ kind = "title", label = "TITLES — sits on your nameplate" },
	}

	for _, section in ipairs(sections) do
		header(section.label)
		for _, cosmetic in ipairs(CosmeticConfig.ofKind(section.kind)) do
			local isDefault = cosmetic.source == "default"
			local isOwned = isDefault or owned[cosmetic.id] == true
			local isEquipped = (equipped[section.kind] or CosmeticConfig.Defaults[section.kind]) == cosmetic.id

			local action, actionColor
			if isEquipped then
				action, actionColor = "WORN", theme.green
			elseif isOwned then
				action, actionColor = "WEAR", theme.cyan
			elseif cosmetic.source == "shop" then
				action, actionColor = Format.short(cosmetic.cost or 0), theme.gold
			elseif cosmetic.source == "contract" then
				action, actionColor = "CONTRACT", theme.panelLight
			elseif cosmetic.source == "descent" then
				action, actionColor = "DESCENT LOG", theme.panelLight
			else
				action, actionColor = "MILESTONE", theme.panelLight
			end

			row({
				height = 64,
				icon = section.kind == "lamp" and "🔦" or (section.kind == "trail" and "💫" or "🏷️"),
				title = cosmetic.name,
				titleColor = CosmeticConfig.color(cosmetic.id),
				body = isOwned and "Owned" or `Earned from: {cosmetic.source}`,
				accent = isEquipped and theme.green or (isOwned and theme.cyan or theme.panelLight),
				action = action,
				actionColor = actionColor,
				actionTextColor = Color3.fromRGB(15, 20, 25),
				onAction = function()
					if isOwned then
						Net.fire("EquipCosmetic", cosmetic.id)
					elseif cosmetic.source == "shop" then
						Net.fire("BuyCosmetic", cosmetic.id)
					end
					task.delay(0.35, function()
						if currentTab == "looks" then
							Panels.open("looks")
						end
					end)
				end,
			})
		end
	end
end

local RENDERERS = {
	contract = renderContract,
	descent = renderDescent,
	looks = renderLooks,
	shop = renderShop,
	tasks = renderTasks,
	codex = renderCodex,
	drones = renderDrones,
	boards = renderBoards,
	rebirth = renderRebirth,
}

function Panels.open(tab: string)
	local renderer = RENDERERS[tab]
	if not renderer then
		return
	end

	currentTab = tab
	titleLabel.Text = TAB_TITLES[tab] or string.upper(tab)
	clear()

	local ok, err = pcall(renderer)
	if not ok then
		warn("DeepRush: panel " .. tab .. " failed: " .. tostring(err))
	end

	window.Visible = true
end

function Panels.close()
	currentTab = nil
	window.Visible = false
end

function Panels.toggle(tab: string)
	if currentTab == tab then
		Panels.close()
	else
		Panels.open(tab)
	end
end

function Panels.start()
	gui = Instance.new("ScreenGui")
	gui.Name = "DeepRushPanels"
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.DisplayOrder = 5
	gui.Parent = player:WaitForChild("PlayerGui")

	window = Ui.frame({
		parent = gui,
		size = UDim2.new(0.62, 0, 0.78, 0),
		position = UDim2.fromScale(0.5, 0.5),
		anchor = Vector2.new(0.5, 0.5),
		color = theme.bg,
		visible = false,
		radius = 16,
	})
	Ui.stroke(window, theme.panelLight, 2)

	-- Keep the panel usable on a phone in portrait.
	local constraint = Instance.new("UISizeConstraint")
	constraint.MinSize = Vector2.new(320, 320)
	constraint.MaxSize = Vector2.new(760, 900)
	constraint.Parent = window

	titleLabel = Ui.text({
		parent = window,
		size = UDim2.new(1, -80, 0, 56),
		position = UDim2.fromOffset(20, 8),
		text = "UPGRADES",
		align = Enum.TextXAlignment.Left,
		font = Enum.Font.GothamBlack,
		scaled = false,
		textSize = 26,
	})

	Ui.button({
		parent = window,
		size = UDim2.fromOffset(48, 48),
		position = UDim2.new(1, -14, 0, 12),
		anchor = Vector2.new(1, 0),
		text = "✕",
		color = theme.panel,
		onClick = Panels.close,
	})

	content = Instance.new("ScrollingFrame")
	content.Size = UDim2.new(1, -24, 1, -80)
	content.Position = UDim2.fromOffset(12, 68)
	content.BackgroundTransparency = 1
	content.BorderSizePixel = 0
	content.ScrollBarThickness = 6
	content.ScrollBarImageColor3 = theme.panelLight
	content.AutomaticCanvasSize = Enum.AutomaticSize.Y
	content.CanvasSize = UDim2.new()
	content.Parent = window

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 8)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = content
end

return Panels

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX15">
          <Properties>
            <string name="Name">State</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	State.luau — one client-side copy of the player's state.

	The server sends partial patches (see Data.push). Everything the UI
	renders reads from here and re-renders on the changed signal, so no
	controller ever has to know which remote a number arrived on.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local State = {}

State.data = {
	cash = 0,
	xp = 0,
	level = 1,
	rebirths = 0,
	depth = 0,
	oxygen = 60,
	oxygenMax = 60,
	upgrades = {},
	drones = { owned = {}, equipped = nil },
	codex = {},
	cargo = { count = 0, value = 0, capacity = 8, greed = 0 },
	quests = {},
	questBoard = { daily = {}, milestones = {} },
	stats = {},
	rewards = {},
	buffs = {},
	gamepasses = {},
	streak = 0,
	seenIntro = nil, -- nil until the first snapshot; see Client/Intro.luau
	contract = { week = "", points = 0, dayPoints = 0, claimed = {} },
	descent = { days = 0, lastDay = "", claimed = {} },
	cosmetics = { owned = {}, equipped = {} },
	deals = { day = "", bought = {} },
	crew = { members = {}, bonusNear = 0 },
}

State.changed = Signal.new()
State.rift = { active = false }
State.riftChanged = Signal.new()
State.marked = {} -- userId -> true

local function merge(target, patch)
	for key, value in pairs(patch) do
		if key == "__replace" then
			continue
		end
		if type(value) == "table" and value.__replace then
			local copy = table.clone(value)
			copy.__replace = nil
			target[key] = copy
		elseif type(value) == "table" and type(target[key]) == "table" then
			merge(target[key], value)
		else
			target[key] = value
		end
	end
end

function State.start()
	local snapshot = Net.invoke("GetState")
	if snapshot then
		merge(State.data, snapshot)
		State.changed:fire(State.data)
	end

	Net.listen("State", function(patch)
		if type(patch) ~= "table" then
			return
		end
		merge(State.data, patch)
		State.changed:fire(State.data)
	end)

	Net.listen("Rift", function(state)
		State.rift = state
		State.riftChanged:fire(state)
	end)

	Net.listen("Marked", function(userIds)
		local marked = {}
		for _, userId in ipairs(userIds) do
			marked[userId] = true
		end
		State.marked = marked
	end)
end

return State

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="RBX16">
          <Properties>
            <string name="Name">Ui</string>
            <ProtectedString name="Source"><![CDATA[
--!nonstrict
--[[
	Ui.luau — the smallest possible UI kit.

	Roblox has no styling layer, so without something like this every panel
	re-implements corners, strokes and fonts slightly differently and the
	game starts to look homemade. One theme table, five constructors.

	Sizing is deliberately chunky: most Roblox sessions are on a phone, and a
	button smaller than ~48px is a button that gets missed mid-fall.
]]

local Ui = {}

Ui.THEME = {
	bg = Color3.fromRGB(12, 12, 18),
	panel = Color3.fromRGB(22, 22, 32),
	panelLight = Color3.fromRGB(34, 34, 48),
	text = Color3.fromRGB(240, 240, 250),
	muted = Color3.fromRGB(150, 150, 172),
	accent = Color3.fromRGB(255, 88, 120),
	gold = Color3.fromRGB(255, 205, 90),
	cyan = Color3.fromRGB(110, 230, 255),
	green = Color3.fromRGB(110, 235, 160),
	danger = Color3.fromRGB(255, 80, 80),
}

function Ui.corner(instance: Instance, radius: number?)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 10)
	corner.Parent = instance
	return corner
end

function Ui.stroke(instance: Instance, color: Color3?, thickness: number?, transparency: number?)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or Ui.THEME.panelLight
	stroke.Thickness = thickness or 1.5
	stroke.Transparency = transparency or 0
	stroke.Parent = instance
	return stroke
end

function Ui.padding(instance: Instance, amount: number)
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, amount)
	padding.PaddingBottom = UDim.new(0, amount)
	padding.PaddingLeft = UDim.new(0, amount)
	padding.PaddingRight = UDim.new(0, amount)
	padding.Parent = instance
	return padding
end

function Ui.frame(props)
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = props.color or Ui.THEME.panel
	frame.BackgroundTransparency = props.transparency or 0
	frame.BorderSizePixel = 0
	frame.Size = props.size or UDim2.fromOffset(100, 100)
	frame.Position = props.position or UDim2.fromOffset(0, 0)
	frame.AnchorPoint = props.anchor or Vector2.new(0, 0)
	frame.Visible = props.visible ~= false
	frame.ZIndex = props.z or 1
	frame.Name = props.name or "Frame"
	if props.radius ~= false then
		Ui.corner(frame, props.radius)
	end
	frame.Parent = props.parent
	return frame
end

function Ui.text(props)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = props.size or UDim2.fromScale(1, 1)
	label.Position = props.position or UDim2.fromOffset(0, 0)
	label.AnchorPoint = props.anchor or Vector2.new(0, 0)
	label.Font = props.font or Enum.Font.GothamBold
	label.Text = props.text or ""
	label.TextColor3 = props.color or Ui.THEME.text
	label.TextScaled = props.scaled ~= false
	label.TextXAlignment = props.align or Enum.TextXAlignment.Center
	label.TextYAlignment = props.valign or Enum.TextYAlignment.Center
	label.TextWrapped = props.wrap or false
	label.ZIndex = props.z or 2
	label.Name = props.name or "Label"
	label.Visible = props.visible ~= false
	if not label.TextScaled then
		label.TextSize = props.textSize or 16
	end
	label.Parent = props.parent
	return label
end

--- A button that visibly reacts. The press animation is not decoration: on
--- mobile, without it a player cannot tell whether their tap registered.
function Ui.button(props)
	local button = Instance.new("TextButton")
	button.BackgroundColor3 = props.color or Ui.THEME.panelLight
	button.BorderSizePixel = 0
	button.Size = props.size or UDim2.fromOffset(120, 48)
	button.Position = props.position or UDim2.fromOffset(0, 0)
	button.AnchorPoint = props.anchor or Vector2.new(0, 0)
	button.Font = props.font or Enum.Font.GothamBlack
	button.Text = props.text or ""
	button.TextColor3 = props.textColor or Ui.THEME.text
	button.TextScaled = props.scaled ~= false
	button.AutoButtonColor = false
	button.ZIndex = props.z or 2
	button.Name = props.name or "Button"
	button.Visible = props.visible ~= false
	Ui.corner(button, props.radius)
	if props.stroke then
		Ui.stroke(button, props.stroke, 2)
	end

	local base = button.BackgroundColor3
	button.MouseEnter:Connect(function()
		button.BackgroundColor3 = base:Lerp(Color3.new(1, 1, 1), 0.12)
	end)
	button.MouseLeave:Connect(function()
		button.BackgroundColor3 = base
	end)
	button.MouseButton1Down:Connect(function()
		button.BackgroundColor3 = base:Lerp(Color3.new(0, 0, 0), 0.2)
	end)
	button.MouseButton1Up:Connect(function()
		button.BackgroundColor3 = base
	end)

	if props.onClick then
		button.Activated:Connect(props.onClick)
	end

	button.Parent = props.parent
	return button
end

--- A labelled progress bar. Returns the fill frame so the caller can drive
--- it without re-querying children every frame.
function Ui.bar(props)
	local holder = Ui.frame({
		parent = props.parent,
		size = props.size,
		position = props.position,
		anchor = props.anchor,
		color = props.background or Ui.THEME.bg,
		radius = props.radius or 8,
		z = props.z,
	})

	local fill = Ui.frame({
		parent = holder,
		size = UDim2.fromScale(0, 1),
		color = props.color or Ui.THEME.cyan,
		radius = props.radius or 8,
		z = (props.z or 1) + 1,
	})

	local label = Ui.text({
		parent = holder,
		text = props.text or "",
		scaled = false,
		textSize = props.textSize or 14,
		z = (props.z or 1) + 2,
	})

	return holder, fill, label
end

return Ui

]]></ProtectedString>
            <bool name="Disabled">false</bool>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>
